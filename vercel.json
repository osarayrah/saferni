{
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/safferni-web run build",
  "outputDirectory": "artifacts/safferni-web/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "env": {
    "BASE_PATH": "/",
    "PORT": "23991",
    "VITE_CLERK_PROXY_URL": "https://safferni.site/api/__clerk"
  },
  "rewrites": [
    {
      "source": "/api/__clerk/:clerkPath*",
      "destination": "/api/healthz?__clerk_path=/:clerkPath*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  }
}
