vailable'}</span></div></div><Link href={`/room/${hotel.rooms?.[0]?.id || hotelId}`} className="btn btn-primary" data-testid="link-hotel-choose-room">Choose a room <ArrowRight size={14} /></Link></div></div><HotelReviews hotel={hotel} /><section><div className="eyebrow">The rooms</div><h2 className="section-heading" style={{ margin: '7px 0 17px' }}>Find your pace</h2>{hotel.rooms?.length ? <div className="room-grid">{hotel.rooms.map((room) => <RoomCard room={room} key={room.id} />)}</div> : <EmptyState title="Room details are pending" copy="The supplier has not provided room descriptions for this stay." />}</section></>;
