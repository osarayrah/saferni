{item.booking ? <CreditCard size={17} /> : <MapPin size={17} />}</span><span><strong>{item.title}</strong><small>{formatDate(item.date)} · {titleCase(item.state)}</small></span></div><ArrowRight size={18} color="hsl(var(--secondary))" /></Link>)}</div> : <EmptyState title="Your map is still wide open" copy="Save a plan or confirm a booking and it will stay here for the next time you need it." action={<Link href="/planner" className="btn btn-primary" data-testid="link-trips-empty-plan">Plan your first trip</Link>} />}</>;
