yncState({ query: { queryKey: getGetSyncStateQueryKey(), retry: 1 }, request: credentialsRequest });
  const putSync = usePutSyncState({ request: credentialsRequest });
  const savedOffers = sync.data?.savedOffers || [];
  const toggleSaved = (type: SavedOffer['type'], offer: Record<string, unknown>) => {
    const id = String(offer.id || '');
    if (!id || !sync.data) return;
    const exists = savedOffers.some((item) => item.id === id && item.type === type);
    const next = exists ? savedOffers.filter((item) => !(item.id === id && item.type === type)) : [...savedOffers, { id, type, offer, savedAt: new Date().toISOString() }];
    putSync.mutate({ data: { trips: sync.data.trips, savedOffers: next, preferences: sync.data.preferences } }, {
      onSuccess: (data) => queryClient.setQueryData(getGetSyncStateQueryKey(), data),
    });
  };
  return { sync, savedOffers, toggleSaved, saving: putSync.isPending };
}

