function RoomPage() {
  const { roomId = '' } = useParams<{ roomId: string }>();
  const [, setLocation] = useLocation();
  const createBooking = useCreateBooking({ request: credentialsRequest });
  const stored = useMemo(() => { try { return JSON.parse(sessionStorage.getItem('safferni-search') || 'null') as { result?: SearchResult; draft?: PlannerDraft } | null; } catch { return null; } }, []);
  const draft = stored?.draft || blankDraft;
  const selectedFlight = useMemo(() => { try { return JSON.parse(sessionStorage.getItem('safferni-flight') || 'null') as FlightOffer | null; } catch { return null; } }, []);
  // A remembered flight can outlive its search snapshot. Include it only if
  // the current search still contains it and the supplier made it bookable.
  // Current LiteAPI flight results are browse-only, so hotel checkout must not
  // fail merely because an old flight remains selected in the browser.
  const bookableFlight = stored?.result?.flights?.find((flight) => flight.id === selectedFlight?.id && Boolean(flight.bookingRef));
  const hotel = stored?.result?.hotels?.find((item) => item.roomOptions?.some((room) => room.id === roomId));
  const room = hotel?.roomOptions?.find((item) => item.id === roomId);
  const [email, setEmail] = useState('');
  const [firstName, setFirstName] = useState('');
  const [lastName, setLastName] = useState('');
  const [checkoutUrl, setCheckoutUrl] = useState<string | null>(null);
  if (!room) return <EmptyState title="Room details unavailable" copy="Open a room from a current hotel search so we can keep its rate and policies together." action={<Link href="/results" className="btn btn-primary" data-testid="link-room-results">Back to results</Link>} />;
  const submitBooking = () => {
    if (!email || !firstName || !lastName || !hotel) return;
    // Stripe Checkout cannot render inside Replit's embedded preview frame.
    // Open the tab while this click still has browser user activation, then
    // send it to Checkout when the API returns the hosted URL.
    const checkoutTab = window.open('', '_blank');
    setCheckoutUrl(null);
    createBooking.mutate({ data: { draft, flight: bookableFlight || undefined, hotel, travelers: [{ firstName, lastName, type: 'adult' }], contactEmail: email, returnUrl: `${window.location.origin}${basePath}/booking` } }, {
      onSuccess: (session) => {
        // Checkout opens in a separate tab, so sessionStorage from this tab is
        // not available when Stripe redirects back. localStorage is scoped to
        // the same origin and lets the return page authenticate the guest link.
        localStorage.setItem(`safferni-booking-token:${session.bookingId}`, session.accessToken);
        if (checkoutTab && !checkoutTab.closed) checkoutTab.location.replace(session.checkoutUrl);
        else setCheckoutUrl(session.checkoutUrl);
      },
      onError: () => { if (checkoutTab && !checkoutTab.closed) checkoutTab.close(); },
    });
  };
  return <><Link href={hotel ? `/hotel/${hotel.id}` : '/results'} className="btn btn-quiet" data-testid="link-room-back"><ChevronLeft size={15} /> Back to stay</Link><div className="detail-hero" style={{ marginTop: 30 }}><div className="photo-mosaic">{[0, 1, 2].map((index) => <div className="photo-tile" key={index}>{room.images?.[index] ? <img src={room.images[index]} alt={`${room.name} from the supplier`} /> : <span className="subcopy">Supplier image unavailable</span>}</div>)}</div><div className="detail-copy"><div className="eyebrow">{hotel?.name || 'Room detail'}</div><h1 className="page-title">{room.name}</h1><p className="subcopy">{room.description || 'The supplier has not provided a room description.'}</p><div className="detail-facts"><div><span className="fact-label">Room total</span><span className="fact-value">{money(room.totalPrice, room.currency)}</span></div><div><span className="fact-label">Bed</span><span className="fact-value">{room.bedTypes?.join(' / ') || 'Supplier bed details unavailable'}</span></div><div><span className="fact-label">Flexibility</span><span className="fact-value">{room.refundable ? 'Refundable' : 'Supplier policy'}</span></div></div><div className="panel" style={{ padding: 16, marginTop: 18 }}><div className="eyebrow">Secure checkout</div><p className="subcopy" style={{ marginTop: 6 }}>You’ll enter payment details securely with Stripe before we send this booking to the travel provider.</p><div style={{ display: 'grid', gap: 8, marginTop: 12 }}><input className="text-input" value={firstName} onChange={(event) => setFirstName(event.target.value)} placeholder="First name" aria-label="Traveler first name" data-testid="input-booking-first-name" /><input className="text-input" value={lastName} onChange={(event) => setLastName(event.target.value)} placeholder="Last name" aria-label="Traveler last name" data-testid="input-booking-last-name" /><input className="text-input" type="email" value={email} onChange={(event) => setEmail(event.target.value)} placeholder="Confirmation email" aria-label="Confirmation email" data-testid="input-booking-email" /><button className="btn btn-primary" type="button" disabled={!email || !firstName || !lastName || createBooking.isPending} onClick={submitBooking} data-testid="button-create-booking">{createBooking.isPending ? 'Opening secure checkout…' : `Continue to payment · ${money(room.totalPrice, room.currency)}`}</button>{checkoutUrl && <a className="btn btn-quiet" href={checkoutUrl} target="_blank" rel="noopener noreferrer" data-testid="link-open-secure-checkout">Open secure checkout</a>}{createBooking.isError && <p className="subcopy" style={{ color: 'hsl(var(--destructive))' }} data-testid="text-booking-error">We could not start secure checkout. No payment was taken.</p>}</div></div></div></div></>;
}

