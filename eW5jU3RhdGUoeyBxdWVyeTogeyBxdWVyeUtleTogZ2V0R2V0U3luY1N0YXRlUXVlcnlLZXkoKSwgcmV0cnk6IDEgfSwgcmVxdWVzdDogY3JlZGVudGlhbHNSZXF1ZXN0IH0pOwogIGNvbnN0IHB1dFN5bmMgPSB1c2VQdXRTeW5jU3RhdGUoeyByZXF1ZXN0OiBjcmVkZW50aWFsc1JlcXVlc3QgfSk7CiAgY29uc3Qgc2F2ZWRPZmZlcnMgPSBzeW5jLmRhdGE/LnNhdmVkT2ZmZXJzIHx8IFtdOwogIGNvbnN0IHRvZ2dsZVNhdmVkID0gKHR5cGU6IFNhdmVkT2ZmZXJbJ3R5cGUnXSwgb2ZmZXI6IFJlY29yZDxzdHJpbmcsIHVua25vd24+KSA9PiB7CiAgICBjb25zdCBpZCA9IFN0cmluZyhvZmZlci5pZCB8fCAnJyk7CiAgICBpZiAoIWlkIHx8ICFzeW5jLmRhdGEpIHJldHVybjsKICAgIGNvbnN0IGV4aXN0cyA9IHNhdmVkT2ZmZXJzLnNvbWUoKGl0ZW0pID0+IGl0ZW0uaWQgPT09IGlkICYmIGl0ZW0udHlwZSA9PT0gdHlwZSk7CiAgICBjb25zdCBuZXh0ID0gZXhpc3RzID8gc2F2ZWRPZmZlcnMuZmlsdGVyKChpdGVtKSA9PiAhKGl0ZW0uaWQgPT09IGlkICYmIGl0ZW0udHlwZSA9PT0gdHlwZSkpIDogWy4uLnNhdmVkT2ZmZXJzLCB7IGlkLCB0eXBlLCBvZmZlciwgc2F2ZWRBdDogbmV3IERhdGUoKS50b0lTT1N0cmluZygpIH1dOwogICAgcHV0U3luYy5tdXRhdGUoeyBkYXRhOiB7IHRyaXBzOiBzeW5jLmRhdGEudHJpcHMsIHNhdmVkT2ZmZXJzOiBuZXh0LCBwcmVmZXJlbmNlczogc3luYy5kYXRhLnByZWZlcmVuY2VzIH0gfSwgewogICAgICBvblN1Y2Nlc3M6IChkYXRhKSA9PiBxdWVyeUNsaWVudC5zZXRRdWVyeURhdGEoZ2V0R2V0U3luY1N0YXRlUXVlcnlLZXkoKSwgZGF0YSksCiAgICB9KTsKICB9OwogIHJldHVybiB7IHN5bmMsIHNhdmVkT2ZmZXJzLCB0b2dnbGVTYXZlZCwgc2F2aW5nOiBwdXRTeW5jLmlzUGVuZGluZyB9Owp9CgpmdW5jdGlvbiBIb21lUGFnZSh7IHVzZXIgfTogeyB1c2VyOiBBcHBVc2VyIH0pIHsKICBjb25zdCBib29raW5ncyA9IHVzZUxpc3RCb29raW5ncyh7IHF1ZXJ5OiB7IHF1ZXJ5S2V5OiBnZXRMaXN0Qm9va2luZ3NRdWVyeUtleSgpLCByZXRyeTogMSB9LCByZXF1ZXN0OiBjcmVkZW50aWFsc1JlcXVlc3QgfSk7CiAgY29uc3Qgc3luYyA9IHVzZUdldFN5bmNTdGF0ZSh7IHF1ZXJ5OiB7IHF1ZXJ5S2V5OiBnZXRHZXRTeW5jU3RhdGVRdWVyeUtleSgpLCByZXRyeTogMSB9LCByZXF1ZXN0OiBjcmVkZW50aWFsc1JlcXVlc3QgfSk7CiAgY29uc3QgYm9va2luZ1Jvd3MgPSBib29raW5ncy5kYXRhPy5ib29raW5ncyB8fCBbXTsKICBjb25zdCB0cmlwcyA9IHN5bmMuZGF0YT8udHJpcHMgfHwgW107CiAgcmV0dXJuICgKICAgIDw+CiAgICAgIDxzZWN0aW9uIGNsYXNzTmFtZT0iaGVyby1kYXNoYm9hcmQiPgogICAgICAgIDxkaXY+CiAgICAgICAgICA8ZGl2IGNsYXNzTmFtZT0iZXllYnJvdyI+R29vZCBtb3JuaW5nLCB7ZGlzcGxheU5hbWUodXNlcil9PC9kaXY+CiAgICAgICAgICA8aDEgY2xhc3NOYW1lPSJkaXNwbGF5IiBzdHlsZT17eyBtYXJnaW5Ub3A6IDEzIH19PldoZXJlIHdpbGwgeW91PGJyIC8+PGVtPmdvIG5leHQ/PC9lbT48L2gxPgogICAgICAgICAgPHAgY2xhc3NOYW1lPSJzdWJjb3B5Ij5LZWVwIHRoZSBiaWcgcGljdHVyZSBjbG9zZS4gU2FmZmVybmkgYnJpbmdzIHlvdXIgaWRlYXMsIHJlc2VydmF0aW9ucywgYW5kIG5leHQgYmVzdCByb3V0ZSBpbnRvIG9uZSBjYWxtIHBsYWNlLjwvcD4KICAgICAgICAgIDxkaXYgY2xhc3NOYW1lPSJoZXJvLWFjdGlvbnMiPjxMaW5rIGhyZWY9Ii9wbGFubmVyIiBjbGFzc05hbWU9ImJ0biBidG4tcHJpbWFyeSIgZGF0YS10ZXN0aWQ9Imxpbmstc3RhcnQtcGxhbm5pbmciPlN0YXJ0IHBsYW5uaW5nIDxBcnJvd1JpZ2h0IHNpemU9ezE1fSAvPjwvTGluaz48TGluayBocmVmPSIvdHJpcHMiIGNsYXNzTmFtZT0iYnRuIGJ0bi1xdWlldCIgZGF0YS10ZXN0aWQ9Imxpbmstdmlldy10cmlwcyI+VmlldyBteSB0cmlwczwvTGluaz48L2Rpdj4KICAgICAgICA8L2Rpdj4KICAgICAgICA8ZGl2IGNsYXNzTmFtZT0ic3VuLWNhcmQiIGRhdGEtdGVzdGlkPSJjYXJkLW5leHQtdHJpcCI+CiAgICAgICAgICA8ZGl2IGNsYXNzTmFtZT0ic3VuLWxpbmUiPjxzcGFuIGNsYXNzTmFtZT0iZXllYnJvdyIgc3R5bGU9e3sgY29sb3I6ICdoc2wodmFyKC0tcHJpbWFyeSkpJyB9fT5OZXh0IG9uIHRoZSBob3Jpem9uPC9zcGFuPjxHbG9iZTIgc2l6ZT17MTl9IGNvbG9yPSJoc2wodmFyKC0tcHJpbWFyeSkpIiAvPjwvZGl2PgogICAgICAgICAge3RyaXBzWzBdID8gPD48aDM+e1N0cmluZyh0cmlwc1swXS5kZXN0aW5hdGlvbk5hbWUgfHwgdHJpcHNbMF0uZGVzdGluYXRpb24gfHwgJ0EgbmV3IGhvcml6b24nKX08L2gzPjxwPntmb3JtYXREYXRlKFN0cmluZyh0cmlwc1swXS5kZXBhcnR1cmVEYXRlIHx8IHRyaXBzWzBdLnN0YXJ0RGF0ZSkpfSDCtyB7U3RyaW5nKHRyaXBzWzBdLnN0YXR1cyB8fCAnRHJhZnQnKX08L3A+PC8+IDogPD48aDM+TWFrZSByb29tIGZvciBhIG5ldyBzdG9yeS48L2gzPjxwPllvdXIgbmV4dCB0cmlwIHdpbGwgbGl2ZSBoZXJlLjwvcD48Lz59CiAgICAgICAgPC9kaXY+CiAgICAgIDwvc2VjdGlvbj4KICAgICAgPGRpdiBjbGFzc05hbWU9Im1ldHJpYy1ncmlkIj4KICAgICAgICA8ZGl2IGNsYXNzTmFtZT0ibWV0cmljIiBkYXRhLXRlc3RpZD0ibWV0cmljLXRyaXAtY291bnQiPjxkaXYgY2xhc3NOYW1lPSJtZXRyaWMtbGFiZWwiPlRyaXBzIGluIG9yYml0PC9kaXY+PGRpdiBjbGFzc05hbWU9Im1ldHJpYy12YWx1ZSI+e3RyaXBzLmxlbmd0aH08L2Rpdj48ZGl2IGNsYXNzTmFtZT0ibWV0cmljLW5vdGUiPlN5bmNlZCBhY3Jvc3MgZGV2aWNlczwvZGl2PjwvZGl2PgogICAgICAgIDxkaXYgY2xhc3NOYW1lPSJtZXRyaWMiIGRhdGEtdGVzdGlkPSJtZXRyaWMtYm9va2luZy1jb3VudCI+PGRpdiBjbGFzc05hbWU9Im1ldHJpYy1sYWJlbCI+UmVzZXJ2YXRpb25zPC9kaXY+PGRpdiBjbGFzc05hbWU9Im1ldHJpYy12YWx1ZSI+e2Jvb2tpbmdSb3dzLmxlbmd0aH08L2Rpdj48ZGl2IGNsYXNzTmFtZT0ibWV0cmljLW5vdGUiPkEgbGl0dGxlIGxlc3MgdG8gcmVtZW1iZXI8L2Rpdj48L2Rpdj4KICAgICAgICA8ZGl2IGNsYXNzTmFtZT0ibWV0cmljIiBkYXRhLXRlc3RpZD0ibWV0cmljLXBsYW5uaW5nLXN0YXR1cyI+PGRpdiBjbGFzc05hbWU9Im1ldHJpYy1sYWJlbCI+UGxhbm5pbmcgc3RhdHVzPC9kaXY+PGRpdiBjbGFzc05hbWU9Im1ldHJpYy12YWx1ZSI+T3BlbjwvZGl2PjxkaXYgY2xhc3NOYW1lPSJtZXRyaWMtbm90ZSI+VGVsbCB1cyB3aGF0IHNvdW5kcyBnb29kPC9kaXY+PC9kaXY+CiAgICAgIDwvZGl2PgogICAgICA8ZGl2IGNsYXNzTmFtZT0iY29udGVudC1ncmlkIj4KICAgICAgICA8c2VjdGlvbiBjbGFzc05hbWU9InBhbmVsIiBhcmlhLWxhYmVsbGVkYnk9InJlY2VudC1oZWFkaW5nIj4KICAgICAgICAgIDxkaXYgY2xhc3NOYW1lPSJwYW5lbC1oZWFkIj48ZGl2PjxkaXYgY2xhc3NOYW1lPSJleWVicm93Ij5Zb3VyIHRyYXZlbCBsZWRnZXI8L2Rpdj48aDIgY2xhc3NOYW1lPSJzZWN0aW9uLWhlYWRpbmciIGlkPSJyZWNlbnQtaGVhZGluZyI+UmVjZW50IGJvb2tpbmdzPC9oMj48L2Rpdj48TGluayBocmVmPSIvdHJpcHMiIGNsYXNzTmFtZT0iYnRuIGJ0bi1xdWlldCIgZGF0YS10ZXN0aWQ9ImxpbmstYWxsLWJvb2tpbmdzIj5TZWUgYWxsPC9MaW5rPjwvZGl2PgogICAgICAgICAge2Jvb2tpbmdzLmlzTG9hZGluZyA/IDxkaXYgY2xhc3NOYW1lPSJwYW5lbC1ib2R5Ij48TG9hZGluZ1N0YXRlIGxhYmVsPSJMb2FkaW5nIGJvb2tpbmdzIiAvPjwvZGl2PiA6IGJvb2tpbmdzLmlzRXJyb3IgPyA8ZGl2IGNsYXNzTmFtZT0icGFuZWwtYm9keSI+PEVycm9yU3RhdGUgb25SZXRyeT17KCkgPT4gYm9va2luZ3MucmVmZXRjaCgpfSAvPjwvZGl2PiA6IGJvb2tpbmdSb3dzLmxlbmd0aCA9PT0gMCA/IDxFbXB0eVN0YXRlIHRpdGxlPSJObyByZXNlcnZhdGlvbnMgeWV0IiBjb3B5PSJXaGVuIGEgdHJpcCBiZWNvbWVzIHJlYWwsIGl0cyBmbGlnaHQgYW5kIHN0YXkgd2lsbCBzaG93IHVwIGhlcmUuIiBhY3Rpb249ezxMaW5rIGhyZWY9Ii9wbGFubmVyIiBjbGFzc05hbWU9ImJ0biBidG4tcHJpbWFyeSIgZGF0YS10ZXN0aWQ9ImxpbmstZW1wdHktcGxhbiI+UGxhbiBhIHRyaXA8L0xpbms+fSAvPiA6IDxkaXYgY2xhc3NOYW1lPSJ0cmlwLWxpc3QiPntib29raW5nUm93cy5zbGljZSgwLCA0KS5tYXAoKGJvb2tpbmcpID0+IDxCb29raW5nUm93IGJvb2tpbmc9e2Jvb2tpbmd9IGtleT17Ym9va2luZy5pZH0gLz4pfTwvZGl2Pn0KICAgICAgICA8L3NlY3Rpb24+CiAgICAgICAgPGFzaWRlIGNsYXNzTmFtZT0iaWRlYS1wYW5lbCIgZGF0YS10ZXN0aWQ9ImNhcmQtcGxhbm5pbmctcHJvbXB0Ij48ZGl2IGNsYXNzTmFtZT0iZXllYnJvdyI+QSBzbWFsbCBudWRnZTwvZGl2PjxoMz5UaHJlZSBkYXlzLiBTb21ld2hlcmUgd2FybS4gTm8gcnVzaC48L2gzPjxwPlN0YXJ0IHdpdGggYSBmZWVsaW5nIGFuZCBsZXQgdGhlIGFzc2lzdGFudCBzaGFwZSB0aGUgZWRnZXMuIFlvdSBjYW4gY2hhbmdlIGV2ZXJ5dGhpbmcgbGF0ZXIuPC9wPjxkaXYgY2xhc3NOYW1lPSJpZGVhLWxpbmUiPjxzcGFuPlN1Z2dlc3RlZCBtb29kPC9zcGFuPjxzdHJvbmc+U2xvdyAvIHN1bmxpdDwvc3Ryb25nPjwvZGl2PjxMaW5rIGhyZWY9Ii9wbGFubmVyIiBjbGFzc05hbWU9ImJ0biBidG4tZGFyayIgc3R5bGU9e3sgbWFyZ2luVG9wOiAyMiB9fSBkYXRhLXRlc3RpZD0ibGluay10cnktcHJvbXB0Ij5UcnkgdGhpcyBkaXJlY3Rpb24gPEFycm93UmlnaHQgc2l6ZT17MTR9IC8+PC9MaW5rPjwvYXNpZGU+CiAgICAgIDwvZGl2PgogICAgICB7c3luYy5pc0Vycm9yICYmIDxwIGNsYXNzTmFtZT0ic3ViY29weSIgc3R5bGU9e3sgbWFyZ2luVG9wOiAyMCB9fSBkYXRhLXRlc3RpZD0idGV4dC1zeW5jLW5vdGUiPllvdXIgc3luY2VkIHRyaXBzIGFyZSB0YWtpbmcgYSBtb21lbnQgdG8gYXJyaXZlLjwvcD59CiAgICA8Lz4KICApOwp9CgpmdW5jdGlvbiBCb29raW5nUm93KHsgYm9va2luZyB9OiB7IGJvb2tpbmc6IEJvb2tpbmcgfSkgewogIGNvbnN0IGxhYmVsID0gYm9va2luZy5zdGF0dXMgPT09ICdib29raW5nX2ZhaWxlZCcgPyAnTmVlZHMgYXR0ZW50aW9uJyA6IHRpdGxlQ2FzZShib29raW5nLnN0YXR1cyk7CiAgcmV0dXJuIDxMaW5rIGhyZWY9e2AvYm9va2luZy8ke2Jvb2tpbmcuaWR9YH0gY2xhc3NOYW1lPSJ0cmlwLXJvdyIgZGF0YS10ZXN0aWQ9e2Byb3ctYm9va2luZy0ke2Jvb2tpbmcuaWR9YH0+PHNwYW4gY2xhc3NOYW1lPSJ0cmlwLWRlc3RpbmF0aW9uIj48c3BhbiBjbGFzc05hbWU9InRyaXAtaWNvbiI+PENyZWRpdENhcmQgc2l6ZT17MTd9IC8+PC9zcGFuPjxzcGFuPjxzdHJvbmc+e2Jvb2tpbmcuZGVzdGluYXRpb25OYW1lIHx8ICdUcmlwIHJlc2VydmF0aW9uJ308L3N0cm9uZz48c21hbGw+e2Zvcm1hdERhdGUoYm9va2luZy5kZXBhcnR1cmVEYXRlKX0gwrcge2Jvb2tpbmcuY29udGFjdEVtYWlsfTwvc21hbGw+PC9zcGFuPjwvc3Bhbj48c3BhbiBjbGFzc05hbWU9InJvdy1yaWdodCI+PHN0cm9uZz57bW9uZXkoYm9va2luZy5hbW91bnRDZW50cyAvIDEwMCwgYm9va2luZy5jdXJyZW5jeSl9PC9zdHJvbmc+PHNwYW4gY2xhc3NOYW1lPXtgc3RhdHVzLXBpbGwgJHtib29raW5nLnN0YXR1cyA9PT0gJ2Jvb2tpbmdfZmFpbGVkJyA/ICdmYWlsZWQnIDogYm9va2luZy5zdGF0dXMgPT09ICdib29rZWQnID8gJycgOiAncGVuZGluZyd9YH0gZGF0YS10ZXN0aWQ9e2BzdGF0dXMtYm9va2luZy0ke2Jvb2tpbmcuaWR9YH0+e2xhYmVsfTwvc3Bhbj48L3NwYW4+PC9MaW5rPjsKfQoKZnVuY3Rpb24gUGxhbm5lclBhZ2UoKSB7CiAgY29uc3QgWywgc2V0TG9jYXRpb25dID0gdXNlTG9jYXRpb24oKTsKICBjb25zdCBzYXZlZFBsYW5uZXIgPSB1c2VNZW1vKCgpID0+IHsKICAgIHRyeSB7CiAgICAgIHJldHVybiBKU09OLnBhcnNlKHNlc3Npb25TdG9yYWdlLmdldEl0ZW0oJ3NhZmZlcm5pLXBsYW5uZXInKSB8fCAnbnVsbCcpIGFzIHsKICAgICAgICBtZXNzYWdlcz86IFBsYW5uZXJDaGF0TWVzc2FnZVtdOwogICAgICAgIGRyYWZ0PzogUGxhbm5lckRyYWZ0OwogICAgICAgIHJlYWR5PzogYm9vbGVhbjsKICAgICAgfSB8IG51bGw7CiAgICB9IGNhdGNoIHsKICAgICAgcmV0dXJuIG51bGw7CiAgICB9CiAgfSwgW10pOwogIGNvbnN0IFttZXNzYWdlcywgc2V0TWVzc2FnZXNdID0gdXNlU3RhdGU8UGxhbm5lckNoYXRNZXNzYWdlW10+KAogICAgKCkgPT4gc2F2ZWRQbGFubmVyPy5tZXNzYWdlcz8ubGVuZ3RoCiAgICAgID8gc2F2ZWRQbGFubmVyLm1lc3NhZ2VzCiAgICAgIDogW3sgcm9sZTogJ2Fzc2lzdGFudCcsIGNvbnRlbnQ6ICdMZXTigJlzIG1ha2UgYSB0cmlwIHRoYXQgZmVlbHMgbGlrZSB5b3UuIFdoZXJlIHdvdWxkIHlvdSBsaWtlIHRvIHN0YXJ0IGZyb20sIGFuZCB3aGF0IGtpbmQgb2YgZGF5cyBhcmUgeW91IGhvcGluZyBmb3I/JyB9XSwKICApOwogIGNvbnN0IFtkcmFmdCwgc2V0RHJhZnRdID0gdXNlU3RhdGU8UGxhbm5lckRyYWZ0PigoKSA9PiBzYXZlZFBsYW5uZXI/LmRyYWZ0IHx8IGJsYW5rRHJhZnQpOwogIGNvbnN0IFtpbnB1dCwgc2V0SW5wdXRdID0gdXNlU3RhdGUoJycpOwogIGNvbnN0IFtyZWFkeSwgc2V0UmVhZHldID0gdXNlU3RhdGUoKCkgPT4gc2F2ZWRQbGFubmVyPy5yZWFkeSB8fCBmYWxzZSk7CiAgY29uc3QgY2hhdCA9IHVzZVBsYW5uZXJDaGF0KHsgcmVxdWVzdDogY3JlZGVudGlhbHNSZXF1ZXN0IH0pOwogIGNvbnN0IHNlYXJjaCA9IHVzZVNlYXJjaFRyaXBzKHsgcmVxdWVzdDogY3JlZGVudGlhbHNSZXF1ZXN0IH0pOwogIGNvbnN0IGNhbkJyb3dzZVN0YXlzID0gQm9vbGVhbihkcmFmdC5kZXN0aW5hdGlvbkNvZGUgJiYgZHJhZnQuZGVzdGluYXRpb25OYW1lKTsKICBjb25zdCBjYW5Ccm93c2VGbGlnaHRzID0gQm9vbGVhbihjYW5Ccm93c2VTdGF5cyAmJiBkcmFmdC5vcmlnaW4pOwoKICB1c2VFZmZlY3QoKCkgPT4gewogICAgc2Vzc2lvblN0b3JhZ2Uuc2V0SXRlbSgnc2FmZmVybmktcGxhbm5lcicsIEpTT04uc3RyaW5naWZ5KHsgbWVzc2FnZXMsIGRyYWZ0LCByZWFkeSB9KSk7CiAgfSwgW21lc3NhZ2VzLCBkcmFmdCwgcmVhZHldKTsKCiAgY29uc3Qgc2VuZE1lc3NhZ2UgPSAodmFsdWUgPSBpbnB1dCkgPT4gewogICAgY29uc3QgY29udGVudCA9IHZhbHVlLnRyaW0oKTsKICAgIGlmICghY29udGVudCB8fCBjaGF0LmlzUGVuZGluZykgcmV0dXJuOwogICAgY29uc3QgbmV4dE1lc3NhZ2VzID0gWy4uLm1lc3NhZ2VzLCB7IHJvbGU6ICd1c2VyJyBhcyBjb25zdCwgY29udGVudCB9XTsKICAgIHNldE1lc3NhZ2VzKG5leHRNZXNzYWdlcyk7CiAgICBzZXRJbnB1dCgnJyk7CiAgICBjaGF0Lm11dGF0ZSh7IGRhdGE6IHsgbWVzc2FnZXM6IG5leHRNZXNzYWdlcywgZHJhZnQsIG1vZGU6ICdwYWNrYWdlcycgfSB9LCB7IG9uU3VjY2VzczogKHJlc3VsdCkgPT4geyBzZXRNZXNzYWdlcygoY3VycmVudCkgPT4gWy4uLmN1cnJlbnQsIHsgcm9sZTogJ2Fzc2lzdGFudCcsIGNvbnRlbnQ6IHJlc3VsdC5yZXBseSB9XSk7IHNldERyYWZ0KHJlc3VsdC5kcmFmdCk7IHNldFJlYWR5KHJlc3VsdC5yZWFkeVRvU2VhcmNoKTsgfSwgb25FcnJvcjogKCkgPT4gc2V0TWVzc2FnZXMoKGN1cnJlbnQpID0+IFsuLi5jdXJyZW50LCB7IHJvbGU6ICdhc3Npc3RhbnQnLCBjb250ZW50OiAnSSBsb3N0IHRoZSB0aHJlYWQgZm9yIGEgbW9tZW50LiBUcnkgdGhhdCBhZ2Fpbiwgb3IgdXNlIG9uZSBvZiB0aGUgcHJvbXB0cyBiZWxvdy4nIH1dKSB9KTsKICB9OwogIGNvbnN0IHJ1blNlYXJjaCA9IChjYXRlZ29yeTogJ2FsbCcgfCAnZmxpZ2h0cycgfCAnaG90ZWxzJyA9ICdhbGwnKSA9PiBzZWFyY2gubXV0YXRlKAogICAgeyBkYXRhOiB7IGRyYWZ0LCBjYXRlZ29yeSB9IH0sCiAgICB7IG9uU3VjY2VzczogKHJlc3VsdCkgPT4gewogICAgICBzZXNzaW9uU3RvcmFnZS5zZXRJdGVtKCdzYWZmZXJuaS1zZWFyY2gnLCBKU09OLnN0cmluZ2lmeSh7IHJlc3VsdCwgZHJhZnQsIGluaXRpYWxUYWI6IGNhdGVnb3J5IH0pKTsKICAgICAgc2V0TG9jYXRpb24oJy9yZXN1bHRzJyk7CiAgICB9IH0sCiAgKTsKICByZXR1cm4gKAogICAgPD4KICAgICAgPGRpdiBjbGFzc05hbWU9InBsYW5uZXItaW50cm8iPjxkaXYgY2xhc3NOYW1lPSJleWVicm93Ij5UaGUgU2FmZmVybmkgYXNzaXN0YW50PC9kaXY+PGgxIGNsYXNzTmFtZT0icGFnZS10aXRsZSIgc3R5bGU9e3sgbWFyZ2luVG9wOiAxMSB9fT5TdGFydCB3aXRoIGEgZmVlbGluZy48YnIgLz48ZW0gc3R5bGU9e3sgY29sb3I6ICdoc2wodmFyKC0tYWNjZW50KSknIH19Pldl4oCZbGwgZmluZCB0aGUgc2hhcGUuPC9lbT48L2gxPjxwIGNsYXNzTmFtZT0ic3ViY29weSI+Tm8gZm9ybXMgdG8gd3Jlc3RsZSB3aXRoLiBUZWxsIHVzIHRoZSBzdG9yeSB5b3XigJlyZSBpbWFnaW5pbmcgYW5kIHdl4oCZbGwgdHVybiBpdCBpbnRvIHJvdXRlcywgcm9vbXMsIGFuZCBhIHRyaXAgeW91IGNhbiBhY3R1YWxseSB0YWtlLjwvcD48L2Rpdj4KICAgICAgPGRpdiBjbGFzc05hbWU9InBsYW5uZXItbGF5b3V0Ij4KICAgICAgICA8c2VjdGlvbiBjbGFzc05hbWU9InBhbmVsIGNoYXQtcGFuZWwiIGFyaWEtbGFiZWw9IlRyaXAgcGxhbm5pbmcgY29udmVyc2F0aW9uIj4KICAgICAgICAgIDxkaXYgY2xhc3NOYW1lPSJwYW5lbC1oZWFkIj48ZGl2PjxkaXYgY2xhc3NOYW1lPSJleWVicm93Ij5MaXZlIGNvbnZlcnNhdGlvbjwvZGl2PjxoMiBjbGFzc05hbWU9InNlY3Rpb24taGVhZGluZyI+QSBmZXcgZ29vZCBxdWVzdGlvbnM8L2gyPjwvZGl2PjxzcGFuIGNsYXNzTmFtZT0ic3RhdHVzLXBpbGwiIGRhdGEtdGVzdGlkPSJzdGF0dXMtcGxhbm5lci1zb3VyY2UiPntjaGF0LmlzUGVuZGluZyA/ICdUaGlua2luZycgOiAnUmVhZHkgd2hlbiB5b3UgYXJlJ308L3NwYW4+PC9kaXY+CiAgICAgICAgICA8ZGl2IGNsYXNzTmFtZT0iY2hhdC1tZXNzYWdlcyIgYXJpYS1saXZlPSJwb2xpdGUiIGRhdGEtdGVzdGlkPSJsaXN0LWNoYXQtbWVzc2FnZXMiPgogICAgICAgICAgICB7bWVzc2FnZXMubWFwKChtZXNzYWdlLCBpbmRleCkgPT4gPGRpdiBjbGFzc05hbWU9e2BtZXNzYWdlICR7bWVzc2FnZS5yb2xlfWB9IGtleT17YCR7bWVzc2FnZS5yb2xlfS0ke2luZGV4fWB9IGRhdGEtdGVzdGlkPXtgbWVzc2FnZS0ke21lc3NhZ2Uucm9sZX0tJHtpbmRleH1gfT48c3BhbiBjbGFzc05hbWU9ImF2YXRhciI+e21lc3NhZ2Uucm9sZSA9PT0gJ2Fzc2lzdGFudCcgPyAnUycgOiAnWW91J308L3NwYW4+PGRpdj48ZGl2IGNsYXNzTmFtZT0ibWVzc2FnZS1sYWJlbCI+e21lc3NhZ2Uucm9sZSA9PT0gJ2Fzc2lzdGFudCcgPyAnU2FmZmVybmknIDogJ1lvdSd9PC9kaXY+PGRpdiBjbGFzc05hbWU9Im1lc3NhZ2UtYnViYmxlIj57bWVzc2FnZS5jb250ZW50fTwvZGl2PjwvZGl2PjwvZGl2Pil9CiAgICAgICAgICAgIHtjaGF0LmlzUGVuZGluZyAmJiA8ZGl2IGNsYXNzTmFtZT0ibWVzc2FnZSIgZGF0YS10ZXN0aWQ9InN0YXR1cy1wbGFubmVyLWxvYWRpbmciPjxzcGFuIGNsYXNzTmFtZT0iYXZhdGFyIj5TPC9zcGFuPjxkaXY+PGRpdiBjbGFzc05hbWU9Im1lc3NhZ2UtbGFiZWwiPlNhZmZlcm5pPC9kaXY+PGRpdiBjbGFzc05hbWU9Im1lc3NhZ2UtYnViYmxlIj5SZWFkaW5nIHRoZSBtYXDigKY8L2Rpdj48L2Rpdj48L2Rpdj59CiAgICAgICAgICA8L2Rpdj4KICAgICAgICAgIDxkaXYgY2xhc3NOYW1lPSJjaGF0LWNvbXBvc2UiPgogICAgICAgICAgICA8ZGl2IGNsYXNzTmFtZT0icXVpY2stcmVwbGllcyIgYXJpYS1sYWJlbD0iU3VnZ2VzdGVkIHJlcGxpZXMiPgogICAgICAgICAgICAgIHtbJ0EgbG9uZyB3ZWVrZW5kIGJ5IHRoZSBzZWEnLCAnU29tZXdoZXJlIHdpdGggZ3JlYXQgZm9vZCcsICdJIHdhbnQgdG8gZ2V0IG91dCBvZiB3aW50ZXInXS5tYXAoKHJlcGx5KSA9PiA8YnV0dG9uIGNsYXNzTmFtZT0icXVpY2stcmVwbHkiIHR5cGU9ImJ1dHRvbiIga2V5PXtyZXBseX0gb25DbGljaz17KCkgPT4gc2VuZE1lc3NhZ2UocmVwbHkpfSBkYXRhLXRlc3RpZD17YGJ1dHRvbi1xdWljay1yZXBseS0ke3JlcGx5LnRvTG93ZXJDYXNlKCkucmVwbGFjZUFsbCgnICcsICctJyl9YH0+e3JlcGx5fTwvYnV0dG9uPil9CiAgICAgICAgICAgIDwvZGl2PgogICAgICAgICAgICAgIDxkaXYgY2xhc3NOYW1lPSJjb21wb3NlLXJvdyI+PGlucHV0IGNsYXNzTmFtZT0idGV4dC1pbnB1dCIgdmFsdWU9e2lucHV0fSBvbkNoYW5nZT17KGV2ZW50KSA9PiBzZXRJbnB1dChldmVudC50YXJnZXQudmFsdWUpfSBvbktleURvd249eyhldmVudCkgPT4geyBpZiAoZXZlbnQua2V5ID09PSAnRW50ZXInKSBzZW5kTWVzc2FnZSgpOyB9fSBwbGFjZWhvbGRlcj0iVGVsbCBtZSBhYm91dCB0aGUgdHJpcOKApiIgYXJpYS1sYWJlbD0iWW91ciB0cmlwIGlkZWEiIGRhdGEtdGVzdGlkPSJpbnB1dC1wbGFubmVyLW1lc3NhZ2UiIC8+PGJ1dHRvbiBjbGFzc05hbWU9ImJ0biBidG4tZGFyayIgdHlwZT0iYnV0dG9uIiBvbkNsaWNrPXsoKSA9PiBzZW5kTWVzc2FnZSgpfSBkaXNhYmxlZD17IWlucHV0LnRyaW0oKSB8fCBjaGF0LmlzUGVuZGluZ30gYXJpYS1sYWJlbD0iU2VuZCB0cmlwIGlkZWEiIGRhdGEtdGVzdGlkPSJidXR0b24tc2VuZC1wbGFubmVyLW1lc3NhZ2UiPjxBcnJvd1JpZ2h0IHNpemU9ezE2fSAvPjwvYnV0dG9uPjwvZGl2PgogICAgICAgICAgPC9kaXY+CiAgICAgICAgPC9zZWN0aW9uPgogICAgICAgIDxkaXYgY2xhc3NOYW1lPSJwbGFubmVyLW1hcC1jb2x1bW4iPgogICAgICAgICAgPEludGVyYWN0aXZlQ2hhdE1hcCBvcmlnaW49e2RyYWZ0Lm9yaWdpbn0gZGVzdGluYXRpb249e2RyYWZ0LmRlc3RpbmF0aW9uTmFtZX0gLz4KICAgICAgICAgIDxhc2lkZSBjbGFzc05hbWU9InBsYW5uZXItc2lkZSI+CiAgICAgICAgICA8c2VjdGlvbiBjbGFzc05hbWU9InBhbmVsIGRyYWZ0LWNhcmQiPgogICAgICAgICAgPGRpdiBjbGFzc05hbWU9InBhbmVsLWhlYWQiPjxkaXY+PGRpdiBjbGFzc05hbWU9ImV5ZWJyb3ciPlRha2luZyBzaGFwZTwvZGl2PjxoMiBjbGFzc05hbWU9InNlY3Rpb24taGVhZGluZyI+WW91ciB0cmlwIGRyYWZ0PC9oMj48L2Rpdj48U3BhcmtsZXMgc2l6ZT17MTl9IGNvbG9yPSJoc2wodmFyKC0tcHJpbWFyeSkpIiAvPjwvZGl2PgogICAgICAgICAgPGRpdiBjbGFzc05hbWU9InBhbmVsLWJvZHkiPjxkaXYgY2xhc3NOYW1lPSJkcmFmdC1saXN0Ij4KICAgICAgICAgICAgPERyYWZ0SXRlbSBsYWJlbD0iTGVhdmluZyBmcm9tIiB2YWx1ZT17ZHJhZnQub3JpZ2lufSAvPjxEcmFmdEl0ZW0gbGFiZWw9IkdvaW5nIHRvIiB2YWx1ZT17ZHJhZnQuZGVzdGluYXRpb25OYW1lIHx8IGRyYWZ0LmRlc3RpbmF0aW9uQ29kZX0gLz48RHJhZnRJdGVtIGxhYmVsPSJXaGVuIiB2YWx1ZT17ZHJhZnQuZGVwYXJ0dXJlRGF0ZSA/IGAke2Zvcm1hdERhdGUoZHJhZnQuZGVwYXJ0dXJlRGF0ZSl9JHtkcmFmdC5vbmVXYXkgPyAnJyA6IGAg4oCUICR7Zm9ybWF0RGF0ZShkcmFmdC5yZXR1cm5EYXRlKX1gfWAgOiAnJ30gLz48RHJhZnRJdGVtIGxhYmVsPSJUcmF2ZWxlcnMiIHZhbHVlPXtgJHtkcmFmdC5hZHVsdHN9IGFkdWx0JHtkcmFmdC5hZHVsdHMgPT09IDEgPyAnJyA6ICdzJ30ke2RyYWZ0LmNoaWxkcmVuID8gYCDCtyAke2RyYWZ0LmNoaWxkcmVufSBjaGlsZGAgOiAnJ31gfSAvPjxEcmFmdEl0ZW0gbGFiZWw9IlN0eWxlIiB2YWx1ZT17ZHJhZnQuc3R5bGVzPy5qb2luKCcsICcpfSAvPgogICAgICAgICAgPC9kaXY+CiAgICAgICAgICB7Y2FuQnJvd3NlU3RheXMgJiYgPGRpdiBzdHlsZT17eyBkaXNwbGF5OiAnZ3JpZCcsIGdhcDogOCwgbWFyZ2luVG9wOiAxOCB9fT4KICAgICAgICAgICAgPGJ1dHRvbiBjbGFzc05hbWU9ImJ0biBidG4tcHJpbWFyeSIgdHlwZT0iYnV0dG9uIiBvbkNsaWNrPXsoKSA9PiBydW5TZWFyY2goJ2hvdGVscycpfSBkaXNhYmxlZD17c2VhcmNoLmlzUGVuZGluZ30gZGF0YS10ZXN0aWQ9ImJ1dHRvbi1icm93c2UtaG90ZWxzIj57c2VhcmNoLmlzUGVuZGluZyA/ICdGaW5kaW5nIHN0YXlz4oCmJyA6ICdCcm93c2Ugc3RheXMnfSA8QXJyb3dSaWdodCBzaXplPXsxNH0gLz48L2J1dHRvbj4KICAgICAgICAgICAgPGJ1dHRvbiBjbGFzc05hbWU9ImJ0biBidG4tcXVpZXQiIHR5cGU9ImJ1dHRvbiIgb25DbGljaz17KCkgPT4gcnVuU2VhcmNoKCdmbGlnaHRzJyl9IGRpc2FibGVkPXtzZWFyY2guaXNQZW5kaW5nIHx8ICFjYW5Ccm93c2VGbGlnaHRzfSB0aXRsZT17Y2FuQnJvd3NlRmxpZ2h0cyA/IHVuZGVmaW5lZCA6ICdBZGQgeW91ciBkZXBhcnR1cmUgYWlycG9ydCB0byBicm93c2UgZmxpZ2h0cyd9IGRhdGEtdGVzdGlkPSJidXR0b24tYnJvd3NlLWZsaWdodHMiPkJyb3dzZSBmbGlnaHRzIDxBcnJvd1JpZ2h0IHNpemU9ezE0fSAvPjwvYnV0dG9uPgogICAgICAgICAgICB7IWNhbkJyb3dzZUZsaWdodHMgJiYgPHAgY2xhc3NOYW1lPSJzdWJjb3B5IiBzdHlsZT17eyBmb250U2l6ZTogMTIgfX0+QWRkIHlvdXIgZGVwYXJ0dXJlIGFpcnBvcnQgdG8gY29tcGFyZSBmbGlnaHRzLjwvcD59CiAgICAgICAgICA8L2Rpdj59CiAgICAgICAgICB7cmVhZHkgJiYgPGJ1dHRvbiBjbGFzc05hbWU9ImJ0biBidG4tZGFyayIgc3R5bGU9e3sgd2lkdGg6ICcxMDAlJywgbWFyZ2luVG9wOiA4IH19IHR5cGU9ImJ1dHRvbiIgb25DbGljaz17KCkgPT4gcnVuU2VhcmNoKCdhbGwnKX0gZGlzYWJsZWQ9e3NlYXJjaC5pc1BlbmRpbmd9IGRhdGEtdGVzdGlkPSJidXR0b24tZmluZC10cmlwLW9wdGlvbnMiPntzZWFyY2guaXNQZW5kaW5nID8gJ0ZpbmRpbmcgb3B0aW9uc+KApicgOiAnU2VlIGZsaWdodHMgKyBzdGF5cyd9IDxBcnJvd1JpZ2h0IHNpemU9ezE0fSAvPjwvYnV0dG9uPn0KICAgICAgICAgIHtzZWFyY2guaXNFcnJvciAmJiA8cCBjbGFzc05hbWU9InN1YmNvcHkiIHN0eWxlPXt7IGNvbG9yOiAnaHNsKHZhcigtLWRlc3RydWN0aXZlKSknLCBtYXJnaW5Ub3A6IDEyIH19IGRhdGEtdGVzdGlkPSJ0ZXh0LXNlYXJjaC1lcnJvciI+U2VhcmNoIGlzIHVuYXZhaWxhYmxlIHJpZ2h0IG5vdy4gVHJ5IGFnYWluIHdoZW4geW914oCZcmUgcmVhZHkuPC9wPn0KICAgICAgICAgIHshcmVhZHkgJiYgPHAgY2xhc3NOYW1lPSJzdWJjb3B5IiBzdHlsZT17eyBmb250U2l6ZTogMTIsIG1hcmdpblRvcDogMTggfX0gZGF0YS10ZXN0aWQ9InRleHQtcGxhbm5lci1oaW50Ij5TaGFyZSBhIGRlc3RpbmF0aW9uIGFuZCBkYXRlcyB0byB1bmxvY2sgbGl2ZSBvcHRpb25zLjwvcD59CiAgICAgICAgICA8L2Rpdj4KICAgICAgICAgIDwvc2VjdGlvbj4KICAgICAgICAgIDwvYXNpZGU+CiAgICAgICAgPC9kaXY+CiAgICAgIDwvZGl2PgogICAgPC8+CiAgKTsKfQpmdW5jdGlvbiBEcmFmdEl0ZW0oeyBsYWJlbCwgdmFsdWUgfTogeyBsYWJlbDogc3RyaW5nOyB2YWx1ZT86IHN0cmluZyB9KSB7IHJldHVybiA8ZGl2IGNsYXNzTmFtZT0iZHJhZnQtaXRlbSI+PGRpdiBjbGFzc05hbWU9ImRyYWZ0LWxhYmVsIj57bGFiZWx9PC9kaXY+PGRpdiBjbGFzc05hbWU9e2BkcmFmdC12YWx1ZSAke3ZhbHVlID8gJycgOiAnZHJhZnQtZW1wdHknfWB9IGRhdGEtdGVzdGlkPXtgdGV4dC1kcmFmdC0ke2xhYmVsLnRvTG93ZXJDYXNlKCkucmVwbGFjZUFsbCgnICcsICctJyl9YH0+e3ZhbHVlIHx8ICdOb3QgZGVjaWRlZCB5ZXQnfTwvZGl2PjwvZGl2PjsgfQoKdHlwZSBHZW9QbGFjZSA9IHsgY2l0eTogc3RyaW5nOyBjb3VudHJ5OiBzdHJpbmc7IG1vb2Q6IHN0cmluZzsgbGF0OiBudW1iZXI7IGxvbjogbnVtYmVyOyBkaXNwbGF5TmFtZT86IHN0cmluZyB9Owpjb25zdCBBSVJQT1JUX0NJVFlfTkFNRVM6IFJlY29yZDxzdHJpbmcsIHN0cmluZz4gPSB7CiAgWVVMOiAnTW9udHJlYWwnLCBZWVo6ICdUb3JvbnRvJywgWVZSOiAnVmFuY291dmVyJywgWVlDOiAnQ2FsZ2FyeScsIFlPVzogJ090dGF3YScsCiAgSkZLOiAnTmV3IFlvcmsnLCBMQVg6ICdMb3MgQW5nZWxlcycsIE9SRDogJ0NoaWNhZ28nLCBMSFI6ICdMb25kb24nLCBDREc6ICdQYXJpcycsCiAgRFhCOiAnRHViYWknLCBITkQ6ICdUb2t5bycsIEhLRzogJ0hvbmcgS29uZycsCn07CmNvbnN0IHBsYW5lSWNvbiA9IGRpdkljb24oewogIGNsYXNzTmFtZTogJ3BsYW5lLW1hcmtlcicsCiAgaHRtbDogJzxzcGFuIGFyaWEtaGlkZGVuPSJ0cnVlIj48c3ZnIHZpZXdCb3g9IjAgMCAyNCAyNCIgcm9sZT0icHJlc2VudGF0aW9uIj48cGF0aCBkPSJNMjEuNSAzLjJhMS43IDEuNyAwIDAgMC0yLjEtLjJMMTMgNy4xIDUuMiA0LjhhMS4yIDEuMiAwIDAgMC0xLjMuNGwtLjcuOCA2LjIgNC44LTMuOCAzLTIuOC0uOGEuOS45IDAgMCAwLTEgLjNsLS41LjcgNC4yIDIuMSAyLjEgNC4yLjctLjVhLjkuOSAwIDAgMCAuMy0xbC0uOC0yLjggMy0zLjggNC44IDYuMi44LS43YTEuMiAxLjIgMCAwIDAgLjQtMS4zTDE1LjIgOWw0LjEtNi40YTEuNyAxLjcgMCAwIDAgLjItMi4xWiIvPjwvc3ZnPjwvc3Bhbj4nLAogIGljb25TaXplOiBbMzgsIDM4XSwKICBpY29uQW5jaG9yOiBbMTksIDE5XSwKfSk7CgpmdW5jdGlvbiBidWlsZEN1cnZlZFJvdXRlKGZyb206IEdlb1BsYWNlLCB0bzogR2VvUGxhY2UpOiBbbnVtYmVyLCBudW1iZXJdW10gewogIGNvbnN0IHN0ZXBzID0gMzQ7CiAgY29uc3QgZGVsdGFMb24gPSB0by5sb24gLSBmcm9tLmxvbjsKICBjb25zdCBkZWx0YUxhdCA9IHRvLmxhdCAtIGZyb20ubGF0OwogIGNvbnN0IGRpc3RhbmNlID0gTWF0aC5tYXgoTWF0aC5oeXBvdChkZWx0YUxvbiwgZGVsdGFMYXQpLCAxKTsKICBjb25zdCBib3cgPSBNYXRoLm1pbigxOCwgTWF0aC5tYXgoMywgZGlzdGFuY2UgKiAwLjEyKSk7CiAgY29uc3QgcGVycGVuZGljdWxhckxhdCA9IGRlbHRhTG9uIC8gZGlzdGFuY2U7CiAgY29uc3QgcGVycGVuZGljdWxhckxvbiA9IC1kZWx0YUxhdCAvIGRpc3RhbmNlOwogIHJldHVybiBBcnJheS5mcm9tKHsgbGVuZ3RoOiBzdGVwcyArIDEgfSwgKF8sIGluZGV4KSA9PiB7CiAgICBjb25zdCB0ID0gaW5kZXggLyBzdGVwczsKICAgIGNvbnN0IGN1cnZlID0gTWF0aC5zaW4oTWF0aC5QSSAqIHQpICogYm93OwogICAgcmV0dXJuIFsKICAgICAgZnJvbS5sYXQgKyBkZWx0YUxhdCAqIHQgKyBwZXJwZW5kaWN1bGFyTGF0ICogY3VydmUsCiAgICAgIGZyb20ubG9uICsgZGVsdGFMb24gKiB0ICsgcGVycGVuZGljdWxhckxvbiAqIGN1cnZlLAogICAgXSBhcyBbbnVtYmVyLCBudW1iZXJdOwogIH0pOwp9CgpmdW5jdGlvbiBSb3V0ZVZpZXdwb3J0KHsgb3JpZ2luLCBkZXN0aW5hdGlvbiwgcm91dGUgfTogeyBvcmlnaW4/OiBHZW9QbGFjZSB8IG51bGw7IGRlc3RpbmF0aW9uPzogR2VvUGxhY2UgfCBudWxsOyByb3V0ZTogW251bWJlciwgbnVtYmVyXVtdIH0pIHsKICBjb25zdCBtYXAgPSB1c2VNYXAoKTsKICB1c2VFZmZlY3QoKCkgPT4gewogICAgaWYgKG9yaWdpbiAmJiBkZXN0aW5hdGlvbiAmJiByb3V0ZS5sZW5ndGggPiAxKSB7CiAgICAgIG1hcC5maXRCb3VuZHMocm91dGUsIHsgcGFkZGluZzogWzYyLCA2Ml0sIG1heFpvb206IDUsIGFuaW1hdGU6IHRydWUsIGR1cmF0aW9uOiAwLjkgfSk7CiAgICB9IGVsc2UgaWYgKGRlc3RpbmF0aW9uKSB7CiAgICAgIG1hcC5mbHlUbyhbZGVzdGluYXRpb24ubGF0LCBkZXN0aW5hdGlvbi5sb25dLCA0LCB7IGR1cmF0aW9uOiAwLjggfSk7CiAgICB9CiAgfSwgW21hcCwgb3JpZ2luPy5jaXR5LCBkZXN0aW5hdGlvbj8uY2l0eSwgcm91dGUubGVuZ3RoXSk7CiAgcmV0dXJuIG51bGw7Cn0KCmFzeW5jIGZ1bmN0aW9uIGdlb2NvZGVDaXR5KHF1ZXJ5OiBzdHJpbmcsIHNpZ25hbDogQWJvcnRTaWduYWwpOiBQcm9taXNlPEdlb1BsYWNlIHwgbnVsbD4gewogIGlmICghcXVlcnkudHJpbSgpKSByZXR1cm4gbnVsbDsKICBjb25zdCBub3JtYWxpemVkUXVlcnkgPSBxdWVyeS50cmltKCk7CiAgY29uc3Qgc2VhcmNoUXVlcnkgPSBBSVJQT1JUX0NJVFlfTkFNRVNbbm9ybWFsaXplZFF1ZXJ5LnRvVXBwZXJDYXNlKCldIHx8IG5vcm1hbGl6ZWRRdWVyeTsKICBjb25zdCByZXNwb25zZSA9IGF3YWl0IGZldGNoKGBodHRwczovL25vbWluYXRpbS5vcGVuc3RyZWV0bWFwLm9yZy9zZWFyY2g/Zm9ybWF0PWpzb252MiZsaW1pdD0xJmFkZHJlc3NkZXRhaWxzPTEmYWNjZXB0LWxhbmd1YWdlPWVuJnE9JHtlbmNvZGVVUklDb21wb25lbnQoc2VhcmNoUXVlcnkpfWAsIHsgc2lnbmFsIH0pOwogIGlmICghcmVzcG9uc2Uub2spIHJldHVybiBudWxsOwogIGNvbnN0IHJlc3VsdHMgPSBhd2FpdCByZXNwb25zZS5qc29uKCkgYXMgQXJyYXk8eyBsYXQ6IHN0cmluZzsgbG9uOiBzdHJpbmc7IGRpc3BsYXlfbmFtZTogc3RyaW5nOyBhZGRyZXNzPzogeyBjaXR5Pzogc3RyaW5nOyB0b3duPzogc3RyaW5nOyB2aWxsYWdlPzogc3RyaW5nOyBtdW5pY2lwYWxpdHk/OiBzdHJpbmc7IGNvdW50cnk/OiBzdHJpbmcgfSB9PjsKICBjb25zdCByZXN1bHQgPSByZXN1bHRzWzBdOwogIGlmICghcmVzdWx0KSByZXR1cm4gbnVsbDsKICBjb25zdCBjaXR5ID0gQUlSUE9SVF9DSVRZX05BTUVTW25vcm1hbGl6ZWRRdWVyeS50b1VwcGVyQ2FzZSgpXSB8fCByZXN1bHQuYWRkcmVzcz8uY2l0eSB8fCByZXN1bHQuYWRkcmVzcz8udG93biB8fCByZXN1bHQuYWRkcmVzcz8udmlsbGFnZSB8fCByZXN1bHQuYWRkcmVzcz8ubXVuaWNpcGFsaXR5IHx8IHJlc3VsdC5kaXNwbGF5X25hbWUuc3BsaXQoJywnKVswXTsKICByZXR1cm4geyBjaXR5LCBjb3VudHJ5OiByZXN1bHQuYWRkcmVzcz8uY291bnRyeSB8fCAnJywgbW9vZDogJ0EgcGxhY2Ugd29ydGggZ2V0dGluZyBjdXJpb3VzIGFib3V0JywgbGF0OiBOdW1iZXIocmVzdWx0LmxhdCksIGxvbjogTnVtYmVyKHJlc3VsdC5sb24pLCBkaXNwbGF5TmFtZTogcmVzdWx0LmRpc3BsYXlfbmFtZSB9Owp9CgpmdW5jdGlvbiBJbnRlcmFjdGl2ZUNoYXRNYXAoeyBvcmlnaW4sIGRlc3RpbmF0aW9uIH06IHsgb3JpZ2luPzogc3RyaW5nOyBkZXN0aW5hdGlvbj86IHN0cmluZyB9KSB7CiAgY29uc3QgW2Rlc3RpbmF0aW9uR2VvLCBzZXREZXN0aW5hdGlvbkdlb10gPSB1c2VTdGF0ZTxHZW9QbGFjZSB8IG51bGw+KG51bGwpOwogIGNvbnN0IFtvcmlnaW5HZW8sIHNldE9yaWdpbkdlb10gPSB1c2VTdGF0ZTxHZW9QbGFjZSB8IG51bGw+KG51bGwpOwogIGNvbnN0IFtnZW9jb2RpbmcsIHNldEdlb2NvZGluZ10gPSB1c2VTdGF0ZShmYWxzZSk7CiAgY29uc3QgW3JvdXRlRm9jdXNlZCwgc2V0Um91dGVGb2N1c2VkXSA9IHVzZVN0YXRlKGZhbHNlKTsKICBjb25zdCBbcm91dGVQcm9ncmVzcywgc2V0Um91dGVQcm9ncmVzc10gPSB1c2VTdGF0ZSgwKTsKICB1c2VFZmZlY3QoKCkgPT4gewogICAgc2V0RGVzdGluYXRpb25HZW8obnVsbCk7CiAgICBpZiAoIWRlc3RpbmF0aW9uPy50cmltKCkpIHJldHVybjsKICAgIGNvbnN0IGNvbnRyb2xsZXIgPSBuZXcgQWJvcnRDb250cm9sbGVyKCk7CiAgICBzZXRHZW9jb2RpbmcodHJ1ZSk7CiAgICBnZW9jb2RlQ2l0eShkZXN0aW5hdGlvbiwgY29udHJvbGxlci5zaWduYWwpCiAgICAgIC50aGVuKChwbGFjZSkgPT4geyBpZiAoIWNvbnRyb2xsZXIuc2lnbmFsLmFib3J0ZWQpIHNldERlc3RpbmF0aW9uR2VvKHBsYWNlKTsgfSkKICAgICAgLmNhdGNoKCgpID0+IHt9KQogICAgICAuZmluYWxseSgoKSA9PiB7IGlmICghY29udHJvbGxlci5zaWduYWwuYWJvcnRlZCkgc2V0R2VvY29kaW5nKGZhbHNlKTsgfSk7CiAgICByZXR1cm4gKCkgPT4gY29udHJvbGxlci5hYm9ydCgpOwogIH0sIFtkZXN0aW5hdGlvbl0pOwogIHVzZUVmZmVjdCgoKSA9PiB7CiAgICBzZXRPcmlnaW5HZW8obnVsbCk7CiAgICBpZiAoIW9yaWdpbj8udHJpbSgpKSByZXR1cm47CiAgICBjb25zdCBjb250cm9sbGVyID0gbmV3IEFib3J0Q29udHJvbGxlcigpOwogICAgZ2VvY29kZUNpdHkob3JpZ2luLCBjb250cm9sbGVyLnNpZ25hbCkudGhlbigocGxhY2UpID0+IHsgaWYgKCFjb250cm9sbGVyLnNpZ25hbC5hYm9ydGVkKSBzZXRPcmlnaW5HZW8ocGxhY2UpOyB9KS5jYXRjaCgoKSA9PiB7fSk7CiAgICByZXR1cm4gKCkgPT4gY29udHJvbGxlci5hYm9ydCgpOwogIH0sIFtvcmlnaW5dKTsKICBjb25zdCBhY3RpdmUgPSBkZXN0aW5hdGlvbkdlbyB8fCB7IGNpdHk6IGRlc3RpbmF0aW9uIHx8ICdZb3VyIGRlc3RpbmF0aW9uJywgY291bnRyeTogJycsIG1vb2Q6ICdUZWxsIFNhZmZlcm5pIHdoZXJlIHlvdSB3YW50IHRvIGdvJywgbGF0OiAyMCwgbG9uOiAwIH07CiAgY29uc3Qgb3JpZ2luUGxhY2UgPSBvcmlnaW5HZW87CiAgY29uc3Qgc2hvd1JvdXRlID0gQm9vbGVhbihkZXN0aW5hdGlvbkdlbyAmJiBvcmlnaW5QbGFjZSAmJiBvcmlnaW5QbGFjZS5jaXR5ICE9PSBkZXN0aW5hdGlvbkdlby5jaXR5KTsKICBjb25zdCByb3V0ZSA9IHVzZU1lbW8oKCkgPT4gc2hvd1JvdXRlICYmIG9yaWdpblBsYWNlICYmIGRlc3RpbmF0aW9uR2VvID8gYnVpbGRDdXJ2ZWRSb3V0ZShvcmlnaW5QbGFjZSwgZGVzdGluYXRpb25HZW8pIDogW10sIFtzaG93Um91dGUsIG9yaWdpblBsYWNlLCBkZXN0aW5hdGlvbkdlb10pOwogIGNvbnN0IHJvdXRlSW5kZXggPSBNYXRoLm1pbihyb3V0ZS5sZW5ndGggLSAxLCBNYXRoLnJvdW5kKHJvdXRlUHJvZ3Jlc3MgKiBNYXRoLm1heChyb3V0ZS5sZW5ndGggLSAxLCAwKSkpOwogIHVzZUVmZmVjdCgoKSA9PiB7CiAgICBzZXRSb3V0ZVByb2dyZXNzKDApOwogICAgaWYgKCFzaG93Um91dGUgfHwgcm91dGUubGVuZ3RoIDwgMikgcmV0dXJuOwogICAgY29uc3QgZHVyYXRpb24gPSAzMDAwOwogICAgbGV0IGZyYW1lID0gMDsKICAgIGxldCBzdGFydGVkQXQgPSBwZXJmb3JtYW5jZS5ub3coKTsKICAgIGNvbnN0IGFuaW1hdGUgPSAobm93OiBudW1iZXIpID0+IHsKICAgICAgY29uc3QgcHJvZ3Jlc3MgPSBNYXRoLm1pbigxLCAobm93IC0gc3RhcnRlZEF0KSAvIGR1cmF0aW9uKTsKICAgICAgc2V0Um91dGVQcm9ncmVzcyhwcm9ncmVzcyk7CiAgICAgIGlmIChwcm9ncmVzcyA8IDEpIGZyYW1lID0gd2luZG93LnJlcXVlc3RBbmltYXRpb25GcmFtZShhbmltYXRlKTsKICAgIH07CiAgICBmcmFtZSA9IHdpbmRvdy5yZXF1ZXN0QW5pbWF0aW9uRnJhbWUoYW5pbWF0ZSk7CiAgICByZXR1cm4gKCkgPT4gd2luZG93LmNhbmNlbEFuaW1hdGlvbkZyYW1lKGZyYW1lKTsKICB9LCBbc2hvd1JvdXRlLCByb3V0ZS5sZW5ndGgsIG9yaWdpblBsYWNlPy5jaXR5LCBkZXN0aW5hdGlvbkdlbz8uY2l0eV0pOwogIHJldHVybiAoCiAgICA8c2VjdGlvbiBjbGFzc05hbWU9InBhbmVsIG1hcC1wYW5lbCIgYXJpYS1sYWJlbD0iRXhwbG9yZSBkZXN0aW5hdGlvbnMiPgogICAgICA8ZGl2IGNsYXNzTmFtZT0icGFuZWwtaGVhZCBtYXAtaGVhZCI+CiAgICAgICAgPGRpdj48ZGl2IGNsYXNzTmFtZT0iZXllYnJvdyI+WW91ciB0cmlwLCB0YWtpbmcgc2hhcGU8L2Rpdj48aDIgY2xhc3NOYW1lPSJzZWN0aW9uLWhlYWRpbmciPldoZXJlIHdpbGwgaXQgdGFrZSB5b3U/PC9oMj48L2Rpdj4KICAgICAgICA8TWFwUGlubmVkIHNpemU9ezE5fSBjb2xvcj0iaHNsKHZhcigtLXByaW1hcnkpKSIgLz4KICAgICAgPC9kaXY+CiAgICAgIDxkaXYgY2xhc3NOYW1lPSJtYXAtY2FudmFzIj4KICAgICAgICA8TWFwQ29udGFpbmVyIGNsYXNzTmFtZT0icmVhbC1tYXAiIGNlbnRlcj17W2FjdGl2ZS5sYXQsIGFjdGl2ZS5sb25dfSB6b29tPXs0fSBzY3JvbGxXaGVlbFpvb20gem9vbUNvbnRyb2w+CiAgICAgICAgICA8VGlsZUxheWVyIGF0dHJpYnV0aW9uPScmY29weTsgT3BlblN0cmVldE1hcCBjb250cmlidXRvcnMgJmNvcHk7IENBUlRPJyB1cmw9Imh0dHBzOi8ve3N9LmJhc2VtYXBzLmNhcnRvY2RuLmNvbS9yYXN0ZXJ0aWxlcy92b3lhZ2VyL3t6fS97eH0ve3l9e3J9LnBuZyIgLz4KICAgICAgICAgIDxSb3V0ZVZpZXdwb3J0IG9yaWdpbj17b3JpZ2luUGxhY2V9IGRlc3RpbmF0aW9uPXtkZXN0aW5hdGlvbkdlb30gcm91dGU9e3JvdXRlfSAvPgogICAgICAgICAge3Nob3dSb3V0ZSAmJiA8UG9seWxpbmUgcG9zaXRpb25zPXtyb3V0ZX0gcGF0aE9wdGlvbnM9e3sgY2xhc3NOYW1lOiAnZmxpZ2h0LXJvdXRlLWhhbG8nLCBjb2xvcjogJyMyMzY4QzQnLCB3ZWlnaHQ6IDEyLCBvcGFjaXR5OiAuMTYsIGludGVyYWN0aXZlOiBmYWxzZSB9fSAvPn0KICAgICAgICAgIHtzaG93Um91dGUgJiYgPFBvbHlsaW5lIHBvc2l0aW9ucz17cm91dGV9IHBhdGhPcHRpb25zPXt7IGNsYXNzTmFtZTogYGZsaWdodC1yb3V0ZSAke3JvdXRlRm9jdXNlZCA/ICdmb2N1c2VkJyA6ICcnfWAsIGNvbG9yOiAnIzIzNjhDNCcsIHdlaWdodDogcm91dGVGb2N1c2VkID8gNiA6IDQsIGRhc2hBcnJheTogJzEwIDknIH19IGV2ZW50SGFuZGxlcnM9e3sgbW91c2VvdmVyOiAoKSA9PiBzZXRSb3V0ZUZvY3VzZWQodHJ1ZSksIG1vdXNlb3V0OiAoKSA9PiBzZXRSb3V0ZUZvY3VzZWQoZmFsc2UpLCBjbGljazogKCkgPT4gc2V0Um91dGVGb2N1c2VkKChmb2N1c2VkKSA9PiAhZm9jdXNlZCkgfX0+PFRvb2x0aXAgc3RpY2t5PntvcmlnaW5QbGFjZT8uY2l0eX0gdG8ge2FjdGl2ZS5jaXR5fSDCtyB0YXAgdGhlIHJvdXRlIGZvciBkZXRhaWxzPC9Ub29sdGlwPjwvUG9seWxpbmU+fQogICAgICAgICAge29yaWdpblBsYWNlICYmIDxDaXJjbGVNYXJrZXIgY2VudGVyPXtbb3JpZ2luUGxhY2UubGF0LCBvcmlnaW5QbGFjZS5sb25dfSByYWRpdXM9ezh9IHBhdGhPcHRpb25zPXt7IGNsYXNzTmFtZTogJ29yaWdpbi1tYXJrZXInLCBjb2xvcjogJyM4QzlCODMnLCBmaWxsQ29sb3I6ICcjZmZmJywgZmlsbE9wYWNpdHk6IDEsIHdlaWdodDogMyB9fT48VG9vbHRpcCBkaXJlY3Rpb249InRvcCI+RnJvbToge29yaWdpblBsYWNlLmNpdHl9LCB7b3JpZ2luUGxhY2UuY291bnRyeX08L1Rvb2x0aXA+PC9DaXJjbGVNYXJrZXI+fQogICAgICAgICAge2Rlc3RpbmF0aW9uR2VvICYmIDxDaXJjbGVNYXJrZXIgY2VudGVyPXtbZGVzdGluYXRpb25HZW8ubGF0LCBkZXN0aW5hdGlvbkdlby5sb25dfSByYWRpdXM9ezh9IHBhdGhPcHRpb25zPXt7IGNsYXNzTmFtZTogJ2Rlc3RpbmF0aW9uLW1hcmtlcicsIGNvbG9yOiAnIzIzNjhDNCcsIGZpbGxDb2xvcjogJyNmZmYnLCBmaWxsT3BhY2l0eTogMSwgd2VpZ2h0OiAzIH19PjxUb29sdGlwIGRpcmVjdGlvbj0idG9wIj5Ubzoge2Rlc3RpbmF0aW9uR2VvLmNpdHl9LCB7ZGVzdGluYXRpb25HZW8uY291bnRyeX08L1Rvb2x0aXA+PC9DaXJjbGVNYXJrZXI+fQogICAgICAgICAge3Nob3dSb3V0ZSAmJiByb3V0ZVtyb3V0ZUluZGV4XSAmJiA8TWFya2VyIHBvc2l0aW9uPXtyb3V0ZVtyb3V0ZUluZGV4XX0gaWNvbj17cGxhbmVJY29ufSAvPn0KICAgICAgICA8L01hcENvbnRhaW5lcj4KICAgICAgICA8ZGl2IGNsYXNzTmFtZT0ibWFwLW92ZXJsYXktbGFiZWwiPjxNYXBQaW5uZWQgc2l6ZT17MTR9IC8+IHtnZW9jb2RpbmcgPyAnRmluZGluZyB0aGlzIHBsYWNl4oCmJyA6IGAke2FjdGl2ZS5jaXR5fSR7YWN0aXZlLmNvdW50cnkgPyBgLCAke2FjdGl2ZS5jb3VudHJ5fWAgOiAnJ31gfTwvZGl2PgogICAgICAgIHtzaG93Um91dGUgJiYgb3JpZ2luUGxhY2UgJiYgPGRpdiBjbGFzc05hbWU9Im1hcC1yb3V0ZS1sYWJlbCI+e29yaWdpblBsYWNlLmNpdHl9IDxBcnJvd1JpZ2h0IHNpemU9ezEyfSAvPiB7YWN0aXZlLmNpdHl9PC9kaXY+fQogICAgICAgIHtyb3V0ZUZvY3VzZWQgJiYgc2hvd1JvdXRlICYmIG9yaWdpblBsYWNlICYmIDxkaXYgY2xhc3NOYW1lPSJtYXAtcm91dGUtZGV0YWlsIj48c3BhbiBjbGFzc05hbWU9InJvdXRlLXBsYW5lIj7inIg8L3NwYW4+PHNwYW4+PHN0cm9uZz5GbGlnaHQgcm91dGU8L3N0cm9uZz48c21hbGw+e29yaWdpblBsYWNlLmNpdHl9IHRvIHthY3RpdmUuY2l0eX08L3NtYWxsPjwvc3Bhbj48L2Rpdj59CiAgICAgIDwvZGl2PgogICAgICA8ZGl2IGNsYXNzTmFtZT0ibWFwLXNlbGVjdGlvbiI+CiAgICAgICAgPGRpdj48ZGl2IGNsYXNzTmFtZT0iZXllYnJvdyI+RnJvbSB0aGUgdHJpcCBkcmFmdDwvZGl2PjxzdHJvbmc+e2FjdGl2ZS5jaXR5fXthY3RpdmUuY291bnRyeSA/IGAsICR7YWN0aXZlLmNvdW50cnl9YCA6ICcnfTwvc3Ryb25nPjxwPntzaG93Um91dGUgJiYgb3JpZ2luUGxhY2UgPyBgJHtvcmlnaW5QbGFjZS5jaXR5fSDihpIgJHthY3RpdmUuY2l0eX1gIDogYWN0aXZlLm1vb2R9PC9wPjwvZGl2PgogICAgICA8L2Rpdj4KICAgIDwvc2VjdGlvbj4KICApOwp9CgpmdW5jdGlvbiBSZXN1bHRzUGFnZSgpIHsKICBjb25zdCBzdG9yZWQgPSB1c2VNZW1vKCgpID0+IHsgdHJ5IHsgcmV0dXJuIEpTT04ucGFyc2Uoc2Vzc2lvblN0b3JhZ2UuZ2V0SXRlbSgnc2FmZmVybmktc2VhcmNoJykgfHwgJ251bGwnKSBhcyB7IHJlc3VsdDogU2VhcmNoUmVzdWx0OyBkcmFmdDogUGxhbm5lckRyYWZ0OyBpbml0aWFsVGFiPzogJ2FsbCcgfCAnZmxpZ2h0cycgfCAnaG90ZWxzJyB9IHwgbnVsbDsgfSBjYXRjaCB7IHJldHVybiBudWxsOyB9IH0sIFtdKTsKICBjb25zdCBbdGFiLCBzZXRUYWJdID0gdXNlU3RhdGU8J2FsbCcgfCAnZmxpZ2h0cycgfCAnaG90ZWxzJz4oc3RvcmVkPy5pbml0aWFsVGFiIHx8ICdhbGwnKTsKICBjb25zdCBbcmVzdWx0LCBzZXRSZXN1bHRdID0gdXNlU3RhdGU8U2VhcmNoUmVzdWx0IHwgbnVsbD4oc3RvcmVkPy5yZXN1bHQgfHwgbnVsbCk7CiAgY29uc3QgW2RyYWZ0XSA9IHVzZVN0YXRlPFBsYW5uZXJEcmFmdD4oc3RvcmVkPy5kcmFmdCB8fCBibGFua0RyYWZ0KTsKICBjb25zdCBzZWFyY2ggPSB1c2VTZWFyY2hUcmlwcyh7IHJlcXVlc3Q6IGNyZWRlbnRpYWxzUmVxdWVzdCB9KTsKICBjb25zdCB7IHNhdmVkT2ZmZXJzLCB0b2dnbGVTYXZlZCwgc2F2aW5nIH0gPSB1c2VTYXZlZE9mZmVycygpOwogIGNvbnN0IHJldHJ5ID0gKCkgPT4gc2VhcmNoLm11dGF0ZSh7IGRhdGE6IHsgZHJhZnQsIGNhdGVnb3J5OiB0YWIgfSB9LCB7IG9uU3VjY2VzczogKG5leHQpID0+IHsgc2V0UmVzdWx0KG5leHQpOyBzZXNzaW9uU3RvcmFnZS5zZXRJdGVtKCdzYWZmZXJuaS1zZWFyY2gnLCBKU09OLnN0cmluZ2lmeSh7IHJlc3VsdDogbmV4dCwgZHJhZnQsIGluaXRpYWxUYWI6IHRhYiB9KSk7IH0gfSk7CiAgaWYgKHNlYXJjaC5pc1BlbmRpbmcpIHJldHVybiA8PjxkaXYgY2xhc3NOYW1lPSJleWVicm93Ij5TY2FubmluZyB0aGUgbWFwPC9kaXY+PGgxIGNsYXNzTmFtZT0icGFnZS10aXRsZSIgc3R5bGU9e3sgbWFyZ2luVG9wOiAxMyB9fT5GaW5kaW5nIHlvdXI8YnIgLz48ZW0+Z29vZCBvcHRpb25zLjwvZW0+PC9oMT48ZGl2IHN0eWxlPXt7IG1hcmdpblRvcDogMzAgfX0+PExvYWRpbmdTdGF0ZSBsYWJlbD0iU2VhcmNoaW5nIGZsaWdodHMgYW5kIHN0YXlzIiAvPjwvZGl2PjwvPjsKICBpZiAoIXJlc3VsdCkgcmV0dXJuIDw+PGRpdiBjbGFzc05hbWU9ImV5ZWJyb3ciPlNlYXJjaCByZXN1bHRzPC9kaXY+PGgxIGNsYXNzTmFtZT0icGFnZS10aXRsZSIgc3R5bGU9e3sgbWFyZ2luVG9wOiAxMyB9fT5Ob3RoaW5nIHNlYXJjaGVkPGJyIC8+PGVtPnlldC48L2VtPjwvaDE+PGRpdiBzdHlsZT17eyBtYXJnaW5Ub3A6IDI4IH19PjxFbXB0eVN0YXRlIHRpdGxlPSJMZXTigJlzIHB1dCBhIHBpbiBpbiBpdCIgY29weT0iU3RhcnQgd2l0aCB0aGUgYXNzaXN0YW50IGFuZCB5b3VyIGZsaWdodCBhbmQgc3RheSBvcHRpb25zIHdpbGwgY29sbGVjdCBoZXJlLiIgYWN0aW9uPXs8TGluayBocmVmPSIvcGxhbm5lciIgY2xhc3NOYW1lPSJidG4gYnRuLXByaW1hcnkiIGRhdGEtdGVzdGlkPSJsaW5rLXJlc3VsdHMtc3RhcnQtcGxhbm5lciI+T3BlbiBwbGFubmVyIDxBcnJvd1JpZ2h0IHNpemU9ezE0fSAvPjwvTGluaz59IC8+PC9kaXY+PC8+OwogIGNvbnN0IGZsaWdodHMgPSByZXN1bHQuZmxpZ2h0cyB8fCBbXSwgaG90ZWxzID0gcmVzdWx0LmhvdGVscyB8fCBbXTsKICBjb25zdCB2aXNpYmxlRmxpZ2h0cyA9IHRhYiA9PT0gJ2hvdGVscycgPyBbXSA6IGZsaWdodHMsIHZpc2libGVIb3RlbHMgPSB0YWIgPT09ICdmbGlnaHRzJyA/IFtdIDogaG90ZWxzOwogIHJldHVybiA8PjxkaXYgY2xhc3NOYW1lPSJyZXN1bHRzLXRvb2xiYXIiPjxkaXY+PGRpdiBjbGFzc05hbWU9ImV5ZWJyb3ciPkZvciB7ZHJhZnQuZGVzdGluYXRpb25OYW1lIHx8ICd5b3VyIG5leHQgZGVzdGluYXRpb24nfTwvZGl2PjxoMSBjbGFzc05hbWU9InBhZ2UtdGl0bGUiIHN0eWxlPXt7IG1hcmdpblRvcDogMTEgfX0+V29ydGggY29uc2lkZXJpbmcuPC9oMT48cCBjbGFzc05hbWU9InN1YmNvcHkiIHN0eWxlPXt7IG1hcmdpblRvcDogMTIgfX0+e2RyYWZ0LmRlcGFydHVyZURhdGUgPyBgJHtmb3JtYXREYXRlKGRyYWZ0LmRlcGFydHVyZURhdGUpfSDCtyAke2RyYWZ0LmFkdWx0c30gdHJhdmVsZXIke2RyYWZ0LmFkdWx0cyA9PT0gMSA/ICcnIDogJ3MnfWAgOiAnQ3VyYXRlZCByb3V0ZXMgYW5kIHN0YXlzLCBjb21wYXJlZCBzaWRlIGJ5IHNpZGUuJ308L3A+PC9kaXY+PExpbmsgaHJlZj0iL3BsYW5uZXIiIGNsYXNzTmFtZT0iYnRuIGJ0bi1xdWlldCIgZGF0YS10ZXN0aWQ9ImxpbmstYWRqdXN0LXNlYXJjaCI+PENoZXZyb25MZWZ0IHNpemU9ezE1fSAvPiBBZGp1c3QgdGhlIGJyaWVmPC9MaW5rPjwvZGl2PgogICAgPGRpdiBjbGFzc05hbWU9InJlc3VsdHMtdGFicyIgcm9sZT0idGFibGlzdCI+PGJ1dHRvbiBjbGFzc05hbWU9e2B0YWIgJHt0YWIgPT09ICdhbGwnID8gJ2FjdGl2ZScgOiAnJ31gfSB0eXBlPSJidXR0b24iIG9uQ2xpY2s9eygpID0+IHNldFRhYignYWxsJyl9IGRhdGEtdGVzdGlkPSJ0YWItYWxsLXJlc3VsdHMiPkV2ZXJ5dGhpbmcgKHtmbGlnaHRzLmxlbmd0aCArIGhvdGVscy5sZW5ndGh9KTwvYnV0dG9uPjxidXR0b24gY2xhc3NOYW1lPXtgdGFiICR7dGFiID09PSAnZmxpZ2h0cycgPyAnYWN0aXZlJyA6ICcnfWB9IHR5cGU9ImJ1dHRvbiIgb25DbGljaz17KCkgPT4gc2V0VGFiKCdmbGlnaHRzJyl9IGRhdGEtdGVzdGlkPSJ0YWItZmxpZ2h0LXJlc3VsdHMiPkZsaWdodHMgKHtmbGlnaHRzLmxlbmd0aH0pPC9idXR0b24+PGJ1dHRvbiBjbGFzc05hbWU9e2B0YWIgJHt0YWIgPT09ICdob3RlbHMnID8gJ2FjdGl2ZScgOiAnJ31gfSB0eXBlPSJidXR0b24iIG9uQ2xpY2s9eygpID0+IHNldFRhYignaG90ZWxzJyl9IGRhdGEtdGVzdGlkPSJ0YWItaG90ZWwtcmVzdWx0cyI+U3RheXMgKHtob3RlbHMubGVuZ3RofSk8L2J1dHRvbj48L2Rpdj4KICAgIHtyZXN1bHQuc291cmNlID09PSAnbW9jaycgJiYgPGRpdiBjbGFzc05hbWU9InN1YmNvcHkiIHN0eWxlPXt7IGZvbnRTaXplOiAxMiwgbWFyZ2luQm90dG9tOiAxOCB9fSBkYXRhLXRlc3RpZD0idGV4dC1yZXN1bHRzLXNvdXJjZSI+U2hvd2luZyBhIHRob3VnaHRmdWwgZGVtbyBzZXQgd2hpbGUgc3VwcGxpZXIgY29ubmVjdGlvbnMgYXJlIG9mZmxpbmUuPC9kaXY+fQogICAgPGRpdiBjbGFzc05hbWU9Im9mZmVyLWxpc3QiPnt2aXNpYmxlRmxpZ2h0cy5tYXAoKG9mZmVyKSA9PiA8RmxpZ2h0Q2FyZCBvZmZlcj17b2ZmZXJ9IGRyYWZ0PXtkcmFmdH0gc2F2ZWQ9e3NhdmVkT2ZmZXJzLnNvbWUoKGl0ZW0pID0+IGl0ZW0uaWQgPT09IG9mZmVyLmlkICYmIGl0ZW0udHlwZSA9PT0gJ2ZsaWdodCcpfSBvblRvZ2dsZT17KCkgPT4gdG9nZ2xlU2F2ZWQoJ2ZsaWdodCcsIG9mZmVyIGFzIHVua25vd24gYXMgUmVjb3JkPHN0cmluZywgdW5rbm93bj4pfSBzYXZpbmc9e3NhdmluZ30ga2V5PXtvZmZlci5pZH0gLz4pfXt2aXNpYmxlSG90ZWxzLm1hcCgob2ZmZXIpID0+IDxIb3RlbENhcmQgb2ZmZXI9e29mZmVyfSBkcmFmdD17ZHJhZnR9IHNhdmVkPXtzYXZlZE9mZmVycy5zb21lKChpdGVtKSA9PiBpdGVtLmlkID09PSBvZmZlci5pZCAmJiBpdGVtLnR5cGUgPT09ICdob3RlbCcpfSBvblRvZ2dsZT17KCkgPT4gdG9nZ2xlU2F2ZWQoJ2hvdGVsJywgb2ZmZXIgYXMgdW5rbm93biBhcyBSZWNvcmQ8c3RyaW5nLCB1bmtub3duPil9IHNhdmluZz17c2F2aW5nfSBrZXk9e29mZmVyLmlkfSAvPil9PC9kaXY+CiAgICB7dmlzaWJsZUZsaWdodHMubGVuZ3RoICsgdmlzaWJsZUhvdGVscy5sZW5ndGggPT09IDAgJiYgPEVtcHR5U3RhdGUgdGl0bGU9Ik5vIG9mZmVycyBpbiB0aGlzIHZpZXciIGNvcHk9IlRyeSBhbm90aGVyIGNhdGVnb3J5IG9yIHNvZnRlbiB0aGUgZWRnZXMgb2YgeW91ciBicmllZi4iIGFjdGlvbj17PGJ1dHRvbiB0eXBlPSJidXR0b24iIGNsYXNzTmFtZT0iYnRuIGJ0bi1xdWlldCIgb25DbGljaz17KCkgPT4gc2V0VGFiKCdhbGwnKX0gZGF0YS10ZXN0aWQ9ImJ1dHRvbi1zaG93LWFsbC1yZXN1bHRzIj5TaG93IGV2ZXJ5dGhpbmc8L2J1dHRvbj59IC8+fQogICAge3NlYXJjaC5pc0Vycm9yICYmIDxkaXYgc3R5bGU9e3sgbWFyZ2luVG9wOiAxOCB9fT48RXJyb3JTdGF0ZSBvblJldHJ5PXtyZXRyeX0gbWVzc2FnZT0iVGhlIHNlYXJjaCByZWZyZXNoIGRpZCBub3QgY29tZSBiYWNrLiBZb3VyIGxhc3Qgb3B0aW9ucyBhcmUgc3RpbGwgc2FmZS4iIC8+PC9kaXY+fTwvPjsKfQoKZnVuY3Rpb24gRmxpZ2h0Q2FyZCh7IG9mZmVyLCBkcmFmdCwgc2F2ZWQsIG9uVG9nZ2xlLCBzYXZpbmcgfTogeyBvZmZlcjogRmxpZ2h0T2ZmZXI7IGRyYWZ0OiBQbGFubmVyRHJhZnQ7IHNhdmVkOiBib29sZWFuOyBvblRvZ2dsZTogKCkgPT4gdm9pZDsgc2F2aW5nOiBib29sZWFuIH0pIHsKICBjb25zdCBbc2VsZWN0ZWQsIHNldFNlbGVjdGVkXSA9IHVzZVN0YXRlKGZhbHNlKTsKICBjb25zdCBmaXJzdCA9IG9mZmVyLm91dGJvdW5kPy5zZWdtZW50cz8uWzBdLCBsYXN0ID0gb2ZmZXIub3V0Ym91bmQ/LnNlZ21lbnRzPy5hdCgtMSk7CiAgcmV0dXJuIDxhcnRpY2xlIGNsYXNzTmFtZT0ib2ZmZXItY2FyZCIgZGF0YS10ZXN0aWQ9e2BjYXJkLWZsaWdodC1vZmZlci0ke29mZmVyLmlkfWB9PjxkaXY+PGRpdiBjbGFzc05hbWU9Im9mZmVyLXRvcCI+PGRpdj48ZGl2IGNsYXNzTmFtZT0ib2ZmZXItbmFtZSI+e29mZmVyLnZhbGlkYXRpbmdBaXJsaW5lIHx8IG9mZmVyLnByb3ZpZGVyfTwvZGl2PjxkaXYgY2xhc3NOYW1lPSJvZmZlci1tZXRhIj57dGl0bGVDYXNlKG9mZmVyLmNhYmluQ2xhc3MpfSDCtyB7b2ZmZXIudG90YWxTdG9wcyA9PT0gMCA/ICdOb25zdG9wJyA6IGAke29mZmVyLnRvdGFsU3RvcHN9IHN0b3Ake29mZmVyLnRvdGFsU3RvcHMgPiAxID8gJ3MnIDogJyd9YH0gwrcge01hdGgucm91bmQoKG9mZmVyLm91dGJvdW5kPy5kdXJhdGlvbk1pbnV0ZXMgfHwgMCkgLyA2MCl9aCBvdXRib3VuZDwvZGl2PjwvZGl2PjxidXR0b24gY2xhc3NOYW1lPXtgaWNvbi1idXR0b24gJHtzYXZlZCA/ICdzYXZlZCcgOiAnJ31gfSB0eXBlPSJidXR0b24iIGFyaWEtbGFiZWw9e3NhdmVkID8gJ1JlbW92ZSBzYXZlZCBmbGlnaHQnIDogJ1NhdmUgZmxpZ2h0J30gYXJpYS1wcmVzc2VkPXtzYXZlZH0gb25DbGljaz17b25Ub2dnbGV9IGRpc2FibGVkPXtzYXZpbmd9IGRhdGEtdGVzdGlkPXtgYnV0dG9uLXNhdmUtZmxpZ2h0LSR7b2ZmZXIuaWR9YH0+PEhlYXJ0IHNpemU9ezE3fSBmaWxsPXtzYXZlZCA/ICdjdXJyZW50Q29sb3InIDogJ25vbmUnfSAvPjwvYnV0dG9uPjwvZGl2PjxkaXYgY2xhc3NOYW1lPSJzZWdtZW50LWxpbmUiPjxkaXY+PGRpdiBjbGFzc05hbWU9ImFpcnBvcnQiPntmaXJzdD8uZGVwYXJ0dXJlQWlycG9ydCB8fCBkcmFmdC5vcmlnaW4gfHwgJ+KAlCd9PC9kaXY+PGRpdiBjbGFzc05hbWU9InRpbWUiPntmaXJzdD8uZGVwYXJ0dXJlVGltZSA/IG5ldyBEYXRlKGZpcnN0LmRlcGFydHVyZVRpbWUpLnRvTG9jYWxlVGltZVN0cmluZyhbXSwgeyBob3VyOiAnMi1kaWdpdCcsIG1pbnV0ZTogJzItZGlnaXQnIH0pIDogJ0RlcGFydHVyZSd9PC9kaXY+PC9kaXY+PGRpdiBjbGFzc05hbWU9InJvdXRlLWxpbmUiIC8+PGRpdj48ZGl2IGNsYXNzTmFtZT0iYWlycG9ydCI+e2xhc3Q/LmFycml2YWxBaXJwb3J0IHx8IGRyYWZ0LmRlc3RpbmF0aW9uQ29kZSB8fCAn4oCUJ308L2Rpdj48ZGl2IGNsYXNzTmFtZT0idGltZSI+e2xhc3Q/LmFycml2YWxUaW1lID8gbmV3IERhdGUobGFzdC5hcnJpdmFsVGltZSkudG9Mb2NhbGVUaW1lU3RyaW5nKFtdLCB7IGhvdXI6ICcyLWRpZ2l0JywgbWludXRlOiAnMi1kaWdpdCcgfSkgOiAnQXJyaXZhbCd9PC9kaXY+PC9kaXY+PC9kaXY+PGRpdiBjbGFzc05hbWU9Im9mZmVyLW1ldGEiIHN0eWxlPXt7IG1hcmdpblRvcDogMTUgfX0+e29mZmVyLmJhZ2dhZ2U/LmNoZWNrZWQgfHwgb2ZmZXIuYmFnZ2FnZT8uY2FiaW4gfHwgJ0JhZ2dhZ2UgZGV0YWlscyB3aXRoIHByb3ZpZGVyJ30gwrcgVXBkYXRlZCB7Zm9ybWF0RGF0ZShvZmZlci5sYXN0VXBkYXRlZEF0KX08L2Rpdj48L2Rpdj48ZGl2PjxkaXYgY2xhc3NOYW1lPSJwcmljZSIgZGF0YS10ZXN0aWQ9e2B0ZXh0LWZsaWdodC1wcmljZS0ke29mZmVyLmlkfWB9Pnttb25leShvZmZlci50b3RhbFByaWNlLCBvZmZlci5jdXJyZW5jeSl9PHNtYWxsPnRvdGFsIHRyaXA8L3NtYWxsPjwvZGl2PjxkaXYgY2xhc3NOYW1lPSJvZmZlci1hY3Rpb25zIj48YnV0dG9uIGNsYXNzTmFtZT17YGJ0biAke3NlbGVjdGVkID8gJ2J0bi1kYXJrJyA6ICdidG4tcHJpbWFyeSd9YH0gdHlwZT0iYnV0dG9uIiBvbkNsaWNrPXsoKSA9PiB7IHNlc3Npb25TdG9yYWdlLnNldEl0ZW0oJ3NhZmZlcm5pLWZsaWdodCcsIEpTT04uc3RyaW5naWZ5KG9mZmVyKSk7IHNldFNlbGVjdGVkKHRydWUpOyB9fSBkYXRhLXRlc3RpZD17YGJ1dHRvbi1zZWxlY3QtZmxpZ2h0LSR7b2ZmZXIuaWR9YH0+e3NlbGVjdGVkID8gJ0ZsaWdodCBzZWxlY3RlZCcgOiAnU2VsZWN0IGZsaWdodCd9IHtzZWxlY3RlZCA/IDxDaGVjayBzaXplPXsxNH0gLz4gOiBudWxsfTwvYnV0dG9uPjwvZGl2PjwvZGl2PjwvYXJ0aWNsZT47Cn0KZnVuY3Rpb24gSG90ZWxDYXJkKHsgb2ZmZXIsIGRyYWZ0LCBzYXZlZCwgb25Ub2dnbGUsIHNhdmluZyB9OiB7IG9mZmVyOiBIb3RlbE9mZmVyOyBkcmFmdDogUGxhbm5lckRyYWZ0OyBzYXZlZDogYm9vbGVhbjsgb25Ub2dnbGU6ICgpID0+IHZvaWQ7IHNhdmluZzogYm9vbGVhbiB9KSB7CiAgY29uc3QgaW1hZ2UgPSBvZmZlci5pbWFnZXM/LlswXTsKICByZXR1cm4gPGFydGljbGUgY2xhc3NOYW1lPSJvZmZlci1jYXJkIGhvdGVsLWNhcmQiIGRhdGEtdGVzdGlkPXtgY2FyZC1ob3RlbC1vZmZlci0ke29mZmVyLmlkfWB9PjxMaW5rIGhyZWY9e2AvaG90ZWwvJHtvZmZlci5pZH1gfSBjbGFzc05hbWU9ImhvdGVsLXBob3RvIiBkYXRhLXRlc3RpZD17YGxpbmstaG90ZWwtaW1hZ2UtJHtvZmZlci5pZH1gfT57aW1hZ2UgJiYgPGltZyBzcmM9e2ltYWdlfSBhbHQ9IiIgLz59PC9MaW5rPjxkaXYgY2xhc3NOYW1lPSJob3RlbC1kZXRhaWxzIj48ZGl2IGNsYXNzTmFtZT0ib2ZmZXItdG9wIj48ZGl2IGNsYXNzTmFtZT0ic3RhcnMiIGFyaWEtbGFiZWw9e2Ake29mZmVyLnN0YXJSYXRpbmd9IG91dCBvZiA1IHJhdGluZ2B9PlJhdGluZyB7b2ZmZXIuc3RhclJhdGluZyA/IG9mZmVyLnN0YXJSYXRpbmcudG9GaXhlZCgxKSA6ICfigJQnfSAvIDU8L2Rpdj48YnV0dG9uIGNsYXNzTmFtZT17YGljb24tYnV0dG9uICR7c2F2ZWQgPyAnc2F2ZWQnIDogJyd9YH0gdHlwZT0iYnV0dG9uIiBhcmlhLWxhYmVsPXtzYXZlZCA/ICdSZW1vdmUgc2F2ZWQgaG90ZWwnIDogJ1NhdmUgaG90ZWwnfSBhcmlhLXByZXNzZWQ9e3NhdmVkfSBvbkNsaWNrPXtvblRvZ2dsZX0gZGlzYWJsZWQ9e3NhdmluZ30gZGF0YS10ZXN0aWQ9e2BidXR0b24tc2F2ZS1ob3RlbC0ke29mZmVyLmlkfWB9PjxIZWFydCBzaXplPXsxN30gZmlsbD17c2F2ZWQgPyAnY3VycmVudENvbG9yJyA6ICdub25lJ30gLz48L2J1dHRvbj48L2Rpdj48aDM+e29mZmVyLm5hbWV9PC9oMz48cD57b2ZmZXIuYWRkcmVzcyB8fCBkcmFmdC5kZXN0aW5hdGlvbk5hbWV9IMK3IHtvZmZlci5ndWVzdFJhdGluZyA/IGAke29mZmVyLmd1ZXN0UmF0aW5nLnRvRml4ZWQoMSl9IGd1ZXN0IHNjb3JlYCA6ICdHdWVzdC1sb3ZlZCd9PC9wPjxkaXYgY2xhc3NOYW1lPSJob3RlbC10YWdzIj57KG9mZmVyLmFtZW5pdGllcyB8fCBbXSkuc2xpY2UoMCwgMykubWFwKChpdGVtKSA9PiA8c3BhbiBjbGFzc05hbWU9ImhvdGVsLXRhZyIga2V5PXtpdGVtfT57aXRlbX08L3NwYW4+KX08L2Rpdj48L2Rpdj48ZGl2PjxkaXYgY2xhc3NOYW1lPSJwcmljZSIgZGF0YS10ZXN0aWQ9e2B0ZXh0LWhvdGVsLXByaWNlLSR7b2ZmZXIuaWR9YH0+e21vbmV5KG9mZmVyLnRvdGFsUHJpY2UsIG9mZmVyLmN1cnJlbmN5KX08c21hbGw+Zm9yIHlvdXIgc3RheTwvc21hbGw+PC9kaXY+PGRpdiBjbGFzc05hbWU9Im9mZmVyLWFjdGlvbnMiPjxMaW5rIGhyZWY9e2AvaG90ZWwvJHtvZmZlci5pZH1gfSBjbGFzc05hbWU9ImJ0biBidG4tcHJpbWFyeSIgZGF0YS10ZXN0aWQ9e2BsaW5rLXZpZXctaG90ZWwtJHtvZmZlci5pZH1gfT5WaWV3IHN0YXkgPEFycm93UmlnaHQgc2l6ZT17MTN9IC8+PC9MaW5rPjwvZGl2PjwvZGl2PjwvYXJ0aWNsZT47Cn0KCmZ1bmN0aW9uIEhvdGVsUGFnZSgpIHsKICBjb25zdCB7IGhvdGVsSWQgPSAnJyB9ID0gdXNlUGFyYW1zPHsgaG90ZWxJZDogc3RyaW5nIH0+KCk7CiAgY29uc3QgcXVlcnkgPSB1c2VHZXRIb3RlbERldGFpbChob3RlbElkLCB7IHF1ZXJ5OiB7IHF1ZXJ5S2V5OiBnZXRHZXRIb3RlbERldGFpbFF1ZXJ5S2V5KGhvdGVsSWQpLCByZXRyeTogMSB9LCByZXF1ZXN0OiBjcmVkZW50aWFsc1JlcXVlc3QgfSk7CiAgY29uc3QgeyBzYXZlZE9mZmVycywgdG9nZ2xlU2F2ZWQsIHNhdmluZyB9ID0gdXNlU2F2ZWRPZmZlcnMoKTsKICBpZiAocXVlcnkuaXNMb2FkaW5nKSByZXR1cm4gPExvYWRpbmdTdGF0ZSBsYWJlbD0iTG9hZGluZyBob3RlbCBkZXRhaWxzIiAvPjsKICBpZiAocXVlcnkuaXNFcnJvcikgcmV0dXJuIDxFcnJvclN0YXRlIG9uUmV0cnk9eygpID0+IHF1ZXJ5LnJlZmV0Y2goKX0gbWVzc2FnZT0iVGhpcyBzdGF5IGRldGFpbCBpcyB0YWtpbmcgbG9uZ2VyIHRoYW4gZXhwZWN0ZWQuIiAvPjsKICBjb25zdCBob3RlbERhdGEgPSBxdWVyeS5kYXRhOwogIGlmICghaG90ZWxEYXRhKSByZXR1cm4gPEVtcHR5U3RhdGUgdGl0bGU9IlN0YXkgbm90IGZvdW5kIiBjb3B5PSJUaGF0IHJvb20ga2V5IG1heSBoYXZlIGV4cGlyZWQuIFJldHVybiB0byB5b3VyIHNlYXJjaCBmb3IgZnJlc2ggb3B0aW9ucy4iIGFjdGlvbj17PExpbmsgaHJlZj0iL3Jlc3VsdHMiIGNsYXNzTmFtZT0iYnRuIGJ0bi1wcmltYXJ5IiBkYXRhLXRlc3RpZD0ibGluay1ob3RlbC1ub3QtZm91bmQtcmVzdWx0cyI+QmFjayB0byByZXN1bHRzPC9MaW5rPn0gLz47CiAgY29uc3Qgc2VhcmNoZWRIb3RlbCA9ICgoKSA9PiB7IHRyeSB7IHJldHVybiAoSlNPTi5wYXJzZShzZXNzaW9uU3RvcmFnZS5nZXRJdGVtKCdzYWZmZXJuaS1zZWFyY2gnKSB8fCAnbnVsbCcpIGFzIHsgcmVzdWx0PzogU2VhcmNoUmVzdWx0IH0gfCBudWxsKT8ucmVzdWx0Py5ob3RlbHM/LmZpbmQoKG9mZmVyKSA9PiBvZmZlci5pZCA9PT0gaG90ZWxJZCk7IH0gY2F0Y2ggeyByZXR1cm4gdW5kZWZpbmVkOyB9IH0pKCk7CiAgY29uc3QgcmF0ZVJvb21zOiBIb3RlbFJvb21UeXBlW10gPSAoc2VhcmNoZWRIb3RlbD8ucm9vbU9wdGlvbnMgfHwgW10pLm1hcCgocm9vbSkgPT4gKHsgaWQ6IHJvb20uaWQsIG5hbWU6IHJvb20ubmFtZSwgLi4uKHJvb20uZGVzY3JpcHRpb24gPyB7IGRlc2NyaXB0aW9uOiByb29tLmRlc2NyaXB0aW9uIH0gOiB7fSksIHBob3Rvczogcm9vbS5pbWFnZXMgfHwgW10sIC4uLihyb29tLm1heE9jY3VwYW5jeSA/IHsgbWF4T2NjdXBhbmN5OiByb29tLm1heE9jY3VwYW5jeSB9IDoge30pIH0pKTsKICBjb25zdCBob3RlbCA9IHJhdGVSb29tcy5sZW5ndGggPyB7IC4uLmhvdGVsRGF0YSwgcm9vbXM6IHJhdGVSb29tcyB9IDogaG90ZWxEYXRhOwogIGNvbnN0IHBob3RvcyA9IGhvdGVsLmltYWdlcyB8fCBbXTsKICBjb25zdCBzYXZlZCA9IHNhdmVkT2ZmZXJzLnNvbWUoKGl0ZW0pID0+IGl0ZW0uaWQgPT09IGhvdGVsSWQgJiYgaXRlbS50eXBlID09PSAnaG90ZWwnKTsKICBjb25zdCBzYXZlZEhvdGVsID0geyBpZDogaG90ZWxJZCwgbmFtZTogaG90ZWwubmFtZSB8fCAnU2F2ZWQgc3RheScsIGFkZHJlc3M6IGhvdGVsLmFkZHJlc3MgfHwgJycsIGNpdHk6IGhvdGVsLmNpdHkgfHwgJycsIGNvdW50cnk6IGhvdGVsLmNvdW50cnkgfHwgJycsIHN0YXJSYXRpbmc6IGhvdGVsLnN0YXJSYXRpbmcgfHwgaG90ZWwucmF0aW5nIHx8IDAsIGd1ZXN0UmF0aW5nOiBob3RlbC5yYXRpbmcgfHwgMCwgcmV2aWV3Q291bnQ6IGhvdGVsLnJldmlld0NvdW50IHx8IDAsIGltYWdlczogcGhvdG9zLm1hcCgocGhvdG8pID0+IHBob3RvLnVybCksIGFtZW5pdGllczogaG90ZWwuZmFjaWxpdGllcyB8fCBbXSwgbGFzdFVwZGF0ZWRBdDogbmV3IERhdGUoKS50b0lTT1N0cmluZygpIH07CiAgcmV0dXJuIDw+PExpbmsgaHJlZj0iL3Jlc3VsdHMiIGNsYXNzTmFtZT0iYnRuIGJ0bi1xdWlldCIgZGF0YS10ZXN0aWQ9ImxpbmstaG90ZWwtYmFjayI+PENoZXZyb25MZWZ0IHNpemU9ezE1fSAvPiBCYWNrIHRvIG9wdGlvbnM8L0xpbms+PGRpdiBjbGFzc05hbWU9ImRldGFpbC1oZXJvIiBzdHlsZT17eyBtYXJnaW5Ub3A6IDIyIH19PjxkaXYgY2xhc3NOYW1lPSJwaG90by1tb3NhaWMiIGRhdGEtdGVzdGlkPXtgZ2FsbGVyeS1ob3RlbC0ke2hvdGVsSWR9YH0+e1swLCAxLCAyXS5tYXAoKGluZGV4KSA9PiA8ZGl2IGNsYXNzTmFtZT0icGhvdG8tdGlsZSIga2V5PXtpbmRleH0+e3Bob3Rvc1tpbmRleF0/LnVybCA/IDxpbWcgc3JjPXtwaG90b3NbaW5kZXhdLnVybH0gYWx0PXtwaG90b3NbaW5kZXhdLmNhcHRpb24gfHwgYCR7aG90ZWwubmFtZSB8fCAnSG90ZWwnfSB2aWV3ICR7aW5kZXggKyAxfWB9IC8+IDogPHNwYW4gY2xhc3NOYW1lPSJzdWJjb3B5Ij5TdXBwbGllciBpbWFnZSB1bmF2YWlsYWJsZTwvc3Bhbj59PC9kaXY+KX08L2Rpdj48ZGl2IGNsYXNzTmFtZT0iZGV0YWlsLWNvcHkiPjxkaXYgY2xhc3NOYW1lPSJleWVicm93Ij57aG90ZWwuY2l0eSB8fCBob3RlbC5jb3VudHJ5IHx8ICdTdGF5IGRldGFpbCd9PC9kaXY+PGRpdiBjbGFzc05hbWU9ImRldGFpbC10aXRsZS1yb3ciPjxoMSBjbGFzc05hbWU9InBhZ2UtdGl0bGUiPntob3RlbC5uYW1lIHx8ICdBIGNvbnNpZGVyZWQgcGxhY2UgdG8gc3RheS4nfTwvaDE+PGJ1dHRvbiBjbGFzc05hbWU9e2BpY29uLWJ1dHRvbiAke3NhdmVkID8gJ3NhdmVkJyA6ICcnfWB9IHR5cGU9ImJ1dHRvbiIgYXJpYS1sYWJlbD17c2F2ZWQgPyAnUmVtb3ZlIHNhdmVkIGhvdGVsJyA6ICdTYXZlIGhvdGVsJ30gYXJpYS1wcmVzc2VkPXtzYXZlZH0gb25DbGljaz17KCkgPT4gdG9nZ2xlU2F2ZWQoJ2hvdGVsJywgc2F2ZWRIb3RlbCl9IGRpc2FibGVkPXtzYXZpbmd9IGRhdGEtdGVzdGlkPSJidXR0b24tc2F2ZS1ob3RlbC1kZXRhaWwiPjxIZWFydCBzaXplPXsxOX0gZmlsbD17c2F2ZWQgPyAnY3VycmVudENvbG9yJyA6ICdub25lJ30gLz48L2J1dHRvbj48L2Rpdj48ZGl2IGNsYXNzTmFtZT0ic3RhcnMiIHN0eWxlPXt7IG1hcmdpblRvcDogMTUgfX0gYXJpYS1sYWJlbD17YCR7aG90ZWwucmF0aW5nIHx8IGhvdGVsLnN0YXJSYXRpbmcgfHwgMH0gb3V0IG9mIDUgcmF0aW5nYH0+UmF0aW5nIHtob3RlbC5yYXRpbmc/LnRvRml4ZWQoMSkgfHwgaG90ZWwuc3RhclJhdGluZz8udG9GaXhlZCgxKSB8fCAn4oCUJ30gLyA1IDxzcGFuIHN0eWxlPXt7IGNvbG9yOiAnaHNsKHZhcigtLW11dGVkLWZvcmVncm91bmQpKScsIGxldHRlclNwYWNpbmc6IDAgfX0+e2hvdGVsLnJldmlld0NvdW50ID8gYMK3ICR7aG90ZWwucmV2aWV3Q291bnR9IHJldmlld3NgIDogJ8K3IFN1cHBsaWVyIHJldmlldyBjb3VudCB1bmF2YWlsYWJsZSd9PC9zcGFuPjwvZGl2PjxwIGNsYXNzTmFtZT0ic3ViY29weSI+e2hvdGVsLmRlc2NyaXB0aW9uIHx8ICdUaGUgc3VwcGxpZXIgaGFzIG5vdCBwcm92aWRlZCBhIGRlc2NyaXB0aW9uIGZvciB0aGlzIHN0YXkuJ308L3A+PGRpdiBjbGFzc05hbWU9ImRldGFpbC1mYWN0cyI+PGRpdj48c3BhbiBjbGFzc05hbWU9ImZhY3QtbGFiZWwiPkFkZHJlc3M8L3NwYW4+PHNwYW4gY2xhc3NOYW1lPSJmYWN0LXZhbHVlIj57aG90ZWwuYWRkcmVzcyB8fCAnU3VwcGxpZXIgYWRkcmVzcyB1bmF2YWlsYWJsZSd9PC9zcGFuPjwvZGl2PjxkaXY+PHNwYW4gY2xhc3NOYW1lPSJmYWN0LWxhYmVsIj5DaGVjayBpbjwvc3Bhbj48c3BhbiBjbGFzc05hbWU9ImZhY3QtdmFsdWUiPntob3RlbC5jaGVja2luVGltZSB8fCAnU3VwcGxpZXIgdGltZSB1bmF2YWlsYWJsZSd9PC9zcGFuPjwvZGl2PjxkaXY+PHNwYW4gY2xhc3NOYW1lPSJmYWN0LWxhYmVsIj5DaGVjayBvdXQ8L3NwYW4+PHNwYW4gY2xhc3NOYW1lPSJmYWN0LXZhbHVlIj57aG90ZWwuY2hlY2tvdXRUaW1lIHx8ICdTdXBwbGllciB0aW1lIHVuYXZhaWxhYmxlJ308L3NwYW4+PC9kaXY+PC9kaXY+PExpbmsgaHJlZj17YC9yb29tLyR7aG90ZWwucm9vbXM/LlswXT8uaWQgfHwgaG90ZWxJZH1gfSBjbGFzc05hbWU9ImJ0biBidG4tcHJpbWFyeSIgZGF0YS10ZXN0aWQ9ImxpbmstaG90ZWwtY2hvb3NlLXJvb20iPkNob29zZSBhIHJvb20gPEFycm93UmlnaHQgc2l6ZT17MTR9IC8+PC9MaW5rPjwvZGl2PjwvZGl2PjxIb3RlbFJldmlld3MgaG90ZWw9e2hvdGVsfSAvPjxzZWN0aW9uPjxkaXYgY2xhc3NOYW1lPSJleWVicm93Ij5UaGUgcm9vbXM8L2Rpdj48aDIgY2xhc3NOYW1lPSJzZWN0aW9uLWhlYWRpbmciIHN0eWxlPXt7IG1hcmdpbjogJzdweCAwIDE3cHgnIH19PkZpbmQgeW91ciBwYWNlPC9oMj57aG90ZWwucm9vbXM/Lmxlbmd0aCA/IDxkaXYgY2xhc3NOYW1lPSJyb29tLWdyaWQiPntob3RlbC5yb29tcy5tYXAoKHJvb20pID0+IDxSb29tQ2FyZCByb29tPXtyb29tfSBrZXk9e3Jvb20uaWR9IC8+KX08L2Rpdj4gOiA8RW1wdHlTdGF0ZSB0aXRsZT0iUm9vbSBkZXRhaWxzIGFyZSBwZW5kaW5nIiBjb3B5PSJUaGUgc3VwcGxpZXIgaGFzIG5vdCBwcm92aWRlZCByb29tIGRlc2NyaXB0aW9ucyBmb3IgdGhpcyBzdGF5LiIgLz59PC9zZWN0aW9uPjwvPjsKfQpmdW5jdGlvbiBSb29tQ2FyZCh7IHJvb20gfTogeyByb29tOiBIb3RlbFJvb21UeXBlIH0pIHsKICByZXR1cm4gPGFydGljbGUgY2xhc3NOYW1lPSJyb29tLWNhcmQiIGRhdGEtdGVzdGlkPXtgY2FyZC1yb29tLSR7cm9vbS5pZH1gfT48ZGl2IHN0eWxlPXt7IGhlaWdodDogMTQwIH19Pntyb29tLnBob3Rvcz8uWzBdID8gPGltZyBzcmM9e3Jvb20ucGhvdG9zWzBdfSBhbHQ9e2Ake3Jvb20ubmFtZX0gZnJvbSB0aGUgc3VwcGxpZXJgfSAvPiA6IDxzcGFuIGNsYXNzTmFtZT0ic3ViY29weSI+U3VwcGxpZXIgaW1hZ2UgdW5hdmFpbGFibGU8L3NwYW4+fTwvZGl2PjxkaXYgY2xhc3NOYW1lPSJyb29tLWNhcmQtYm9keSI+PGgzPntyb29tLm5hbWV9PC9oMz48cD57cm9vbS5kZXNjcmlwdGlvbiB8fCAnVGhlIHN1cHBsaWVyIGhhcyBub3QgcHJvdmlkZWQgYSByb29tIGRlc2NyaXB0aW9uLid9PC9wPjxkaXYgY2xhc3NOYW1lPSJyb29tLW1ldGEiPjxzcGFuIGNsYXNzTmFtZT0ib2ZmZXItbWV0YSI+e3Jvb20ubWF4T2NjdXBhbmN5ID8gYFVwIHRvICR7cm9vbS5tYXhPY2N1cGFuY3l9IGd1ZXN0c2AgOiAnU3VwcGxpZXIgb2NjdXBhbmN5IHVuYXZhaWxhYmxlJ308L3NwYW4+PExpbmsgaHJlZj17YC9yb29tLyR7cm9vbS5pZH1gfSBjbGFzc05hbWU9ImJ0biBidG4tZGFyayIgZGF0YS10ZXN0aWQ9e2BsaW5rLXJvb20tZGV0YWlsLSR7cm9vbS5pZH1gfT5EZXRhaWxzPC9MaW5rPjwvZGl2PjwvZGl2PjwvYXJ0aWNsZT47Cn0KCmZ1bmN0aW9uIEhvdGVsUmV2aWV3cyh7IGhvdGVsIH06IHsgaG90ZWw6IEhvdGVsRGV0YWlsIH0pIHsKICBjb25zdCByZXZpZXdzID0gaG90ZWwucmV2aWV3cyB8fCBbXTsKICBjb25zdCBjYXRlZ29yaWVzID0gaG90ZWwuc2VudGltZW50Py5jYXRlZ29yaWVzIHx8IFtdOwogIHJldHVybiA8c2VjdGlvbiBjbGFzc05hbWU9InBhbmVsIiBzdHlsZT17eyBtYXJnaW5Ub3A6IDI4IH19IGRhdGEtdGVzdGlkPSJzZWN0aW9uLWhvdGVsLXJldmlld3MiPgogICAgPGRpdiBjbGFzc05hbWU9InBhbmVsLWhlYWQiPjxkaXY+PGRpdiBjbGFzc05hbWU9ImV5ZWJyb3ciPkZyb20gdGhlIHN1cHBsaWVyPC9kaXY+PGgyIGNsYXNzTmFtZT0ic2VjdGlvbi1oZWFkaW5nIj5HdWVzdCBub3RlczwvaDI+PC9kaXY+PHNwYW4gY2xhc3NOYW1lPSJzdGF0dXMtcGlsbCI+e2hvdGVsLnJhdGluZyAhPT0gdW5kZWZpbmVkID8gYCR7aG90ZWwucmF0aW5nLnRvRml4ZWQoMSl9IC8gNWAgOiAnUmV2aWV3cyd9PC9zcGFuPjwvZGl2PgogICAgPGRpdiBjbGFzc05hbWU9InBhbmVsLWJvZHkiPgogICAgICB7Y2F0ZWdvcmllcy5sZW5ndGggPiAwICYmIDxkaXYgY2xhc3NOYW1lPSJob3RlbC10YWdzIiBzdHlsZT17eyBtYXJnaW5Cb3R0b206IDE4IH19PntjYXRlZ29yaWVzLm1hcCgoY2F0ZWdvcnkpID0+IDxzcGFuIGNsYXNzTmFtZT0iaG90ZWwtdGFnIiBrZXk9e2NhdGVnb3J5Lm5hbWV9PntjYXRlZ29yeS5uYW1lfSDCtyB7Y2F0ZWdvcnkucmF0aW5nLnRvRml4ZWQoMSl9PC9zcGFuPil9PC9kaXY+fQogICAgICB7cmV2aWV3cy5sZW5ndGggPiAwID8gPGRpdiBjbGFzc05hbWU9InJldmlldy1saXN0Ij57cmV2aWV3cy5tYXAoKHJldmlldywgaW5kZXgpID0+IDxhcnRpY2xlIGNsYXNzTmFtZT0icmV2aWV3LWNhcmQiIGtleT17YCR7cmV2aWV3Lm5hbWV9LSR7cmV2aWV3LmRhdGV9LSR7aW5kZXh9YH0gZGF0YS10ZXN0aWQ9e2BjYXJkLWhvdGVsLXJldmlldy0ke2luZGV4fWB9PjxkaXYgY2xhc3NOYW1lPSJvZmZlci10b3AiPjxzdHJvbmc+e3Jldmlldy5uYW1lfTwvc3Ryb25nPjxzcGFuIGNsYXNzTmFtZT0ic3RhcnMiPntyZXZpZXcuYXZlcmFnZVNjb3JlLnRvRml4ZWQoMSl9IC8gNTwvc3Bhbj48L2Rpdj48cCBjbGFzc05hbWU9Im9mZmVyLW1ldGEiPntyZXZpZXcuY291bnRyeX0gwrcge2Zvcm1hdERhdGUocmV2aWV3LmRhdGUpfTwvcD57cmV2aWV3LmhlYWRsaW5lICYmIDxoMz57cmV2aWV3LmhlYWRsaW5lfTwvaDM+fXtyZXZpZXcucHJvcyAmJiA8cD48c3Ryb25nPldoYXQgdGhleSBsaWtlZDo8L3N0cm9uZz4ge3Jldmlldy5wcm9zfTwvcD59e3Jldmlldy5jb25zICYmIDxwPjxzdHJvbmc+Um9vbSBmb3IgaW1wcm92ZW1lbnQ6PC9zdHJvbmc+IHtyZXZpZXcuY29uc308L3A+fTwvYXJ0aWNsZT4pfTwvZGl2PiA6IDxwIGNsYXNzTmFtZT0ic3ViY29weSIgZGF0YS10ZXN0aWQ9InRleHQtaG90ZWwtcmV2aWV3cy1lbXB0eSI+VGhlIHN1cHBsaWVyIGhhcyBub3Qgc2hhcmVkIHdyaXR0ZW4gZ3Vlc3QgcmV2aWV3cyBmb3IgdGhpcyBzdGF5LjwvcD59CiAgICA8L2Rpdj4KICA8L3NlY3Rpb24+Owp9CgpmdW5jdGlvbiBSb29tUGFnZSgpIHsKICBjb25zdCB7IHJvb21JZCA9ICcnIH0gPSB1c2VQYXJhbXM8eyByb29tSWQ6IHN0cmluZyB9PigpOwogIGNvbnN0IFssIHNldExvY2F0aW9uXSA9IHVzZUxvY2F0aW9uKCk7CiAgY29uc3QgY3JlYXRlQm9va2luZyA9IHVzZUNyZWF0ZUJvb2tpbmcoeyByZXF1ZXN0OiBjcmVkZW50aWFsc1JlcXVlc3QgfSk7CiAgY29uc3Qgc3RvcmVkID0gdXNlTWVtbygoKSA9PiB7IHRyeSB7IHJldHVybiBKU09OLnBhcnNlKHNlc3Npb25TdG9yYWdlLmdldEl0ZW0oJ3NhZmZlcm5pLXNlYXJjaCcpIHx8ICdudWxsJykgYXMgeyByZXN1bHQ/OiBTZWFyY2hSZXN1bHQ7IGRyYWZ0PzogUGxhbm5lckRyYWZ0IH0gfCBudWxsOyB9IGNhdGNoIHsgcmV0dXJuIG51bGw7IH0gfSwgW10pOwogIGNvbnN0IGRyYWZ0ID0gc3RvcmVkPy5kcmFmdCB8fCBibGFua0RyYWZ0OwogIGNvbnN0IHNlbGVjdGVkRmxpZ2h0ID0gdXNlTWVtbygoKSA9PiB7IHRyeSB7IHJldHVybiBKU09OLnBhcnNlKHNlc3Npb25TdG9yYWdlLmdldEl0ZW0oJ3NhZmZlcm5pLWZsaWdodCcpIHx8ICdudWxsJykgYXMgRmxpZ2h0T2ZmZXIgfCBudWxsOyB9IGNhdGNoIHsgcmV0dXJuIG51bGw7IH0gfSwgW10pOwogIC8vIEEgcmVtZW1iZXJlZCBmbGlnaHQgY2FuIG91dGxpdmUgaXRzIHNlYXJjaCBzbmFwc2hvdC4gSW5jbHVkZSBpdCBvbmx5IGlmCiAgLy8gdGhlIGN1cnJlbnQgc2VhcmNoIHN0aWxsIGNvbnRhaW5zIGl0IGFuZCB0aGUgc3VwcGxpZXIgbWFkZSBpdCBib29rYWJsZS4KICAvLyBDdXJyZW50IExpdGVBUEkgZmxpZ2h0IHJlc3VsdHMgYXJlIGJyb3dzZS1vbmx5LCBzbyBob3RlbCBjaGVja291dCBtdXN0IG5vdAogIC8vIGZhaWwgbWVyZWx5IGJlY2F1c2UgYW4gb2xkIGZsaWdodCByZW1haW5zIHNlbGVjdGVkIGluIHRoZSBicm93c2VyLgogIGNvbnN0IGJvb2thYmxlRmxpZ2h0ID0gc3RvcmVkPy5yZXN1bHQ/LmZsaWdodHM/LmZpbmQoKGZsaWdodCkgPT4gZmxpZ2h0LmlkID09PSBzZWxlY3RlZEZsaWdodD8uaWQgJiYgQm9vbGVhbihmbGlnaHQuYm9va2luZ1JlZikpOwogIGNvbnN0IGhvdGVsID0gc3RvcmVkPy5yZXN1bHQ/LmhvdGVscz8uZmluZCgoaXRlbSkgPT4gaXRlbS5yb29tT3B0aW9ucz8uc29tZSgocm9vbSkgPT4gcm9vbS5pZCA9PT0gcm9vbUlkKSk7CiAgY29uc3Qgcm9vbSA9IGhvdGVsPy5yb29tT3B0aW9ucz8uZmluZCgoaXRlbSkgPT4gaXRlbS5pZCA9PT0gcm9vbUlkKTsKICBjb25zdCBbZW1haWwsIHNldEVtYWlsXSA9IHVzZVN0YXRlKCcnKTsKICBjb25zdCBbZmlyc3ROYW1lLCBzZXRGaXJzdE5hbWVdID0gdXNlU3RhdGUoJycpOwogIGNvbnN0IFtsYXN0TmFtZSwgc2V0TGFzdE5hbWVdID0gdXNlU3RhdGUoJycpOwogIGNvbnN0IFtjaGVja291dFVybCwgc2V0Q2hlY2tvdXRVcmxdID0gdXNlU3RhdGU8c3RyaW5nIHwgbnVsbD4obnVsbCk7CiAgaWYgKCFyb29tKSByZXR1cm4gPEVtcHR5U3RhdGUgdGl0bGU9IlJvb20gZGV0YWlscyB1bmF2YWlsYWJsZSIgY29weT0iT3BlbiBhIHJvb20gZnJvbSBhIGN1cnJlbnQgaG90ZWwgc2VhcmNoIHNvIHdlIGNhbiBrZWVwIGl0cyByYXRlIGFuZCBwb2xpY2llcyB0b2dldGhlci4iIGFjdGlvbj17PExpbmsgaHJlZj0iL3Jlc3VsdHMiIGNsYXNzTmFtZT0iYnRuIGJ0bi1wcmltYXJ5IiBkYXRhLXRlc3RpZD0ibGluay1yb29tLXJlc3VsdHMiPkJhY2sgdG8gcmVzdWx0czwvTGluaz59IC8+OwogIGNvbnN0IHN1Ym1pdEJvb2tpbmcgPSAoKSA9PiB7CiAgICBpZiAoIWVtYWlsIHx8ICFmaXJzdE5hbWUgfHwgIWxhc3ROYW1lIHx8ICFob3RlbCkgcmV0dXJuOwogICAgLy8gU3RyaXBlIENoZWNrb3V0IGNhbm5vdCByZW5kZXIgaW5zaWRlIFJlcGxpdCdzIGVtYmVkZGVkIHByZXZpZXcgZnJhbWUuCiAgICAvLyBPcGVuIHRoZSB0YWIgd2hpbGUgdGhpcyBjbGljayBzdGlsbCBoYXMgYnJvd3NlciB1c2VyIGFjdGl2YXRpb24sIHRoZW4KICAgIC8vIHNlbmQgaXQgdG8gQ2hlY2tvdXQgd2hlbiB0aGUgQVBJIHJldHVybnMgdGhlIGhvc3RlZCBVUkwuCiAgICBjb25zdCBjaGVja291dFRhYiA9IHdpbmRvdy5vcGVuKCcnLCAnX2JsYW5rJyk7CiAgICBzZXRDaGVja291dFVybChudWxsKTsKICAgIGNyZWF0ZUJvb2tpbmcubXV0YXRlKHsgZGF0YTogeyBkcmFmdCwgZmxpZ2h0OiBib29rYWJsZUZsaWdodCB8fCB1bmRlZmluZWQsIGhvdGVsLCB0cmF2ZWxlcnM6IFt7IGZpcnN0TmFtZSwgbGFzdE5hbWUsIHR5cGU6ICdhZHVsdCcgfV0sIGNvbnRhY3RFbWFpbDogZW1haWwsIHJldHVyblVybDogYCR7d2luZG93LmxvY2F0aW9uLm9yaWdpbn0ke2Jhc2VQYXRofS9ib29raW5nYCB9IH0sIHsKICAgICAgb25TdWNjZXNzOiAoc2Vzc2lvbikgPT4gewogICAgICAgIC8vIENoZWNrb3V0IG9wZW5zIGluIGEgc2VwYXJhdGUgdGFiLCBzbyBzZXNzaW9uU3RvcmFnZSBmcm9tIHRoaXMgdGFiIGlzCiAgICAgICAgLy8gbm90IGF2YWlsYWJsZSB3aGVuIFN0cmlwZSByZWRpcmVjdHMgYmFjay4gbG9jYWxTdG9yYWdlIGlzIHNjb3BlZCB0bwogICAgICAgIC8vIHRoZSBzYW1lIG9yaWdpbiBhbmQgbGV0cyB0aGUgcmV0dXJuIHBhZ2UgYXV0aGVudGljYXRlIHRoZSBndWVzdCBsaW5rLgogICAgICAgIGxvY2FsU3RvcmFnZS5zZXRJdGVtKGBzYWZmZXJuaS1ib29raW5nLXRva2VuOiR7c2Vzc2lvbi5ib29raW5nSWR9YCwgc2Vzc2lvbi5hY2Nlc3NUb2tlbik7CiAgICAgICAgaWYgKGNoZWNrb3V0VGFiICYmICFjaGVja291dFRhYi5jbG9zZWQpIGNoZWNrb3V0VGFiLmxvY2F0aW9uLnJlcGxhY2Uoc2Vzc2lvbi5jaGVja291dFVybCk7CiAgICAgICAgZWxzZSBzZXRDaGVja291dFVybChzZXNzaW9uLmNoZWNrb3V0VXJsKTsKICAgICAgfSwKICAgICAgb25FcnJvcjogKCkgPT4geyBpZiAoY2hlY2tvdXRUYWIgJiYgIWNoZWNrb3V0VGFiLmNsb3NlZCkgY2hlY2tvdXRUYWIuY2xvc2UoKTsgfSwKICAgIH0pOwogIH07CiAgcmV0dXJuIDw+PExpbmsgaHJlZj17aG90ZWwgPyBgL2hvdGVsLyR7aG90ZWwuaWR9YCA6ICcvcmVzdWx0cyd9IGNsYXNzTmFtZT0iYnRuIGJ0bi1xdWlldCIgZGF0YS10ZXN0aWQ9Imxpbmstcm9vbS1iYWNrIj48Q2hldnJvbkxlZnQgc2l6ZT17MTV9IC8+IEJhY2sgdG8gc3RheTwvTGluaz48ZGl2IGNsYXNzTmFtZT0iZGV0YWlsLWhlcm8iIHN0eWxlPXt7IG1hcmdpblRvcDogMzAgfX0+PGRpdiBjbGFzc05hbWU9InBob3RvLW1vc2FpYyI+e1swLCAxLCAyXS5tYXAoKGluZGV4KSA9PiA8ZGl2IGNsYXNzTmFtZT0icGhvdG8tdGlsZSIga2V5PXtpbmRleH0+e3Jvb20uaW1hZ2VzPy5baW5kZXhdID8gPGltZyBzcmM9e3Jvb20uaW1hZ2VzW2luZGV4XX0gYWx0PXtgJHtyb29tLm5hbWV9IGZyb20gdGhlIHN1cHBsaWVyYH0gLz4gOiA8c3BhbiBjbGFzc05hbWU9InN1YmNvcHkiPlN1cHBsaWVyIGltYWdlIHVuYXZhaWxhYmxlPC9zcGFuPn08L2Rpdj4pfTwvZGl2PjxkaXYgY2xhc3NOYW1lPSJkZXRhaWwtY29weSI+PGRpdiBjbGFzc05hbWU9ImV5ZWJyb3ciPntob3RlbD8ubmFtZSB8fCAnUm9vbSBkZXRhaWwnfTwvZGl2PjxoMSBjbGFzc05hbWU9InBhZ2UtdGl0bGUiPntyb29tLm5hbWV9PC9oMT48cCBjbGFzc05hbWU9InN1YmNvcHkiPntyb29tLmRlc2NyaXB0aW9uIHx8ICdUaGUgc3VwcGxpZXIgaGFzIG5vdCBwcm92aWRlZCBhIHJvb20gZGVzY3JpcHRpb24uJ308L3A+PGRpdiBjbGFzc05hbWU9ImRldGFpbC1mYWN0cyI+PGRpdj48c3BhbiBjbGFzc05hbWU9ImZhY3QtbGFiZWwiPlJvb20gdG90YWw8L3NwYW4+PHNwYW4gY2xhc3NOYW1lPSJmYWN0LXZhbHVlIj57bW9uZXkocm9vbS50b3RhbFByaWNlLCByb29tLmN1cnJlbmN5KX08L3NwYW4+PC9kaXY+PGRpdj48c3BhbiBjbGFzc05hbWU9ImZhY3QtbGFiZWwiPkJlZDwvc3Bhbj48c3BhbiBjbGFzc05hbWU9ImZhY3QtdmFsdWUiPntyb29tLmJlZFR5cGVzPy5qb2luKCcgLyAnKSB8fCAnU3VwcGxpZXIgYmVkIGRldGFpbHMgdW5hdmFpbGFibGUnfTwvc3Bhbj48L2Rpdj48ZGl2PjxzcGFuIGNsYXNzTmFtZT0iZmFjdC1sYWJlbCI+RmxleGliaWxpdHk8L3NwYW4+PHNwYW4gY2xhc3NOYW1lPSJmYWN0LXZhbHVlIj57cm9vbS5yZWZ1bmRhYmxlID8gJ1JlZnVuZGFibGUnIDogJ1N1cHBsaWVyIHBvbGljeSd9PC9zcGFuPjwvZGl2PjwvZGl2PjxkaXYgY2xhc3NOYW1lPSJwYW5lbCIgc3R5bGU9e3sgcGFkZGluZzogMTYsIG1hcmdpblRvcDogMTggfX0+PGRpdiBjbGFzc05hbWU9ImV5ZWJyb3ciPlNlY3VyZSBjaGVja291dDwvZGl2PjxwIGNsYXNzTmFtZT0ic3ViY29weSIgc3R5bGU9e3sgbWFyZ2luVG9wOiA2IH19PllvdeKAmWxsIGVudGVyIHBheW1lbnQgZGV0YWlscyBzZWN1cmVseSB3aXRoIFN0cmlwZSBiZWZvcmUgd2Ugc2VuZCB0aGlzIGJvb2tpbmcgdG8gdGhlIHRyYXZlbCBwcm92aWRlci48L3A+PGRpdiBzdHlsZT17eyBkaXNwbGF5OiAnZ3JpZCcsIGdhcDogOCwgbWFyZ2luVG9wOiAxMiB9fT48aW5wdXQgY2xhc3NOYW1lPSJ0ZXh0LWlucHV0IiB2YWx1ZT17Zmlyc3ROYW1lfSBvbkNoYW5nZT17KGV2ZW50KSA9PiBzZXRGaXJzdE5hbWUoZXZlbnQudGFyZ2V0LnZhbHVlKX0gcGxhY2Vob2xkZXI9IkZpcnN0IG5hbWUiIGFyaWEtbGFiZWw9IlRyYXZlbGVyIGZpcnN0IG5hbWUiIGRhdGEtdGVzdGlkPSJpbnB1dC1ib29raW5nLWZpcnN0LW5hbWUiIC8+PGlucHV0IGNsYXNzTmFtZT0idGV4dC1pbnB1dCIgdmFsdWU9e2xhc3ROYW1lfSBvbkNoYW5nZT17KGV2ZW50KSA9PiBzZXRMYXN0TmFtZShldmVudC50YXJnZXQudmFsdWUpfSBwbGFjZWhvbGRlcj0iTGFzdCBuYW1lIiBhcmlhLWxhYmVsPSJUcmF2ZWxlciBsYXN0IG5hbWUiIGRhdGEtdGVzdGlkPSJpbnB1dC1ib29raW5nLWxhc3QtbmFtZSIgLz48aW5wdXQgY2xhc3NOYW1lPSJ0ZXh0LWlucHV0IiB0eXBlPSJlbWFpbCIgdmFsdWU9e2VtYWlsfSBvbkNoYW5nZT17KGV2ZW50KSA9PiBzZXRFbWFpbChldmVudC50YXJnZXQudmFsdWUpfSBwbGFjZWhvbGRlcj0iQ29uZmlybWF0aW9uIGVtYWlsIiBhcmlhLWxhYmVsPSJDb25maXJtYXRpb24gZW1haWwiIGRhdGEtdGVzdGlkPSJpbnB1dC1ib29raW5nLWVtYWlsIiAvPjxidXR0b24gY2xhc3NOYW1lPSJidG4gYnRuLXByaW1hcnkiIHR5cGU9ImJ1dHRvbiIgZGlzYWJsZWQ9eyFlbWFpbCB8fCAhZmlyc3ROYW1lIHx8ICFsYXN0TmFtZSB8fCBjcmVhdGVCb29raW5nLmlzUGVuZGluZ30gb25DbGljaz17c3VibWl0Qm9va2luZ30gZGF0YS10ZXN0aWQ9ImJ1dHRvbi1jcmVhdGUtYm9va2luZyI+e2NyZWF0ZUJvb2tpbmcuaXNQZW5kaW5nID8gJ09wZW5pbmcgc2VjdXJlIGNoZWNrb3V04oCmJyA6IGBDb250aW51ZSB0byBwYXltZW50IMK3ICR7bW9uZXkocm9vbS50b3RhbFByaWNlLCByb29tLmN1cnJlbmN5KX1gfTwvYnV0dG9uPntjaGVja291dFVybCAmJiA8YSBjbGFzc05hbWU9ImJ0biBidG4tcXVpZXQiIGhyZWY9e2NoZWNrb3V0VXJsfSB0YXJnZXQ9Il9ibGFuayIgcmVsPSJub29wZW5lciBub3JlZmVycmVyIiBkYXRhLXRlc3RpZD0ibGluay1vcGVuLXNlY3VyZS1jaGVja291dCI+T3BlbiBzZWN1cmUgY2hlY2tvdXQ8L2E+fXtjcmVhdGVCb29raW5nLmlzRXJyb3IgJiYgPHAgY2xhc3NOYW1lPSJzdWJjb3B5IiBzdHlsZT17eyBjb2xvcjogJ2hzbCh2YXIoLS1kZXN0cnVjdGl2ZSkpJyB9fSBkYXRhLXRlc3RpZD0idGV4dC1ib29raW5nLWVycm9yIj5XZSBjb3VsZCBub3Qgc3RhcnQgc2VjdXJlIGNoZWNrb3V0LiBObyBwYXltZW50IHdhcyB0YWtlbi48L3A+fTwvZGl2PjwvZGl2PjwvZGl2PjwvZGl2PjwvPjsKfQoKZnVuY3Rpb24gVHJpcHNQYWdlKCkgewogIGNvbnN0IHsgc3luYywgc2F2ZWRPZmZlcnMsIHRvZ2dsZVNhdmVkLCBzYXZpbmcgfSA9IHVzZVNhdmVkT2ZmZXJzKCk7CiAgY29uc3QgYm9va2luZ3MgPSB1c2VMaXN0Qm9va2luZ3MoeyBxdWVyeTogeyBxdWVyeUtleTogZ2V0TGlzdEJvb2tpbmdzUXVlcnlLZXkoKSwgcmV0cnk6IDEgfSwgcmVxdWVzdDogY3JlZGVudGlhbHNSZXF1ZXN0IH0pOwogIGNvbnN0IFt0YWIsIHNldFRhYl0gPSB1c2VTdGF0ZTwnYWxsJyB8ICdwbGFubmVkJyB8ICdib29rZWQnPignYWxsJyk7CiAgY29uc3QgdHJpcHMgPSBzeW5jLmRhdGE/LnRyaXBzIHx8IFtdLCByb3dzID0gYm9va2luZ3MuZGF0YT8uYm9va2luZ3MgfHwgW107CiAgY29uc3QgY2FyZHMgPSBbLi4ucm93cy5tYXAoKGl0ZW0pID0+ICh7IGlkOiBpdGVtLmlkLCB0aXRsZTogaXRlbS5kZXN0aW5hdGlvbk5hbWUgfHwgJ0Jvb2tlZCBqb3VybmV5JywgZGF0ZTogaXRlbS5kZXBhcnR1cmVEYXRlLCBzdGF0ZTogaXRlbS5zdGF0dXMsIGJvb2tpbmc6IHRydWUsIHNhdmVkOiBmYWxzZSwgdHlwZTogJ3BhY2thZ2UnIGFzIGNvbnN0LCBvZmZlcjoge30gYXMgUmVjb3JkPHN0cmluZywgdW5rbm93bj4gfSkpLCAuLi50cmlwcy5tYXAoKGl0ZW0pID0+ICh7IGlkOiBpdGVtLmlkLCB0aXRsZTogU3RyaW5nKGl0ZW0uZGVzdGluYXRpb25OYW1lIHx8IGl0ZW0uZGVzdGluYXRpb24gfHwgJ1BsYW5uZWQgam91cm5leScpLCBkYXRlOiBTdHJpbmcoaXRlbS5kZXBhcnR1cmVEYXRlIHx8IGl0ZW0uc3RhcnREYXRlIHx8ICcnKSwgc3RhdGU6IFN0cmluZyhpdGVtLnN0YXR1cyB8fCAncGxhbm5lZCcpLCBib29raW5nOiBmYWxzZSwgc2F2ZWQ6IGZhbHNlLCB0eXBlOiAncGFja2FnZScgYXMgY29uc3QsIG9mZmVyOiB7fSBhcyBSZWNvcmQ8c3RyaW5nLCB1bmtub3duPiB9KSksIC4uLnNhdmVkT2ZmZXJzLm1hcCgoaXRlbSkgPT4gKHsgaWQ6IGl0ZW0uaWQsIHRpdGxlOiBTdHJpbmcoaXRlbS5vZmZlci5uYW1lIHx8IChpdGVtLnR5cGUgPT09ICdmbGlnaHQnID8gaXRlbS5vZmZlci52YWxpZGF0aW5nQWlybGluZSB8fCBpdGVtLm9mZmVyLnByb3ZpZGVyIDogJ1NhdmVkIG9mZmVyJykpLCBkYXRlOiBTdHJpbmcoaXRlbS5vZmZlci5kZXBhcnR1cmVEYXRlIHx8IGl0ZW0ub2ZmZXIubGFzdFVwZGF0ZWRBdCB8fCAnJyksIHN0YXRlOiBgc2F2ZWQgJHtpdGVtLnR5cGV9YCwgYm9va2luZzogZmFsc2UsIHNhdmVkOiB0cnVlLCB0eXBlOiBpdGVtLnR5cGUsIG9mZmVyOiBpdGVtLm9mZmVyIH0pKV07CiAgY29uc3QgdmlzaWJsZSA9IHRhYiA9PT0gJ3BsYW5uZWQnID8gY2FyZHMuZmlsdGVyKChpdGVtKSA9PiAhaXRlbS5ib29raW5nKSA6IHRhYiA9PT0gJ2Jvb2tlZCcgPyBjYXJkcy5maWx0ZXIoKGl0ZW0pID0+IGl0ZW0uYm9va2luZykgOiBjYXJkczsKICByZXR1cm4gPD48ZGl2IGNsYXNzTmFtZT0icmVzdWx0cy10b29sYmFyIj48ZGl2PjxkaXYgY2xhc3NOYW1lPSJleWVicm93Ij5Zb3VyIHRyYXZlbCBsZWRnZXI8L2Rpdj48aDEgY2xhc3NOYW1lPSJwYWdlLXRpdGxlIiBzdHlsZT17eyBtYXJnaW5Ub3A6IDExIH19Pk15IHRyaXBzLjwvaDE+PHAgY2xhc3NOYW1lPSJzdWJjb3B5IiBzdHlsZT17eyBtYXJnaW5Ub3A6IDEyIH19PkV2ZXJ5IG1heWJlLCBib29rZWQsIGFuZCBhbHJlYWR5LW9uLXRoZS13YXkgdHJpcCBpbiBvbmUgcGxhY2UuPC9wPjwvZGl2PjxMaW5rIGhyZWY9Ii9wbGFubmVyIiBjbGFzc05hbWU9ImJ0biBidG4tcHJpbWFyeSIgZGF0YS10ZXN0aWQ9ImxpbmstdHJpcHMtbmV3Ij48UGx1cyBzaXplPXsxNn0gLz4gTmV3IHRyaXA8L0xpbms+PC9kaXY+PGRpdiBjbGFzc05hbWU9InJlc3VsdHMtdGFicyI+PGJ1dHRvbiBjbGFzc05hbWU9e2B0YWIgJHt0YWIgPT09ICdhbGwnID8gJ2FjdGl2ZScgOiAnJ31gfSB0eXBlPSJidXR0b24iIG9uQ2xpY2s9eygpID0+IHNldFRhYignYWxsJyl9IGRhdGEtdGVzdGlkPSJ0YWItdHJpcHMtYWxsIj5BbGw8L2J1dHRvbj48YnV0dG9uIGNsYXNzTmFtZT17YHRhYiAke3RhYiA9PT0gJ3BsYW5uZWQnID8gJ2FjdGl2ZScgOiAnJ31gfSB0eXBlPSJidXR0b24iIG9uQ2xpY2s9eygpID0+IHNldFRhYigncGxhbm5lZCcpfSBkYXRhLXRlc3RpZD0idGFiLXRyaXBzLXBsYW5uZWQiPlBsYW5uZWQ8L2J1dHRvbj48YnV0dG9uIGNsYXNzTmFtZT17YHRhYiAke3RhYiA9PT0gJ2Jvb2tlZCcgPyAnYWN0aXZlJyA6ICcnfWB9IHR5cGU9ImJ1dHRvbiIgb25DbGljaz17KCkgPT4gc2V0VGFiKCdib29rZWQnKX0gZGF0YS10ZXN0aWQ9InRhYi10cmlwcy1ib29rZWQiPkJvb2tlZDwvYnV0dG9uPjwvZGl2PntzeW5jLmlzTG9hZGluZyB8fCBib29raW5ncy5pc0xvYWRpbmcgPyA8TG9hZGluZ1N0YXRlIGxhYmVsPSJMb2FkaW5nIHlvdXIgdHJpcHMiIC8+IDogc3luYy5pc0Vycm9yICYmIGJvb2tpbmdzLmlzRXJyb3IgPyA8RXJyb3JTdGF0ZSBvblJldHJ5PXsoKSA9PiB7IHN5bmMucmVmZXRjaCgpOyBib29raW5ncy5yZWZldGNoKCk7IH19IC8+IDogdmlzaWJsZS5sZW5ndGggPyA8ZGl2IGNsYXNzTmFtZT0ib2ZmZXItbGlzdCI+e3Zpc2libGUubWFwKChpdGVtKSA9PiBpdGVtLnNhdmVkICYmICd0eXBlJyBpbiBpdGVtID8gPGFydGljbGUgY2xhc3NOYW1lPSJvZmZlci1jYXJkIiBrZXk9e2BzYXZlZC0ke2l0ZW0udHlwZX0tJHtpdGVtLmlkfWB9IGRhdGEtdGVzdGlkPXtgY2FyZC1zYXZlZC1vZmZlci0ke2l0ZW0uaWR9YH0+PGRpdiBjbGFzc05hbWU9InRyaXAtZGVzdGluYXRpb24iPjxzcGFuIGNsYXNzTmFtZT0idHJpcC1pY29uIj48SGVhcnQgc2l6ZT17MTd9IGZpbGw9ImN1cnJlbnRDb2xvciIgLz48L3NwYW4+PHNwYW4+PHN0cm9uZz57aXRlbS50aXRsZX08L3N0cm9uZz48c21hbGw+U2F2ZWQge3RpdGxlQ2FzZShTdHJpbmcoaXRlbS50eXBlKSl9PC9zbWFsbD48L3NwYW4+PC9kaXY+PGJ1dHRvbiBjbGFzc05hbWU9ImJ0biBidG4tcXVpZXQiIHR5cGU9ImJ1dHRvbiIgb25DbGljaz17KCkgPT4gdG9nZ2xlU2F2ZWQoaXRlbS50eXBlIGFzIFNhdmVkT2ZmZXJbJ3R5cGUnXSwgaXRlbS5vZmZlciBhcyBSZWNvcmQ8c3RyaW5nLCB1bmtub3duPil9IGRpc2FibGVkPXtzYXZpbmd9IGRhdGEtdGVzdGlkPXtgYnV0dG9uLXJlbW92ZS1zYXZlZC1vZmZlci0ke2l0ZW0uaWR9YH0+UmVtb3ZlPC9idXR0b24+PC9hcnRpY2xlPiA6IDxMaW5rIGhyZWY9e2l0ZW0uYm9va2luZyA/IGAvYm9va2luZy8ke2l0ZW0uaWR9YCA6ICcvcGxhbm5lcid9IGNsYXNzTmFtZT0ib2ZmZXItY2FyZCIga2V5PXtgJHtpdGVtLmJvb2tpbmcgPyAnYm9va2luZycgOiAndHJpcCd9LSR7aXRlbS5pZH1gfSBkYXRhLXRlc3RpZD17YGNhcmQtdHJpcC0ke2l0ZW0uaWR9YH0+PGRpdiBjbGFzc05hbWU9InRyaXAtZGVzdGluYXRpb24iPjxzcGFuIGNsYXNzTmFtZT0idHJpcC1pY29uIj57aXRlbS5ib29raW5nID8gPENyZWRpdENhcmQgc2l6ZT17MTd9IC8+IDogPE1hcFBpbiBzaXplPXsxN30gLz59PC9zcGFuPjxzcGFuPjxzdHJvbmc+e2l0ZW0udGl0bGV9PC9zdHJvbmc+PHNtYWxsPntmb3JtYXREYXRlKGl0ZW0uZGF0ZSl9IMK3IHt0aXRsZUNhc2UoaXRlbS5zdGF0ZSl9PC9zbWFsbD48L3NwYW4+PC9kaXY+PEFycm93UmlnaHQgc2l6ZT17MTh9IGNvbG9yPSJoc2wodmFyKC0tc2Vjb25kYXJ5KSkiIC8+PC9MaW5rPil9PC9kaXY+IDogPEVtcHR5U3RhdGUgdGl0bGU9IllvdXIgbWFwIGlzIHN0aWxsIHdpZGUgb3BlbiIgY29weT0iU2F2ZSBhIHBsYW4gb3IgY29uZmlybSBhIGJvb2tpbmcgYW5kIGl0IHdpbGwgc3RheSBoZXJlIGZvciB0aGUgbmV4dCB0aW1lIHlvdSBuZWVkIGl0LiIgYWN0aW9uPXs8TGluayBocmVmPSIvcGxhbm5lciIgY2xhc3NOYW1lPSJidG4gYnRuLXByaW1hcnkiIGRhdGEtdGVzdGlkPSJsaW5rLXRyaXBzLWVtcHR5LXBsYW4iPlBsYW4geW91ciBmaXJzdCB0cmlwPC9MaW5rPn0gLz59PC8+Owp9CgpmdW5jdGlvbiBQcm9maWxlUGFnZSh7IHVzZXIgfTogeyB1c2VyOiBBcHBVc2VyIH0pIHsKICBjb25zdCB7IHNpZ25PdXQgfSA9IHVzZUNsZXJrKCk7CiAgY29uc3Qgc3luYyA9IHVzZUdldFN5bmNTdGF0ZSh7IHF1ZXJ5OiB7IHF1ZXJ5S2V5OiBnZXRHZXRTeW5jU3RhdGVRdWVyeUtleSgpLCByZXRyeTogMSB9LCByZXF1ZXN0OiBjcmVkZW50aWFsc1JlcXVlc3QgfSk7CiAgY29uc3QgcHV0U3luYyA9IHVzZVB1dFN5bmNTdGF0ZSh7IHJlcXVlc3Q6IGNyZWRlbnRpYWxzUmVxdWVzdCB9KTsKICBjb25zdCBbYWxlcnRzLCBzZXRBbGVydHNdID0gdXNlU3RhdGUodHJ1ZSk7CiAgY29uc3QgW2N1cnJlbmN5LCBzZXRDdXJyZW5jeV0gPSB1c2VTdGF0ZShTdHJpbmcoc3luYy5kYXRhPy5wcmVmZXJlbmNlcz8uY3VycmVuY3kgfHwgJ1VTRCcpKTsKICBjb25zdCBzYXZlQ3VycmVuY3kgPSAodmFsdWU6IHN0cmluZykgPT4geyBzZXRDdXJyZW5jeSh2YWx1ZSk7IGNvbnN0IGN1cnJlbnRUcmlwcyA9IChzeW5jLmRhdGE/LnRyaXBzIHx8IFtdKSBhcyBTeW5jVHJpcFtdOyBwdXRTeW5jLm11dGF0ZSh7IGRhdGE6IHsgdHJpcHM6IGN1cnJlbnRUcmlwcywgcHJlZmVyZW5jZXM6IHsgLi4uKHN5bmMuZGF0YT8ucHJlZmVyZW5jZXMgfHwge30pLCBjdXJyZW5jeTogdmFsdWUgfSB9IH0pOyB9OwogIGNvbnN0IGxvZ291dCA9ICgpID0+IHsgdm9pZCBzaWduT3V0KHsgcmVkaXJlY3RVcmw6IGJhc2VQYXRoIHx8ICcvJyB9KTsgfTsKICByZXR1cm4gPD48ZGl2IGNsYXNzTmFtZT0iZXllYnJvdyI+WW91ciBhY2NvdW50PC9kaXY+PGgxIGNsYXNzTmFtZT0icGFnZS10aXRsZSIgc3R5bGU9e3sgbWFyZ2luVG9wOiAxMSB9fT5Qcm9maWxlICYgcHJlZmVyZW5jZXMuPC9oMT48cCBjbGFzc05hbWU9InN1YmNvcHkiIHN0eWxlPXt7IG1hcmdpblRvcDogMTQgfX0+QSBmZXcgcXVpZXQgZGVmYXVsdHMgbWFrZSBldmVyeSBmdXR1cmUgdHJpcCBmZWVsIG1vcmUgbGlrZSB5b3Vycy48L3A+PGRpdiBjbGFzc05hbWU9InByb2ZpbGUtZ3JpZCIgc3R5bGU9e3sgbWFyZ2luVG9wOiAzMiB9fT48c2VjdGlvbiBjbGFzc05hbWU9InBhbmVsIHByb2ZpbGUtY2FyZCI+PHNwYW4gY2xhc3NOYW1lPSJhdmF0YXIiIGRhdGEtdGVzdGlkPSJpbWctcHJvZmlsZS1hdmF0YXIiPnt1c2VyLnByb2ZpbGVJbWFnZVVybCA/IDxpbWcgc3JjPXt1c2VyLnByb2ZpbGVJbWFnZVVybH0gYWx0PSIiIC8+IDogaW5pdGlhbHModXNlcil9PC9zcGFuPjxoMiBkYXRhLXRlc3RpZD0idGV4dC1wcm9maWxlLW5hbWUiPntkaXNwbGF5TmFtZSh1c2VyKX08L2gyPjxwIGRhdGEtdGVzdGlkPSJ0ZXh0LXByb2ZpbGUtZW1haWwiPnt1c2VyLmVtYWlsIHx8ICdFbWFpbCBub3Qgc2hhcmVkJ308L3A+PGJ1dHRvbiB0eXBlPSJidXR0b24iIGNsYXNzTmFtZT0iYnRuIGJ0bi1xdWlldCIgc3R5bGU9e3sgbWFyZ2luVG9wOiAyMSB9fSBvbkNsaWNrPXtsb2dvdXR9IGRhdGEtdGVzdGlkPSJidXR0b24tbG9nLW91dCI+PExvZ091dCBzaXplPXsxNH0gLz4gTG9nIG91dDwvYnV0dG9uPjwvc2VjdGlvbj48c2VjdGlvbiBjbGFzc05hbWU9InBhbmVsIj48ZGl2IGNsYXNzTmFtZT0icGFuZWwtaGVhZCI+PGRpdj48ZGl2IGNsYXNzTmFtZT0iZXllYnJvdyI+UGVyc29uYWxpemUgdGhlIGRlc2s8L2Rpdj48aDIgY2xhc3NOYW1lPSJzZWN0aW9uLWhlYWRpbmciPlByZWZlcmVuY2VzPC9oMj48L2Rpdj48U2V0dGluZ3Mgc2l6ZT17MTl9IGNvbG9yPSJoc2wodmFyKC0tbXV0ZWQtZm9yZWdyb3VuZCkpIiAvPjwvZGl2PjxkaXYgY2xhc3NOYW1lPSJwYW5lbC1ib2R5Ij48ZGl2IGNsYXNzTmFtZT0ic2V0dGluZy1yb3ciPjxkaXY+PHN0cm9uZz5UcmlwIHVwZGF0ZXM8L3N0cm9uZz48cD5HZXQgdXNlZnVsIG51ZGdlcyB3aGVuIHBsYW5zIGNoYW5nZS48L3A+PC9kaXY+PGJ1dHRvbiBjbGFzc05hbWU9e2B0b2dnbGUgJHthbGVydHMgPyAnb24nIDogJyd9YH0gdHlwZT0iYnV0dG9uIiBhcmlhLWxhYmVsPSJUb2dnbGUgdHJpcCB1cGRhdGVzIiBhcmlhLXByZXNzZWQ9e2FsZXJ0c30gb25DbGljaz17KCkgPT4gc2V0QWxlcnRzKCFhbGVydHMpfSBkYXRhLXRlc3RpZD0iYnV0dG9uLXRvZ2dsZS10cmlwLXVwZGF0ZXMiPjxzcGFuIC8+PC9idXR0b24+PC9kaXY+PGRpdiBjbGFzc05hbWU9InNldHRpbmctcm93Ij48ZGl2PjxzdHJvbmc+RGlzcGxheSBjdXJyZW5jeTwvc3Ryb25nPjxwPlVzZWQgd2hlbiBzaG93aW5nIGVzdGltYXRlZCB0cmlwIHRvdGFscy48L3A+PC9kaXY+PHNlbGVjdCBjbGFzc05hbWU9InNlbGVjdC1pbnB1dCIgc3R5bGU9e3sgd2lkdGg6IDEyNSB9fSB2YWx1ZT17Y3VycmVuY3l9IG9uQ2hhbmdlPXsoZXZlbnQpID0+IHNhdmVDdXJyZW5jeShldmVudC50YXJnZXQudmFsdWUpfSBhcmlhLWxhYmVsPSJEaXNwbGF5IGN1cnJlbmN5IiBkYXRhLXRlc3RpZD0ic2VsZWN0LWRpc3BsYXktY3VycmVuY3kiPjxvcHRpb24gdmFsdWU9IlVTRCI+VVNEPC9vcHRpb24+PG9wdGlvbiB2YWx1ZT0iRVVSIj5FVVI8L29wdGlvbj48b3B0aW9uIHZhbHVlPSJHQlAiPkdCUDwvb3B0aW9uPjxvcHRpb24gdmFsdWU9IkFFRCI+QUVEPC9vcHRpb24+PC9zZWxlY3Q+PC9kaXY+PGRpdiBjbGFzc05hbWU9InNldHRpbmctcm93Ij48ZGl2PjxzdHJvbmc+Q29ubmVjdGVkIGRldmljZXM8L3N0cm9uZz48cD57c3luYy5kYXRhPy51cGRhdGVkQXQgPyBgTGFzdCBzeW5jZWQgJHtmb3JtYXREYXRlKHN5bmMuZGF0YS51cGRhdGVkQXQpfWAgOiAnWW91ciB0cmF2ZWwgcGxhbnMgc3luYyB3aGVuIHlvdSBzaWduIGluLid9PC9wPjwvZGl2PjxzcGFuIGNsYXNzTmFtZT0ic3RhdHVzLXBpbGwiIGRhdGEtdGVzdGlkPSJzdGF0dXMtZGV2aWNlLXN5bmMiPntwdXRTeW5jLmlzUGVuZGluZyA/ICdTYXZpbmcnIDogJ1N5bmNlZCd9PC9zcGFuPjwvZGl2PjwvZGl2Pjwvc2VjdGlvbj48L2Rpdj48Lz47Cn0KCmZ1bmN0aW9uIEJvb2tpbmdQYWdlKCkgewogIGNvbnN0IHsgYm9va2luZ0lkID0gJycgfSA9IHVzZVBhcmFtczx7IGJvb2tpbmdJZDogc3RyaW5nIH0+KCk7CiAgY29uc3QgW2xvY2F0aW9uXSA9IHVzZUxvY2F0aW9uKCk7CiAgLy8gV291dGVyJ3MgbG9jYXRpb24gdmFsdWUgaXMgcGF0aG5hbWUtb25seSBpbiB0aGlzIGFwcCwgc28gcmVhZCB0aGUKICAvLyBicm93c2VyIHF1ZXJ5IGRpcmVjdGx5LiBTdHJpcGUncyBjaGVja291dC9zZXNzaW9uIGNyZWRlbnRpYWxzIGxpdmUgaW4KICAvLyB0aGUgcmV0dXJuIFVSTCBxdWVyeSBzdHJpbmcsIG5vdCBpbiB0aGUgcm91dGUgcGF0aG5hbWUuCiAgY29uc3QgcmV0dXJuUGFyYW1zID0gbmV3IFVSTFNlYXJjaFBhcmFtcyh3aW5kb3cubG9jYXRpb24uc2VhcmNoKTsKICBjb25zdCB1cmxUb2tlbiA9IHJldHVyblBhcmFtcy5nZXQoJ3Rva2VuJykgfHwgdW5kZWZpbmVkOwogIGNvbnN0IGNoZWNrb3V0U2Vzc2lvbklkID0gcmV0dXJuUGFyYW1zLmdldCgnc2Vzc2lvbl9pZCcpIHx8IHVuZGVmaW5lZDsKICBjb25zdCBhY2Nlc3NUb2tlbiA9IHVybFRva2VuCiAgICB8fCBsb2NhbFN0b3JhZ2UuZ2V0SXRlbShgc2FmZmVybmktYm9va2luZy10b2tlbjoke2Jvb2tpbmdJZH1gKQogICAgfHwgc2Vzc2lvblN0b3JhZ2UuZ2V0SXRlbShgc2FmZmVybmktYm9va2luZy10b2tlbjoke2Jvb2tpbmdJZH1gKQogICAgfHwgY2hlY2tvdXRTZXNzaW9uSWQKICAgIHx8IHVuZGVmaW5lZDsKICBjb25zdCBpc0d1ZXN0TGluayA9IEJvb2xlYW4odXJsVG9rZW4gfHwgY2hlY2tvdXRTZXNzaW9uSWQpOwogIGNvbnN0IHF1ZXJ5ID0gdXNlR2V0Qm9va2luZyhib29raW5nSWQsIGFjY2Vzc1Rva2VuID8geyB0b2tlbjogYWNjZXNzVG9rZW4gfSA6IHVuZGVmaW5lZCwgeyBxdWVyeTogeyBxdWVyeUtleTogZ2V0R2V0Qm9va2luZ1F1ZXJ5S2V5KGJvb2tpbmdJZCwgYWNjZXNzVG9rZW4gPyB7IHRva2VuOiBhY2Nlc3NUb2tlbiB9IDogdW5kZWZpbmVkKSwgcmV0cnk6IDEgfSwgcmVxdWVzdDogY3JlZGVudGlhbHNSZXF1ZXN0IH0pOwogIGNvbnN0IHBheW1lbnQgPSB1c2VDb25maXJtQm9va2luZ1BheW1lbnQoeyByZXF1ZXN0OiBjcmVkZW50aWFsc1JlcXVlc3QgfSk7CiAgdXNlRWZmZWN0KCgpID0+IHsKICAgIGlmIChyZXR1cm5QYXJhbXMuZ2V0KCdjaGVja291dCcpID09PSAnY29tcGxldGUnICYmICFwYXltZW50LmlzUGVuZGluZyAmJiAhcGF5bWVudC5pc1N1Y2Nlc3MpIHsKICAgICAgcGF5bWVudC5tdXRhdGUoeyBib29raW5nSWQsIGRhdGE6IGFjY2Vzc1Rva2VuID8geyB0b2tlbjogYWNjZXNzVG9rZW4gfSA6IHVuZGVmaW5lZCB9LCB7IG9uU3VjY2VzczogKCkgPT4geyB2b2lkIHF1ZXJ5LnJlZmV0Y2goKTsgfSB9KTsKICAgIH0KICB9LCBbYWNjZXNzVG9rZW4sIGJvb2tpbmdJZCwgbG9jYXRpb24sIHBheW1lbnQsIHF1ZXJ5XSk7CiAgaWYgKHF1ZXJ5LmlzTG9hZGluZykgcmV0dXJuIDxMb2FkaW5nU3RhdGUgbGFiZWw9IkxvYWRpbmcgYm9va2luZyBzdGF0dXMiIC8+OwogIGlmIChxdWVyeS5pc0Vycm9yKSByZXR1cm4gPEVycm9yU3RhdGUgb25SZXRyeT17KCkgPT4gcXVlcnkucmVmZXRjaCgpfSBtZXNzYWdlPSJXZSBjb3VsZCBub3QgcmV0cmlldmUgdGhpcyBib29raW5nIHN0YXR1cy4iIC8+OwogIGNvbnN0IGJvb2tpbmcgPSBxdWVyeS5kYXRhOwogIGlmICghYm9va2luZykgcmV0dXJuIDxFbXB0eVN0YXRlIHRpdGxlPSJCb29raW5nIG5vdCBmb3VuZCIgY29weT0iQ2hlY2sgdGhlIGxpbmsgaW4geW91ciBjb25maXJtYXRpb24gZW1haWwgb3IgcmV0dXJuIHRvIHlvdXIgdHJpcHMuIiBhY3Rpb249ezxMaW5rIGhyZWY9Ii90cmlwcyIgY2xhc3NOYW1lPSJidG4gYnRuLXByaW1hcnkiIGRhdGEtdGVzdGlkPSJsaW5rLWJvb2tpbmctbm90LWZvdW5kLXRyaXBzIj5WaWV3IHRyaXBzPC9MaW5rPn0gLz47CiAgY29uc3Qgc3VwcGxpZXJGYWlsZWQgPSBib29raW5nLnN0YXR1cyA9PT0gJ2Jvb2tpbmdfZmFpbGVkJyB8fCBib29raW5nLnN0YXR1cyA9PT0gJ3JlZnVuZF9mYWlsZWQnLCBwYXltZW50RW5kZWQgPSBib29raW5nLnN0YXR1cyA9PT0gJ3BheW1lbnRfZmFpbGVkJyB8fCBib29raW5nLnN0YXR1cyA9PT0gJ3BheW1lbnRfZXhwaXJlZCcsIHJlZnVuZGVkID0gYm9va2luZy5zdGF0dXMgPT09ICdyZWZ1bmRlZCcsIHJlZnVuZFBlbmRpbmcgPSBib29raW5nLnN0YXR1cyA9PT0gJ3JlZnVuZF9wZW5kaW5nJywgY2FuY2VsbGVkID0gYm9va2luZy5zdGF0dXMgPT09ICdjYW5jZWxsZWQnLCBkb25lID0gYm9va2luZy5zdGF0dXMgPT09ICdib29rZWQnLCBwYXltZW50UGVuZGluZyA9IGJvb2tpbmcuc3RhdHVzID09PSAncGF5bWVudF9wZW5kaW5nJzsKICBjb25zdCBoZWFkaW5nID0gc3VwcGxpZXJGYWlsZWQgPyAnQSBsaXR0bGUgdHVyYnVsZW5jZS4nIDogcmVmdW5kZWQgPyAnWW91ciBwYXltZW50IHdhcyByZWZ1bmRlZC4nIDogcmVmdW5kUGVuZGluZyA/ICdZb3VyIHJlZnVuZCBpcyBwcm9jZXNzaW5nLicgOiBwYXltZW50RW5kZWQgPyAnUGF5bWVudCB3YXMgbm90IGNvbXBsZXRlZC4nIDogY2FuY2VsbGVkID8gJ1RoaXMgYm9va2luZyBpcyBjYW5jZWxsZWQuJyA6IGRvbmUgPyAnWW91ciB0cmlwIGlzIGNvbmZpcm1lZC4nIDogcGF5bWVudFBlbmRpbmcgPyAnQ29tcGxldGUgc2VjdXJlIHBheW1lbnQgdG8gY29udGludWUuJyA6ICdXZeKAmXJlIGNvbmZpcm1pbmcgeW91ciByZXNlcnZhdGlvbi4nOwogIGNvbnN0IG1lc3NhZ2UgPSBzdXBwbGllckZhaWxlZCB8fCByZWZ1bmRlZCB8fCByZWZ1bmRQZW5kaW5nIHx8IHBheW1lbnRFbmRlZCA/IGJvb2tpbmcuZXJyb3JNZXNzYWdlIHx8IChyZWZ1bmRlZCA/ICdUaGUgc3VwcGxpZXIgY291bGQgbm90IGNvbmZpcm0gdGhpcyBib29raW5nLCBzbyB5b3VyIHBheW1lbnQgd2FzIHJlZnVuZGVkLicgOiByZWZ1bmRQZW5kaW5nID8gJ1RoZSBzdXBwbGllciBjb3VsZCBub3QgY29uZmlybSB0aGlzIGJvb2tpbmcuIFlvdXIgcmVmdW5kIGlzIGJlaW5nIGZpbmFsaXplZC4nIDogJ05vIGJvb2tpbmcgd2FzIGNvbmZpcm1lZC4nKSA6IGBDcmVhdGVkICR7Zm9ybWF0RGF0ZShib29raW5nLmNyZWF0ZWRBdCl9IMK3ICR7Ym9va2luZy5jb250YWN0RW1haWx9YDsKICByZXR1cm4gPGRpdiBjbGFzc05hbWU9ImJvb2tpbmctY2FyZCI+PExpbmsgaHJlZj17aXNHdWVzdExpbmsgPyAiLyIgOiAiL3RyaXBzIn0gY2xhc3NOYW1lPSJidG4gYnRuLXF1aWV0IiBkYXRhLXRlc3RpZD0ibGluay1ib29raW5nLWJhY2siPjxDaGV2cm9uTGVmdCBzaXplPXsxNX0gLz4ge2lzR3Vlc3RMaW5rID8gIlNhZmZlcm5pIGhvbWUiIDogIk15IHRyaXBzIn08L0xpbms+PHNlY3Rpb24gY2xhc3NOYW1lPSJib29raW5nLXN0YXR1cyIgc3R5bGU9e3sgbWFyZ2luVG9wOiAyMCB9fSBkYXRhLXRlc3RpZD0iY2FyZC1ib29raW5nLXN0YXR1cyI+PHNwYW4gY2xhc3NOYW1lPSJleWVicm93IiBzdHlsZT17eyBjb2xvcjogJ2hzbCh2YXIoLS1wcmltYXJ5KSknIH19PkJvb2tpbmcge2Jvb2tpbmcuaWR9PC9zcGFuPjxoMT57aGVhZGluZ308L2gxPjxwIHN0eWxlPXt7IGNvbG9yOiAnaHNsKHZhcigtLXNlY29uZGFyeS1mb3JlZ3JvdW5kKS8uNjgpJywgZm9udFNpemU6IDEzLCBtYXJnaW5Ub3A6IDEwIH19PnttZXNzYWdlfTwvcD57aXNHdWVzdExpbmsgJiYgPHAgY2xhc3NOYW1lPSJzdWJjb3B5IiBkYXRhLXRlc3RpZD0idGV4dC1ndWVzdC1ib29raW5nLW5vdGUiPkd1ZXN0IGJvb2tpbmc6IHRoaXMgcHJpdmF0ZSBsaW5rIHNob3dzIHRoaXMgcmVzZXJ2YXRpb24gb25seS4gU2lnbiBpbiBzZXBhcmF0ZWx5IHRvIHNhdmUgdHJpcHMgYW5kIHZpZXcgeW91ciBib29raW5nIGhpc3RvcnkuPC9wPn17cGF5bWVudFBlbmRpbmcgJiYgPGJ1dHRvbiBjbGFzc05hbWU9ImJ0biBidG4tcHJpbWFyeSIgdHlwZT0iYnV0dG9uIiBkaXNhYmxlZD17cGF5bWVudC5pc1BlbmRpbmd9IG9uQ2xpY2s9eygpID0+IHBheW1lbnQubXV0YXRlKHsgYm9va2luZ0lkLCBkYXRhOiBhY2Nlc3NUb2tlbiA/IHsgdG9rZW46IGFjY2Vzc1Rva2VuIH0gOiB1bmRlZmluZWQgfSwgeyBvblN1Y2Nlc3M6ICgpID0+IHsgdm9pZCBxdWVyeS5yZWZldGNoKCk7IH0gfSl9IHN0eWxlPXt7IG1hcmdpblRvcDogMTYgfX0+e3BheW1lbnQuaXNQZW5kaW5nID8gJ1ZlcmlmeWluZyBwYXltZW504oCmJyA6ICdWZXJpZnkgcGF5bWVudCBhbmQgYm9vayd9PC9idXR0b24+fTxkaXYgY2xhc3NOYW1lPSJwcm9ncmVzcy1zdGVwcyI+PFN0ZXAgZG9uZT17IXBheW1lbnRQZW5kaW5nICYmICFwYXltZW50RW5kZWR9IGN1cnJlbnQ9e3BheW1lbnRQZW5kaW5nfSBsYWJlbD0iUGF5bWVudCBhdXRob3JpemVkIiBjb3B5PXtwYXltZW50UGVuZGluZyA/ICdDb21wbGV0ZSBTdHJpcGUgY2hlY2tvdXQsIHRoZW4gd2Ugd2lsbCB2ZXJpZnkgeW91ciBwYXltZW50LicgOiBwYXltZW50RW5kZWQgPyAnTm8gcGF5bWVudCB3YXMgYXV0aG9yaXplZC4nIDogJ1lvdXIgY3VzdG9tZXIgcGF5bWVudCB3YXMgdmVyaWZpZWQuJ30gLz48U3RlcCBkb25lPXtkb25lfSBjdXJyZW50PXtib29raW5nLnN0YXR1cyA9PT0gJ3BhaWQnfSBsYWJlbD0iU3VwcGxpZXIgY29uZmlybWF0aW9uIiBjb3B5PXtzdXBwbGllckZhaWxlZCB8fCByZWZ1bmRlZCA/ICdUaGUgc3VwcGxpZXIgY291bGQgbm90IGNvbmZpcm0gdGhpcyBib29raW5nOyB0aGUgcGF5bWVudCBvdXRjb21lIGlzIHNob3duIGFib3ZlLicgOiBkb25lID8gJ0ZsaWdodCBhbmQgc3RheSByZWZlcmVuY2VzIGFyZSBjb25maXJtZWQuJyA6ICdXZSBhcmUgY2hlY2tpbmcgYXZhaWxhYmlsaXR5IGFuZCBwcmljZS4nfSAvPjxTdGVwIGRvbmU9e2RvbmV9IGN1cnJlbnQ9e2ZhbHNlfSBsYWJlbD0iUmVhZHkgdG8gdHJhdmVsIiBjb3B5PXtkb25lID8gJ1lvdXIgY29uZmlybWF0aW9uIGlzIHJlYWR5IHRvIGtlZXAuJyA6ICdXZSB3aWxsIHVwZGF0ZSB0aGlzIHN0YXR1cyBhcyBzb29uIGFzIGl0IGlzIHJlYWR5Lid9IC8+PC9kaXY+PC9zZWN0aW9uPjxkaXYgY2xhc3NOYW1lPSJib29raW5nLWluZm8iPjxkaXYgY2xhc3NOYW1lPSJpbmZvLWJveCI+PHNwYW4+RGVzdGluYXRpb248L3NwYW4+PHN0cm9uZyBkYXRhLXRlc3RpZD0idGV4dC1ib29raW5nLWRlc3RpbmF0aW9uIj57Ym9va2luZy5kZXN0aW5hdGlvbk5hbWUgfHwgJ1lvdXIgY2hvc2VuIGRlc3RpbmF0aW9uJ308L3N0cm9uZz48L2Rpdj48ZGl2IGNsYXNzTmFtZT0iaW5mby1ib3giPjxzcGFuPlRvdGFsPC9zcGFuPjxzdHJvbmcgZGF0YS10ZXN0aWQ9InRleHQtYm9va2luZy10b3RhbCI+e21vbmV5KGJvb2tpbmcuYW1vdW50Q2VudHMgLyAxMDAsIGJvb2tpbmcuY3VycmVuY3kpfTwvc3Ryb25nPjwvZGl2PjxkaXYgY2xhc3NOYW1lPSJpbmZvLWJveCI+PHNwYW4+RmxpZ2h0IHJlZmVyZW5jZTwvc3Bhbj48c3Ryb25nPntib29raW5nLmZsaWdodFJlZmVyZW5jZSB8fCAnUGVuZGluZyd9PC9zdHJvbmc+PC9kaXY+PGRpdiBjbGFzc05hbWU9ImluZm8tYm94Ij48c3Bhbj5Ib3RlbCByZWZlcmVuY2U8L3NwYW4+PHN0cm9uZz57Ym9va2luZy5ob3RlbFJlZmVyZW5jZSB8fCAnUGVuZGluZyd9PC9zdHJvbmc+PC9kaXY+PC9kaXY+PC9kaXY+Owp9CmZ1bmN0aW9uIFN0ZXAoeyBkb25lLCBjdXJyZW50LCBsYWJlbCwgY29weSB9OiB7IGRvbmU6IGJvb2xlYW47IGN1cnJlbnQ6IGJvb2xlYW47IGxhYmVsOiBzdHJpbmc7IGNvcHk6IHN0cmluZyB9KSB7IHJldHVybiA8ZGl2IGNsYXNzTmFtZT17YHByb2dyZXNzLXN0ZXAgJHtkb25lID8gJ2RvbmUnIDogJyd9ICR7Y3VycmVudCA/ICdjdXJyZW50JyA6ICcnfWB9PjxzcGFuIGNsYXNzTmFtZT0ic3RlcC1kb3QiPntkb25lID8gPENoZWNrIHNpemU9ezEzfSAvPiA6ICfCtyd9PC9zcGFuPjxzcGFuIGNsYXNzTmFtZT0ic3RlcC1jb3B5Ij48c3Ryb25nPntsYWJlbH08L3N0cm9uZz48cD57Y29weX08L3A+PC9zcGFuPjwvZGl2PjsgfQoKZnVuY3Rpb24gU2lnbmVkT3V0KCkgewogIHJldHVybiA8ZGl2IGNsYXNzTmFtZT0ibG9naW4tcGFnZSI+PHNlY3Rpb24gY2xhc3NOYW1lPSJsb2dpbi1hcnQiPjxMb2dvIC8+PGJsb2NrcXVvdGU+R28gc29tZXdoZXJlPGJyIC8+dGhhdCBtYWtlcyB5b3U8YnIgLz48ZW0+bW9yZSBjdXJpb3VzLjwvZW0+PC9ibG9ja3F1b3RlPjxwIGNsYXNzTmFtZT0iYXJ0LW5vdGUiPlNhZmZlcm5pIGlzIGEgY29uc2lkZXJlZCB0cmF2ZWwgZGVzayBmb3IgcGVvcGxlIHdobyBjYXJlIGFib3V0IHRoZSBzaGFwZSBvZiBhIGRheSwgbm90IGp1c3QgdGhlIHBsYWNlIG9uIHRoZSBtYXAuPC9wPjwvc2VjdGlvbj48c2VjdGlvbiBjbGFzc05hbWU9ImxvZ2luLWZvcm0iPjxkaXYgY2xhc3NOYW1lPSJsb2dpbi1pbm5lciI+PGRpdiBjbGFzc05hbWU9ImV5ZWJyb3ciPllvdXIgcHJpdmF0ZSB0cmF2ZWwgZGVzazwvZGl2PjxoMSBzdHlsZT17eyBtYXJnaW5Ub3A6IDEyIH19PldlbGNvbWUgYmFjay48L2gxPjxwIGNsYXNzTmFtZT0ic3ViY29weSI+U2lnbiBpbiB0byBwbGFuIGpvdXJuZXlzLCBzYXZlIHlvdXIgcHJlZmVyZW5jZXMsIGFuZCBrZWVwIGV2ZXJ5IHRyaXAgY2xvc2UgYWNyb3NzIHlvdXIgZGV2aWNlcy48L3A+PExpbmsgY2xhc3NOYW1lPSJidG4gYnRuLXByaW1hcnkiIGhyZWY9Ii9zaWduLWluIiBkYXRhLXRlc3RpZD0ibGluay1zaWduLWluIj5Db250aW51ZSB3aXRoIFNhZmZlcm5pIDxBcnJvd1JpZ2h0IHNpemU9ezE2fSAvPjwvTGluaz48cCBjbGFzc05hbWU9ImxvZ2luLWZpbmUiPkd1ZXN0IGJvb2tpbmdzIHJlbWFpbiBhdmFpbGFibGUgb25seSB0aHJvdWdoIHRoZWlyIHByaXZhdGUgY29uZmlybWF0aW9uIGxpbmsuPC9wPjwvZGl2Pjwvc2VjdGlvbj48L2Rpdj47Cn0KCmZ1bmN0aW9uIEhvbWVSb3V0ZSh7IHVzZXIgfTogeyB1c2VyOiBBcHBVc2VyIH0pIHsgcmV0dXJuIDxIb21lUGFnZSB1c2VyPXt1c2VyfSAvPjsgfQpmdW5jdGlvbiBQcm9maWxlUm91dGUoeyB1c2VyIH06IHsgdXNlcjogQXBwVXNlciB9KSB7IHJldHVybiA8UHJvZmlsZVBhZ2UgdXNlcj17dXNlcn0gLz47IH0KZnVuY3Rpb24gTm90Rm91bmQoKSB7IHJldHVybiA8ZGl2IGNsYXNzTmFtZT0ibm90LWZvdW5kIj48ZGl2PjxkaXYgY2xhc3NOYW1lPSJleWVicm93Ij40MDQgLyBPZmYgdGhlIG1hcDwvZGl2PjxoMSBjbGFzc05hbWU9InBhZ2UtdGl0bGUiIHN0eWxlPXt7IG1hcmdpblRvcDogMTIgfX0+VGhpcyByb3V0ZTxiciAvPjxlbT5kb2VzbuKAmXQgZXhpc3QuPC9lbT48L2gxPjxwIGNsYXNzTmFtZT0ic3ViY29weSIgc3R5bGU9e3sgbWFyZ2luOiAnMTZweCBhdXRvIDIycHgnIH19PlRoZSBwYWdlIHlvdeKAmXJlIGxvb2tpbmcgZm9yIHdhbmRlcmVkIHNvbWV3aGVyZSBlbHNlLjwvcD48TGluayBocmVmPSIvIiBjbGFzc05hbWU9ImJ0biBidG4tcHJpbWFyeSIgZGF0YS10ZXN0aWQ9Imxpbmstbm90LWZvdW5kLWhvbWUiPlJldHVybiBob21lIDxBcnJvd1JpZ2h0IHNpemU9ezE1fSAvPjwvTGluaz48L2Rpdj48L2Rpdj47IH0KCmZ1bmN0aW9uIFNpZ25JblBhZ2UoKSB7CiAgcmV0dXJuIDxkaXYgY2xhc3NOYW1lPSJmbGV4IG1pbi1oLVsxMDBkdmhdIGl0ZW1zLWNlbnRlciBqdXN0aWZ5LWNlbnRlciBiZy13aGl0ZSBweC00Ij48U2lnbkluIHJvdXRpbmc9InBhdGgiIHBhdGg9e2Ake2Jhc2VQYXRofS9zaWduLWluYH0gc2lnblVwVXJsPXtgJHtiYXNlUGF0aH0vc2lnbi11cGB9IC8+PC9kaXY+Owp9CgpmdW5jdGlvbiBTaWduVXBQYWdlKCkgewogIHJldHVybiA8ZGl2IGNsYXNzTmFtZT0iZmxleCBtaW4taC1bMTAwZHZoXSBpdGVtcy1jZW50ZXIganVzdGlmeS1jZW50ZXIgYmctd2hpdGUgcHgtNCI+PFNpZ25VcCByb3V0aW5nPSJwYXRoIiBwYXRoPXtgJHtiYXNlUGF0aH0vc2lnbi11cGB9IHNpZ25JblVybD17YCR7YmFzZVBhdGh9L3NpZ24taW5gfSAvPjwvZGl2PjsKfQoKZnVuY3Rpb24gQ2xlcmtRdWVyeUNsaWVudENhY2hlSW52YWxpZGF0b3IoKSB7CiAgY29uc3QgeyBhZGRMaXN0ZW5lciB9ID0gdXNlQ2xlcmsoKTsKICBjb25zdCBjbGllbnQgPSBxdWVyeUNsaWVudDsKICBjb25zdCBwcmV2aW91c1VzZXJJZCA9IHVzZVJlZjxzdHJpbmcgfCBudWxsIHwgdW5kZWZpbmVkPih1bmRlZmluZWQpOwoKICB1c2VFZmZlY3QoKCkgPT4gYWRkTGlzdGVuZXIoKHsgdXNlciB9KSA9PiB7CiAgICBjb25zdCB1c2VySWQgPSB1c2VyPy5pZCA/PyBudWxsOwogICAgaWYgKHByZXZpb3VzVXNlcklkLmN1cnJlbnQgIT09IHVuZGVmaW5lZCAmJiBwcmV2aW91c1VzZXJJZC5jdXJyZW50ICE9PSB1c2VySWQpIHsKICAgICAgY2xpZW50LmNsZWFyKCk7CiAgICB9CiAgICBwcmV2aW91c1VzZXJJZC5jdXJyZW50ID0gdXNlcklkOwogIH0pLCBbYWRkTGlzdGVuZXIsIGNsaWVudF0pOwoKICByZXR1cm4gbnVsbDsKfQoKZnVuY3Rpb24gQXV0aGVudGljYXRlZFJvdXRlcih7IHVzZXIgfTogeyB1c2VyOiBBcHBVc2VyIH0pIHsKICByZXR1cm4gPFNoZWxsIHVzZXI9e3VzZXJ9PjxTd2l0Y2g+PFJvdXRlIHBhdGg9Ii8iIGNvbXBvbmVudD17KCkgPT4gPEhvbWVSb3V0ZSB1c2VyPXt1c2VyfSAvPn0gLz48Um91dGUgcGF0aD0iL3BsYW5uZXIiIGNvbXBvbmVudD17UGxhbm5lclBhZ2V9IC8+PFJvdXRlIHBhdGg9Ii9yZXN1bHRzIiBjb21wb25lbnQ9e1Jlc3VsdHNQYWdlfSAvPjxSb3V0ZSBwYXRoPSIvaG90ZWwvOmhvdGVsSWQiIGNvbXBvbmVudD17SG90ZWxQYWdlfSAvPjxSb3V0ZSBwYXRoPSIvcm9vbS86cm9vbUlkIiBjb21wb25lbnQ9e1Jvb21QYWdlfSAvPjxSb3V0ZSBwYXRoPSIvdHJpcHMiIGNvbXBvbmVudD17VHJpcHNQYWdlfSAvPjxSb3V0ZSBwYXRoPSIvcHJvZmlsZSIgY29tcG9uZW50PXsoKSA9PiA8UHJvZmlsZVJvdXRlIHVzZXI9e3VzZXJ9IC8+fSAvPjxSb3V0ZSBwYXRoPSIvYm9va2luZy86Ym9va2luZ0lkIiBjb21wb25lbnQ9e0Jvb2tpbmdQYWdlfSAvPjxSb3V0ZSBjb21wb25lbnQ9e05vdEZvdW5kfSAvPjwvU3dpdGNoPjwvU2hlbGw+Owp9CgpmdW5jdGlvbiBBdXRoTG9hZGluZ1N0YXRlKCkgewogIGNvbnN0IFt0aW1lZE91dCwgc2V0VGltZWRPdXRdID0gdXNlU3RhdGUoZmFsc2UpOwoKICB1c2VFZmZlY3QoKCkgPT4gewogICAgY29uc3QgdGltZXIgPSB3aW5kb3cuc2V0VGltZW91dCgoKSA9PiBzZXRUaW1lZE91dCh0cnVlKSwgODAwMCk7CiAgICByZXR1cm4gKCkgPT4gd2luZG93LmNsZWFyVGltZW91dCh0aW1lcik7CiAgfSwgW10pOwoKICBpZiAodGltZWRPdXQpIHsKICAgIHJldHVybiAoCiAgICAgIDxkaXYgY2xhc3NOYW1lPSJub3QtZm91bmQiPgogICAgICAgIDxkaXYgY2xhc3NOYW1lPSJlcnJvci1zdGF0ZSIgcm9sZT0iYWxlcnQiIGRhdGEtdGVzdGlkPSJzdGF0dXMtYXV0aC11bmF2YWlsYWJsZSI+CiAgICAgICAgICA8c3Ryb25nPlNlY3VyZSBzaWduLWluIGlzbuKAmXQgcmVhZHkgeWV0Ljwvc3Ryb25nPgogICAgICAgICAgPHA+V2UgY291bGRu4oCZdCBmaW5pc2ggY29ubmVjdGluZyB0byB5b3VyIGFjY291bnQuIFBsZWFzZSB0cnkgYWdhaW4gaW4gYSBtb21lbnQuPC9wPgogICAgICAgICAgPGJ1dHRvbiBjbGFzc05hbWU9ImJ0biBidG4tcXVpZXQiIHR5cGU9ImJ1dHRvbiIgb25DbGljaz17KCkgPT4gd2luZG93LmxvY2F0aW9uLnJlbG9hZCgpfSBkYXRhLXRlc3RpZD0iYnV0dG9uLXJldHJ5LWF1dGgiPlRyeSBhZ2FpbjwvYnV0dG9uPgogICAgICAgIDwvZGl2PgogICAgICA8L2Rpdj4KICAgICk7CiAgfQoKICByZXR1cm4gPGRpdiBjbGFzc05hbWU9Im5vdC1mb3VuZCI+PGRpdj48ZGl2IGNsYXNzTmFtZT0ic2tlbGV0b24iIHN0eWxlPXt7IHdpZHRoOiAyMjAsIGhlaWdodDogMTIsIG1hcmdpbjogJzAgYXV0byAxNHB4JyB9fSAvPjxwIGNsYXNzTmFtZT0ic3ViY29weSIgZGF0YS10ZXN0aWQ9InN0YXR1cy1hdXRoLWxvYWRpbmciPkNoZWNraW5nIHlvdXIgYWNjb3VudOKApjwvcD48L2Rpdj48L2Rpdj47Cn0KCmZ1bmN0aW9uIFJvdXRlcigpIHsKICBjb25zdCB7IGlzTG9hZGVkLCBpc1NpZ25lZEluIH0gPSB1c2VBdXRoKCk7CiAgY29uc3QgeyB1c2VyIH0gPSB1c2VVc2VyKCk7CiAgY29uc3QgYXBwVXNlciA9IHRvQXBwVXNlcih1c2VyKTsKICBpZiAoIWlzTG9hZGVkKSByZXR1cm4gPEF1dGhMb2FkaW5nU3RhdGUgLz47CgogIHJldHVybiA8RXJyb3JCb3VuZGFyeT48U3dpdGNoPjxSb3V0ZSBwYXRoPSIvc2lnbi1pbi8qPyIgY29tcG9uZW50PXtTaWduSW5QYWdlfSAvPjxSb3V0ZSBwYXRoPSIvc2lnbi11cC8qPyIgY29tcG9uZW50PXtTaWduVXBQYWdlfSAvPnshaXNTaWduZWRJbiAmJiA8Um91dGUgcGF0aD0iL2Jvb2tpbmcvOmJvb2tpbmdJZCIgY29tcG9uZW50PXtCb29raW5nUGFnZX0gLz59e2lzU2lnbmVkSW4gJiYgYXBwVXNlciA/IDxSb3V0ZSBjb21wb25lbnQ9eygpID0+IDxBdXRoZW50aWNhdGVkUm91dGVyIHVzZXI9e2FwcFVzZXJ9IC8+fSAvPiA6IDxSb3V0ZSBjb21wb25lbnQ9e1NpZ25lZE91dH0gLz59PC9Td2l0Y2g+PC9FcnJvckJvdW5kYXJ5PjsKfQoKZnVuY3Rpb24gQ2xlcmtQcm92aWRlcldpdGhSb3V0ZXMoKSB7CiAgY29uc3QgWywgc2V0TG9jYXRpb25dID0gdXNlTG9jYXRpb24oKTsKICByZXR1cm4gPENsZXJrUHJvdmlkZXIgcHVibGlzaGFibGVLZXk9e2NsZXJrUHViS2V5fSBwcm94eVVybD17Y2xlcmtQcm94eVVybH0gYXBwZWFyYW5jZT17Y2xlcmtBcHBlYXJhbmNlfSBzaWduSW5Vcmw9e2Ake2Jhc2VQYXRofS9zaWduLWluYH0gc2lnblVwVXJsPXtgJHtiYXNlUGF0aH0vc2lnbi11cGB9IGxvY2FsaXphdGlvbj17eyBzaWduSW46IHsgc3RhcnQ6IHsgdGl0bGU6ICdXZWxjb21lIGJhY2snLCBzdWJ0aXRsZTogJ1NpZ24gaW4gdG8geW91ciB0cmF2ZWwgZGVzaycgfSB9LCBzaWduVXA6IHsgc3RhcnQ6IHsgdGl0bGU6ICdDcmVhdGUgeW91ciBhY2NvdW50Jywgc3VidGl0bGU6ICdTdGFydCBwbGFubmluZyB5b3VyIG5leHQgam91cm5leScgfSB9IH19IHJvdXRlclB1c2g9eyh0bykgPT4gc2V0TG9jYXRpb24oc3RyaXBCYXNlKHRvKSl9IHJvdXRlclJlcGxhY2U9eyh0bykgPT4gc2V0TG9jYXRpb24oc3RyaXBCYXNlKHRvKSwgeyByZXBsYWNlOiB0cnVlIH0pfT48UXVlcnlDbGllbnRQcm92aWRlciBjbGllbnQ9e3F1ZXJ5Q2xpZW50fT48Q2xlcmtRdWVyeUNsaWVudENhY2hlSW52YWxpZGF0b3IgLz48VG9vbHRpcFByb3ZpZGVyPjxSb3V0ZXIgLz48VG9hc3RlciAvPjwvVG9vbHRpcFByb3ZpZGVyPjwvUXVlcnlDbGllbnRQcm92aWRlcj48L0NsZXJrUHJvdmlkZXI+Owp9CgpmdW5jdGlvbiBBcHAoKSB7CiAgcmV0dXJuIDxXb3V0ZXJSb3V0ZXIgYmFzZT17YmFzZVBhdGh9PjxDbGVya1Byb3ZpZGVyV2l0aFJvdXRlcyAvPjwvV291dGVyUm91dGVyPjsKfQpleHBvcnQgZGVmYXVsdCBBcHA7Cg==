function BookingPage() {
  const { bookingId = '' } = useParams<{ bookingId: string }>();
  const [location] = useLocation();
  // Wouter's location value is pathname-only in this app, so read the
  // browser query directly. Stripe's checkout/session credentials live in
  // the return URL query string, not in the route pathname.
  const returnParams = new URLSearchParams(window.location.search);
  const urlToken = returnParams.get('token') || undefined;
  const checkoutSessionId = returnParams.get('session_id') || undefined;
  const accessToken = urlToken
    || localStorage.getItem(`safferni-booking-token:${bookingId}`)
    || sessionStorage.getItem(`safferni-booking-token:${bookingId}`)
    || checkoutSessionId
    || undefined;
  const isGuestLink = Boolean(urlToken || checkoutSessionId);
  const query = useGetBooking(bookingId, accessToken ? { token: accessToken } : undefined, { query: { queryKey: getGetBookingQueryKey(bookingId, accessToken ? { token: accessToken } : undefined), retry: 1 }, request: credentialsRequest });
  const payment = useConfirmBookingPayment({ request: credentialsRequest });
  useEffect(() => {
    if (returnParams.get('checkout') === 'complete' && !payment.isPending && !payment.isSuccess) {
      payment.mutate({ bookingId, data: accessToken ? { token: accessToken } : undefined }, { onSuccess: () => { void query.refetch(); } });
    }
  }, [accessToken, bookingId, location, payment, query]);
  if (query.isLoading) return <LoadingState label="Loading booking status" />;
  if (query.isError) return <ErrorState onRetry={() => query.refetch()} message="We could not retrieve this booking status." />;
  const booking = query.data;
  if (!booking) return <EmptyState title="Booking not found" copy="Check the link in your confirmation email or return to your trips." action={<Link href="/trips" className="btn btn-primary" data-testid="link-booking-not-found-trips">View trips</Link>} />;
  const supplierFailed = booking.status === 'booking_failed' || booking.status === 'refund_failed', paymentEnded = booking.status === 'payment_failed' || booking.status === 'payment_expired', refunded = booking.status === 'refunded', refundPending = booking.status === 'refund_pending', cancelled = booking.status === 'cancelled', done = booking.status === 'booked', paymentPending = booking.status === 'payment_pending';
  const heading = supplierFailed ? 'A little turbulence.' : refunded ? 'Your payment was refunded.' : refundPending ? 'Your refund is processing.' : paymentEnded ? 'Payment was not completed.' : cancelled ? 'This booking is cancelled.' : done ? 'Your trip is confirmed.' : paymentPending ? 'Complete secure payment to continue.' : 'We’re confirming your reservation.';
  const message = supplierFailed || refunded || refundPending || paymentEnded ? booking.errorMessage || (refunded ? 'The supplier could not confirm this booking, so your payment was refunded.' : refundPending ? 'The supplier could not confirm this booking. Your refund is being finalized.' : 'No booking was confirmed.') : `Created ${formatDate(booking.createdAt)} · ${booking.contactEmail}`;
  return <div className="booking-card"><Link href={isGuestLink ? "/" : "/trips"} className="btn btn-quiet" data-testid="link-booking-back"><ChevronLeft size={15} /> {isGuestLink ? "Safferni home" : "My trips"}</Link><section className="booking-status" style={{ marginTop: 20 }} data-testid="card-booking-status"><span className="eyebrow" style={{ color: 'hsl(var(--primary))' }}>Booking {booking.id}</span><h1>{heading}</h1><p style={{ color: 'hsl(var(--secondary-foreground)/.68)', fontSize: 13, marginTop: 10 }}>{message}</p>{isGuestLink && <p className="subcopy" data-testid="text-guest-booking-note">Guest booking: this private link shows this reservation only. Sign in separately to save trips and view your booking history.</p>}{paymentPending && <button className="btn btn-primary" type="button" disabled={payment.isPending} onClick={() => payment.mutate({ bookingId, data: accessToken ? { token: accessToken } : undefined }, { onSuccess: () => { void query.refetch(); } })} style={{ marginTop: 16 }}>{payment.isPending ? 'Verifying payment…' : 'Verify payment and book'}</button>}<div className="progress-steps"><Step done={!paymentPending && !paymentEnded} current={paymentPending} label="Payment authorized" copy={paymentPending ? 'Complete Stripe checkout, then we will verify your payment.' : paymentEnded ? 'No payment was authorized.' : 'Your customer payment was verified.'} /><Step done={done} current={booking.status === 'paid'} label="Supplier confirmation" copy={supplierFailed || refunded ? 'The supplier could not confirm this booking; the payment outcome is shown above.' : done ? 'Flight and stay references are confirmed.' : 'We are checking availability and price.'} /><Step done={done} current={false} label="Ready to travel" copy={done ? 'Your confirmation is ready to keep.' : 'We will update this status as soon as it is ready.'} /></div></section><div className="booking-info"><div className="info-box"><span>Destination</span><strong data-testid="text-booking-destination">{booking.destinationName || 'Your chosen destination'}</strong></div><div className="info-box"><span>Total</span><strong data-testid="text-booking-total">{money(booking.amountCents / 100, booking.currency)}</strong></div><div className="info-box"><span>Flight reference</span><strong>{booking.flightReference || 'Pending'}</strong></div><div className="info-box"><span>Hotel reference</span><strong>{booking.hotelReference || 'Pending'}</strong></div></div></div>;
}
function Step({ done, current, label, copy }: { done: boolean; current: boolean; label: string; copy: string }) { return <div className={`progress-step ${done ? 'done' : ''} ${current ? 'current' : ''}`}><span className="step-dot">{done ? <Check size={13} /> : '·'}</span><span className="step-copy"><strong>{label}</strong><p>{copy}</p></span></div>; }

function SignedOut() {
  return <div className="login-page"><section className="login-art"><Logo /><blockquote>Go somewhere<br />that makes you<br /><em>more curious.</em></blockquote><p className="art-note">Safferni is a considered travel desk for people who care about the shape of a day, not just the place on the map.</p></section><section className="login-form"><div className="login-inner"><div className="eyebrow">Your private travel desk</div><h1 style={{ marginTop: 12 }}>Welcome back.</h1><p className="subcopy">Sign in to plan journeys, save your preferences, and keep every trip close across your devices.</p><Link className="btn btn-primary" href="/sign-in" data-testid="link-sign-in">Continue with Safferni <ArrowRight size={16} /></Link><p className="login-fine">Guest bookings remain available only through their private confirmation link.</p></div></section></div>;
}

function HomeRoute({ user }: { user: AppUser }) { return <HomePage user={user} />; }
function ProfileRoute({ user }: { user: AppUser }) { return <ProfilePage user={user} />; }
function NotFound() { return <div className="not-found"><div><div className="eyebrow">404 / Off the map</div><h1 className="page-title" style={{ marginTop: 12 }}>This route<br /><em>doesn’t exist.</em></h1><p className="subcopy" style={{ margin: '16px auto 22px' }}>The page you’re looking for wandered somewhere else.</p><Link href="/" className="btn btn-primary" data-testid="link-not-found-home">Return home <ArrowRight size={15} /></Link></div></div>; }

function SignInPage() {
  return <div className="flex min-h-[100dvh] items-center justify-center bg-white px-4"><SignIn routing="path" path={`${basePath}/sign-in`} signUpUrl={`${basePath}/sign-up`} /></div>;
}

function SignUpPage() {
  return <div className="flex min-h-[100dvh] items-center justify-center bg-white px-4"><SignUp routing="path" path={`${basePath}/sign-up`} signInUrl={`${basePath}/sign-in`} /></div>;
}

function ClerkQueryClientCacheInvalidator() {
  const { addListener } = useClerk();
  const client = queryClient;
  const previousUserId = useRef<string | null | undefined>(undefined);

  useEffect(() => addListener(({ user }) => {
    const userId = user?.id ?? null;
    if (previousUserId.current !== undefined && previousUserId.current !== userId) {
      client.clear();
    }
    previousUserId.current = userId;
  }), [addListener, client]);

  return null;
}

function AuthenticatedRouter({ user }: { user: AppUser }) {
  return <Shell user={user}><Switch><Route path="/" component={() => <HomeRoute user={user} />} /><Route path="/planner" component={PlannerPage} /><Route path="/results" component={ResultsPage} /><Route path="/hotel/:hotelId" component={HotelPage} /><Route path="/room/:roomId" component={RoomPage} /><Route path="/trips" component={TripsPage} /><Route path="/profile" component={() => <ProfileRoute user={user} />} /><Route path="/booking/:bookingId" component={BookingPage} /><Route component={NotFound} /></Switch></Shell>;
}

function AuthLoadingState() {
  const [timedOut, setTimedOut] = useState(false);

  useEffect(() => {
    const timer = window.setTimeout(() => setTimedOut(true), 8000);
    return () => window.clearTimeout(timer);
  }, []);

  if (timedOut) {
    return (
      <div className="not-found">
        <div className="error-state" role="alert" data-testid="status-auth-unavailable">
          <strong>Secure sign-in isn’t ready yet.</strong>
          <p>We couldn’t finish connecting to your account. Please try again in a moment.</p>
          <button className="btn btn-quiet" type="button" onClick={() => window.location.reload()} data-testid="button-retry-auth">Try again</button>
        </div>
      </div>
    );
  }

  return <div className="not-found"><div><div className="skeleton" style={{ width: 220, height: 12, margin: '0 auto 14px' }} /><p className="subcopy" data-testid="status-auth-loading">Checking your account…</p></div></div>;
}

function Router() {
  const { isLoaded, isSignedIn } = useAuth();
  const { user } = useUser();
  const appUser = toAppUser(user);
  if (!isLoaded) return <AuthLoadingState />;

  return <ErrorBoundary><Switch><Route path="/sign-in/*?" component={SignInPage} /><Route path="/sign-up/*?" component={SignUpPage} />{!isSignedIn && <Route path="/booking/:bookingId" component={BookingPage} />}{isSignedIn && appUser ? <Route component={() => <AuthenticatedRouter user={appUser} />} /> : <Route component={SignedOut} />}</Switch></ErrorBoundary>;
}

function ClerkProviderWithRoutes() {
  const [, setLocation] = useLocation();
  return <ClerkProvider publishableKey={clerkPubKey} proxyUrl={clerkProxyUrl} appearance={clerkAppearance} signInUrl={`${basePath}/sign-in`} signUpUrl={`${basePath}/sign-up`} localization={{ signIn: { start: { title: 'Welcome back', subtitle: 'Sign in to your travel desk' } }, signUp: { start: { title: 'Create your account', subtitle: 'Start planning your next journey' } } }} routerPush={(to) => setLocation(stripBase(to))} routerReplace={(to) => setLocation(stripBase(to), { replace: true })}><QueryClientProvider client={queryClient}><ClerkQueryClientCacheInvalidator /><TooltipProvider><Router /><Toaster /></TooltipProvider></QueryClientProvider></ClerkProvider>;
}

function App() {
  return <WouterRouter base={basePath}><ClerkProviderWithRoutes /></WouterRouter>;
}
export default App;
