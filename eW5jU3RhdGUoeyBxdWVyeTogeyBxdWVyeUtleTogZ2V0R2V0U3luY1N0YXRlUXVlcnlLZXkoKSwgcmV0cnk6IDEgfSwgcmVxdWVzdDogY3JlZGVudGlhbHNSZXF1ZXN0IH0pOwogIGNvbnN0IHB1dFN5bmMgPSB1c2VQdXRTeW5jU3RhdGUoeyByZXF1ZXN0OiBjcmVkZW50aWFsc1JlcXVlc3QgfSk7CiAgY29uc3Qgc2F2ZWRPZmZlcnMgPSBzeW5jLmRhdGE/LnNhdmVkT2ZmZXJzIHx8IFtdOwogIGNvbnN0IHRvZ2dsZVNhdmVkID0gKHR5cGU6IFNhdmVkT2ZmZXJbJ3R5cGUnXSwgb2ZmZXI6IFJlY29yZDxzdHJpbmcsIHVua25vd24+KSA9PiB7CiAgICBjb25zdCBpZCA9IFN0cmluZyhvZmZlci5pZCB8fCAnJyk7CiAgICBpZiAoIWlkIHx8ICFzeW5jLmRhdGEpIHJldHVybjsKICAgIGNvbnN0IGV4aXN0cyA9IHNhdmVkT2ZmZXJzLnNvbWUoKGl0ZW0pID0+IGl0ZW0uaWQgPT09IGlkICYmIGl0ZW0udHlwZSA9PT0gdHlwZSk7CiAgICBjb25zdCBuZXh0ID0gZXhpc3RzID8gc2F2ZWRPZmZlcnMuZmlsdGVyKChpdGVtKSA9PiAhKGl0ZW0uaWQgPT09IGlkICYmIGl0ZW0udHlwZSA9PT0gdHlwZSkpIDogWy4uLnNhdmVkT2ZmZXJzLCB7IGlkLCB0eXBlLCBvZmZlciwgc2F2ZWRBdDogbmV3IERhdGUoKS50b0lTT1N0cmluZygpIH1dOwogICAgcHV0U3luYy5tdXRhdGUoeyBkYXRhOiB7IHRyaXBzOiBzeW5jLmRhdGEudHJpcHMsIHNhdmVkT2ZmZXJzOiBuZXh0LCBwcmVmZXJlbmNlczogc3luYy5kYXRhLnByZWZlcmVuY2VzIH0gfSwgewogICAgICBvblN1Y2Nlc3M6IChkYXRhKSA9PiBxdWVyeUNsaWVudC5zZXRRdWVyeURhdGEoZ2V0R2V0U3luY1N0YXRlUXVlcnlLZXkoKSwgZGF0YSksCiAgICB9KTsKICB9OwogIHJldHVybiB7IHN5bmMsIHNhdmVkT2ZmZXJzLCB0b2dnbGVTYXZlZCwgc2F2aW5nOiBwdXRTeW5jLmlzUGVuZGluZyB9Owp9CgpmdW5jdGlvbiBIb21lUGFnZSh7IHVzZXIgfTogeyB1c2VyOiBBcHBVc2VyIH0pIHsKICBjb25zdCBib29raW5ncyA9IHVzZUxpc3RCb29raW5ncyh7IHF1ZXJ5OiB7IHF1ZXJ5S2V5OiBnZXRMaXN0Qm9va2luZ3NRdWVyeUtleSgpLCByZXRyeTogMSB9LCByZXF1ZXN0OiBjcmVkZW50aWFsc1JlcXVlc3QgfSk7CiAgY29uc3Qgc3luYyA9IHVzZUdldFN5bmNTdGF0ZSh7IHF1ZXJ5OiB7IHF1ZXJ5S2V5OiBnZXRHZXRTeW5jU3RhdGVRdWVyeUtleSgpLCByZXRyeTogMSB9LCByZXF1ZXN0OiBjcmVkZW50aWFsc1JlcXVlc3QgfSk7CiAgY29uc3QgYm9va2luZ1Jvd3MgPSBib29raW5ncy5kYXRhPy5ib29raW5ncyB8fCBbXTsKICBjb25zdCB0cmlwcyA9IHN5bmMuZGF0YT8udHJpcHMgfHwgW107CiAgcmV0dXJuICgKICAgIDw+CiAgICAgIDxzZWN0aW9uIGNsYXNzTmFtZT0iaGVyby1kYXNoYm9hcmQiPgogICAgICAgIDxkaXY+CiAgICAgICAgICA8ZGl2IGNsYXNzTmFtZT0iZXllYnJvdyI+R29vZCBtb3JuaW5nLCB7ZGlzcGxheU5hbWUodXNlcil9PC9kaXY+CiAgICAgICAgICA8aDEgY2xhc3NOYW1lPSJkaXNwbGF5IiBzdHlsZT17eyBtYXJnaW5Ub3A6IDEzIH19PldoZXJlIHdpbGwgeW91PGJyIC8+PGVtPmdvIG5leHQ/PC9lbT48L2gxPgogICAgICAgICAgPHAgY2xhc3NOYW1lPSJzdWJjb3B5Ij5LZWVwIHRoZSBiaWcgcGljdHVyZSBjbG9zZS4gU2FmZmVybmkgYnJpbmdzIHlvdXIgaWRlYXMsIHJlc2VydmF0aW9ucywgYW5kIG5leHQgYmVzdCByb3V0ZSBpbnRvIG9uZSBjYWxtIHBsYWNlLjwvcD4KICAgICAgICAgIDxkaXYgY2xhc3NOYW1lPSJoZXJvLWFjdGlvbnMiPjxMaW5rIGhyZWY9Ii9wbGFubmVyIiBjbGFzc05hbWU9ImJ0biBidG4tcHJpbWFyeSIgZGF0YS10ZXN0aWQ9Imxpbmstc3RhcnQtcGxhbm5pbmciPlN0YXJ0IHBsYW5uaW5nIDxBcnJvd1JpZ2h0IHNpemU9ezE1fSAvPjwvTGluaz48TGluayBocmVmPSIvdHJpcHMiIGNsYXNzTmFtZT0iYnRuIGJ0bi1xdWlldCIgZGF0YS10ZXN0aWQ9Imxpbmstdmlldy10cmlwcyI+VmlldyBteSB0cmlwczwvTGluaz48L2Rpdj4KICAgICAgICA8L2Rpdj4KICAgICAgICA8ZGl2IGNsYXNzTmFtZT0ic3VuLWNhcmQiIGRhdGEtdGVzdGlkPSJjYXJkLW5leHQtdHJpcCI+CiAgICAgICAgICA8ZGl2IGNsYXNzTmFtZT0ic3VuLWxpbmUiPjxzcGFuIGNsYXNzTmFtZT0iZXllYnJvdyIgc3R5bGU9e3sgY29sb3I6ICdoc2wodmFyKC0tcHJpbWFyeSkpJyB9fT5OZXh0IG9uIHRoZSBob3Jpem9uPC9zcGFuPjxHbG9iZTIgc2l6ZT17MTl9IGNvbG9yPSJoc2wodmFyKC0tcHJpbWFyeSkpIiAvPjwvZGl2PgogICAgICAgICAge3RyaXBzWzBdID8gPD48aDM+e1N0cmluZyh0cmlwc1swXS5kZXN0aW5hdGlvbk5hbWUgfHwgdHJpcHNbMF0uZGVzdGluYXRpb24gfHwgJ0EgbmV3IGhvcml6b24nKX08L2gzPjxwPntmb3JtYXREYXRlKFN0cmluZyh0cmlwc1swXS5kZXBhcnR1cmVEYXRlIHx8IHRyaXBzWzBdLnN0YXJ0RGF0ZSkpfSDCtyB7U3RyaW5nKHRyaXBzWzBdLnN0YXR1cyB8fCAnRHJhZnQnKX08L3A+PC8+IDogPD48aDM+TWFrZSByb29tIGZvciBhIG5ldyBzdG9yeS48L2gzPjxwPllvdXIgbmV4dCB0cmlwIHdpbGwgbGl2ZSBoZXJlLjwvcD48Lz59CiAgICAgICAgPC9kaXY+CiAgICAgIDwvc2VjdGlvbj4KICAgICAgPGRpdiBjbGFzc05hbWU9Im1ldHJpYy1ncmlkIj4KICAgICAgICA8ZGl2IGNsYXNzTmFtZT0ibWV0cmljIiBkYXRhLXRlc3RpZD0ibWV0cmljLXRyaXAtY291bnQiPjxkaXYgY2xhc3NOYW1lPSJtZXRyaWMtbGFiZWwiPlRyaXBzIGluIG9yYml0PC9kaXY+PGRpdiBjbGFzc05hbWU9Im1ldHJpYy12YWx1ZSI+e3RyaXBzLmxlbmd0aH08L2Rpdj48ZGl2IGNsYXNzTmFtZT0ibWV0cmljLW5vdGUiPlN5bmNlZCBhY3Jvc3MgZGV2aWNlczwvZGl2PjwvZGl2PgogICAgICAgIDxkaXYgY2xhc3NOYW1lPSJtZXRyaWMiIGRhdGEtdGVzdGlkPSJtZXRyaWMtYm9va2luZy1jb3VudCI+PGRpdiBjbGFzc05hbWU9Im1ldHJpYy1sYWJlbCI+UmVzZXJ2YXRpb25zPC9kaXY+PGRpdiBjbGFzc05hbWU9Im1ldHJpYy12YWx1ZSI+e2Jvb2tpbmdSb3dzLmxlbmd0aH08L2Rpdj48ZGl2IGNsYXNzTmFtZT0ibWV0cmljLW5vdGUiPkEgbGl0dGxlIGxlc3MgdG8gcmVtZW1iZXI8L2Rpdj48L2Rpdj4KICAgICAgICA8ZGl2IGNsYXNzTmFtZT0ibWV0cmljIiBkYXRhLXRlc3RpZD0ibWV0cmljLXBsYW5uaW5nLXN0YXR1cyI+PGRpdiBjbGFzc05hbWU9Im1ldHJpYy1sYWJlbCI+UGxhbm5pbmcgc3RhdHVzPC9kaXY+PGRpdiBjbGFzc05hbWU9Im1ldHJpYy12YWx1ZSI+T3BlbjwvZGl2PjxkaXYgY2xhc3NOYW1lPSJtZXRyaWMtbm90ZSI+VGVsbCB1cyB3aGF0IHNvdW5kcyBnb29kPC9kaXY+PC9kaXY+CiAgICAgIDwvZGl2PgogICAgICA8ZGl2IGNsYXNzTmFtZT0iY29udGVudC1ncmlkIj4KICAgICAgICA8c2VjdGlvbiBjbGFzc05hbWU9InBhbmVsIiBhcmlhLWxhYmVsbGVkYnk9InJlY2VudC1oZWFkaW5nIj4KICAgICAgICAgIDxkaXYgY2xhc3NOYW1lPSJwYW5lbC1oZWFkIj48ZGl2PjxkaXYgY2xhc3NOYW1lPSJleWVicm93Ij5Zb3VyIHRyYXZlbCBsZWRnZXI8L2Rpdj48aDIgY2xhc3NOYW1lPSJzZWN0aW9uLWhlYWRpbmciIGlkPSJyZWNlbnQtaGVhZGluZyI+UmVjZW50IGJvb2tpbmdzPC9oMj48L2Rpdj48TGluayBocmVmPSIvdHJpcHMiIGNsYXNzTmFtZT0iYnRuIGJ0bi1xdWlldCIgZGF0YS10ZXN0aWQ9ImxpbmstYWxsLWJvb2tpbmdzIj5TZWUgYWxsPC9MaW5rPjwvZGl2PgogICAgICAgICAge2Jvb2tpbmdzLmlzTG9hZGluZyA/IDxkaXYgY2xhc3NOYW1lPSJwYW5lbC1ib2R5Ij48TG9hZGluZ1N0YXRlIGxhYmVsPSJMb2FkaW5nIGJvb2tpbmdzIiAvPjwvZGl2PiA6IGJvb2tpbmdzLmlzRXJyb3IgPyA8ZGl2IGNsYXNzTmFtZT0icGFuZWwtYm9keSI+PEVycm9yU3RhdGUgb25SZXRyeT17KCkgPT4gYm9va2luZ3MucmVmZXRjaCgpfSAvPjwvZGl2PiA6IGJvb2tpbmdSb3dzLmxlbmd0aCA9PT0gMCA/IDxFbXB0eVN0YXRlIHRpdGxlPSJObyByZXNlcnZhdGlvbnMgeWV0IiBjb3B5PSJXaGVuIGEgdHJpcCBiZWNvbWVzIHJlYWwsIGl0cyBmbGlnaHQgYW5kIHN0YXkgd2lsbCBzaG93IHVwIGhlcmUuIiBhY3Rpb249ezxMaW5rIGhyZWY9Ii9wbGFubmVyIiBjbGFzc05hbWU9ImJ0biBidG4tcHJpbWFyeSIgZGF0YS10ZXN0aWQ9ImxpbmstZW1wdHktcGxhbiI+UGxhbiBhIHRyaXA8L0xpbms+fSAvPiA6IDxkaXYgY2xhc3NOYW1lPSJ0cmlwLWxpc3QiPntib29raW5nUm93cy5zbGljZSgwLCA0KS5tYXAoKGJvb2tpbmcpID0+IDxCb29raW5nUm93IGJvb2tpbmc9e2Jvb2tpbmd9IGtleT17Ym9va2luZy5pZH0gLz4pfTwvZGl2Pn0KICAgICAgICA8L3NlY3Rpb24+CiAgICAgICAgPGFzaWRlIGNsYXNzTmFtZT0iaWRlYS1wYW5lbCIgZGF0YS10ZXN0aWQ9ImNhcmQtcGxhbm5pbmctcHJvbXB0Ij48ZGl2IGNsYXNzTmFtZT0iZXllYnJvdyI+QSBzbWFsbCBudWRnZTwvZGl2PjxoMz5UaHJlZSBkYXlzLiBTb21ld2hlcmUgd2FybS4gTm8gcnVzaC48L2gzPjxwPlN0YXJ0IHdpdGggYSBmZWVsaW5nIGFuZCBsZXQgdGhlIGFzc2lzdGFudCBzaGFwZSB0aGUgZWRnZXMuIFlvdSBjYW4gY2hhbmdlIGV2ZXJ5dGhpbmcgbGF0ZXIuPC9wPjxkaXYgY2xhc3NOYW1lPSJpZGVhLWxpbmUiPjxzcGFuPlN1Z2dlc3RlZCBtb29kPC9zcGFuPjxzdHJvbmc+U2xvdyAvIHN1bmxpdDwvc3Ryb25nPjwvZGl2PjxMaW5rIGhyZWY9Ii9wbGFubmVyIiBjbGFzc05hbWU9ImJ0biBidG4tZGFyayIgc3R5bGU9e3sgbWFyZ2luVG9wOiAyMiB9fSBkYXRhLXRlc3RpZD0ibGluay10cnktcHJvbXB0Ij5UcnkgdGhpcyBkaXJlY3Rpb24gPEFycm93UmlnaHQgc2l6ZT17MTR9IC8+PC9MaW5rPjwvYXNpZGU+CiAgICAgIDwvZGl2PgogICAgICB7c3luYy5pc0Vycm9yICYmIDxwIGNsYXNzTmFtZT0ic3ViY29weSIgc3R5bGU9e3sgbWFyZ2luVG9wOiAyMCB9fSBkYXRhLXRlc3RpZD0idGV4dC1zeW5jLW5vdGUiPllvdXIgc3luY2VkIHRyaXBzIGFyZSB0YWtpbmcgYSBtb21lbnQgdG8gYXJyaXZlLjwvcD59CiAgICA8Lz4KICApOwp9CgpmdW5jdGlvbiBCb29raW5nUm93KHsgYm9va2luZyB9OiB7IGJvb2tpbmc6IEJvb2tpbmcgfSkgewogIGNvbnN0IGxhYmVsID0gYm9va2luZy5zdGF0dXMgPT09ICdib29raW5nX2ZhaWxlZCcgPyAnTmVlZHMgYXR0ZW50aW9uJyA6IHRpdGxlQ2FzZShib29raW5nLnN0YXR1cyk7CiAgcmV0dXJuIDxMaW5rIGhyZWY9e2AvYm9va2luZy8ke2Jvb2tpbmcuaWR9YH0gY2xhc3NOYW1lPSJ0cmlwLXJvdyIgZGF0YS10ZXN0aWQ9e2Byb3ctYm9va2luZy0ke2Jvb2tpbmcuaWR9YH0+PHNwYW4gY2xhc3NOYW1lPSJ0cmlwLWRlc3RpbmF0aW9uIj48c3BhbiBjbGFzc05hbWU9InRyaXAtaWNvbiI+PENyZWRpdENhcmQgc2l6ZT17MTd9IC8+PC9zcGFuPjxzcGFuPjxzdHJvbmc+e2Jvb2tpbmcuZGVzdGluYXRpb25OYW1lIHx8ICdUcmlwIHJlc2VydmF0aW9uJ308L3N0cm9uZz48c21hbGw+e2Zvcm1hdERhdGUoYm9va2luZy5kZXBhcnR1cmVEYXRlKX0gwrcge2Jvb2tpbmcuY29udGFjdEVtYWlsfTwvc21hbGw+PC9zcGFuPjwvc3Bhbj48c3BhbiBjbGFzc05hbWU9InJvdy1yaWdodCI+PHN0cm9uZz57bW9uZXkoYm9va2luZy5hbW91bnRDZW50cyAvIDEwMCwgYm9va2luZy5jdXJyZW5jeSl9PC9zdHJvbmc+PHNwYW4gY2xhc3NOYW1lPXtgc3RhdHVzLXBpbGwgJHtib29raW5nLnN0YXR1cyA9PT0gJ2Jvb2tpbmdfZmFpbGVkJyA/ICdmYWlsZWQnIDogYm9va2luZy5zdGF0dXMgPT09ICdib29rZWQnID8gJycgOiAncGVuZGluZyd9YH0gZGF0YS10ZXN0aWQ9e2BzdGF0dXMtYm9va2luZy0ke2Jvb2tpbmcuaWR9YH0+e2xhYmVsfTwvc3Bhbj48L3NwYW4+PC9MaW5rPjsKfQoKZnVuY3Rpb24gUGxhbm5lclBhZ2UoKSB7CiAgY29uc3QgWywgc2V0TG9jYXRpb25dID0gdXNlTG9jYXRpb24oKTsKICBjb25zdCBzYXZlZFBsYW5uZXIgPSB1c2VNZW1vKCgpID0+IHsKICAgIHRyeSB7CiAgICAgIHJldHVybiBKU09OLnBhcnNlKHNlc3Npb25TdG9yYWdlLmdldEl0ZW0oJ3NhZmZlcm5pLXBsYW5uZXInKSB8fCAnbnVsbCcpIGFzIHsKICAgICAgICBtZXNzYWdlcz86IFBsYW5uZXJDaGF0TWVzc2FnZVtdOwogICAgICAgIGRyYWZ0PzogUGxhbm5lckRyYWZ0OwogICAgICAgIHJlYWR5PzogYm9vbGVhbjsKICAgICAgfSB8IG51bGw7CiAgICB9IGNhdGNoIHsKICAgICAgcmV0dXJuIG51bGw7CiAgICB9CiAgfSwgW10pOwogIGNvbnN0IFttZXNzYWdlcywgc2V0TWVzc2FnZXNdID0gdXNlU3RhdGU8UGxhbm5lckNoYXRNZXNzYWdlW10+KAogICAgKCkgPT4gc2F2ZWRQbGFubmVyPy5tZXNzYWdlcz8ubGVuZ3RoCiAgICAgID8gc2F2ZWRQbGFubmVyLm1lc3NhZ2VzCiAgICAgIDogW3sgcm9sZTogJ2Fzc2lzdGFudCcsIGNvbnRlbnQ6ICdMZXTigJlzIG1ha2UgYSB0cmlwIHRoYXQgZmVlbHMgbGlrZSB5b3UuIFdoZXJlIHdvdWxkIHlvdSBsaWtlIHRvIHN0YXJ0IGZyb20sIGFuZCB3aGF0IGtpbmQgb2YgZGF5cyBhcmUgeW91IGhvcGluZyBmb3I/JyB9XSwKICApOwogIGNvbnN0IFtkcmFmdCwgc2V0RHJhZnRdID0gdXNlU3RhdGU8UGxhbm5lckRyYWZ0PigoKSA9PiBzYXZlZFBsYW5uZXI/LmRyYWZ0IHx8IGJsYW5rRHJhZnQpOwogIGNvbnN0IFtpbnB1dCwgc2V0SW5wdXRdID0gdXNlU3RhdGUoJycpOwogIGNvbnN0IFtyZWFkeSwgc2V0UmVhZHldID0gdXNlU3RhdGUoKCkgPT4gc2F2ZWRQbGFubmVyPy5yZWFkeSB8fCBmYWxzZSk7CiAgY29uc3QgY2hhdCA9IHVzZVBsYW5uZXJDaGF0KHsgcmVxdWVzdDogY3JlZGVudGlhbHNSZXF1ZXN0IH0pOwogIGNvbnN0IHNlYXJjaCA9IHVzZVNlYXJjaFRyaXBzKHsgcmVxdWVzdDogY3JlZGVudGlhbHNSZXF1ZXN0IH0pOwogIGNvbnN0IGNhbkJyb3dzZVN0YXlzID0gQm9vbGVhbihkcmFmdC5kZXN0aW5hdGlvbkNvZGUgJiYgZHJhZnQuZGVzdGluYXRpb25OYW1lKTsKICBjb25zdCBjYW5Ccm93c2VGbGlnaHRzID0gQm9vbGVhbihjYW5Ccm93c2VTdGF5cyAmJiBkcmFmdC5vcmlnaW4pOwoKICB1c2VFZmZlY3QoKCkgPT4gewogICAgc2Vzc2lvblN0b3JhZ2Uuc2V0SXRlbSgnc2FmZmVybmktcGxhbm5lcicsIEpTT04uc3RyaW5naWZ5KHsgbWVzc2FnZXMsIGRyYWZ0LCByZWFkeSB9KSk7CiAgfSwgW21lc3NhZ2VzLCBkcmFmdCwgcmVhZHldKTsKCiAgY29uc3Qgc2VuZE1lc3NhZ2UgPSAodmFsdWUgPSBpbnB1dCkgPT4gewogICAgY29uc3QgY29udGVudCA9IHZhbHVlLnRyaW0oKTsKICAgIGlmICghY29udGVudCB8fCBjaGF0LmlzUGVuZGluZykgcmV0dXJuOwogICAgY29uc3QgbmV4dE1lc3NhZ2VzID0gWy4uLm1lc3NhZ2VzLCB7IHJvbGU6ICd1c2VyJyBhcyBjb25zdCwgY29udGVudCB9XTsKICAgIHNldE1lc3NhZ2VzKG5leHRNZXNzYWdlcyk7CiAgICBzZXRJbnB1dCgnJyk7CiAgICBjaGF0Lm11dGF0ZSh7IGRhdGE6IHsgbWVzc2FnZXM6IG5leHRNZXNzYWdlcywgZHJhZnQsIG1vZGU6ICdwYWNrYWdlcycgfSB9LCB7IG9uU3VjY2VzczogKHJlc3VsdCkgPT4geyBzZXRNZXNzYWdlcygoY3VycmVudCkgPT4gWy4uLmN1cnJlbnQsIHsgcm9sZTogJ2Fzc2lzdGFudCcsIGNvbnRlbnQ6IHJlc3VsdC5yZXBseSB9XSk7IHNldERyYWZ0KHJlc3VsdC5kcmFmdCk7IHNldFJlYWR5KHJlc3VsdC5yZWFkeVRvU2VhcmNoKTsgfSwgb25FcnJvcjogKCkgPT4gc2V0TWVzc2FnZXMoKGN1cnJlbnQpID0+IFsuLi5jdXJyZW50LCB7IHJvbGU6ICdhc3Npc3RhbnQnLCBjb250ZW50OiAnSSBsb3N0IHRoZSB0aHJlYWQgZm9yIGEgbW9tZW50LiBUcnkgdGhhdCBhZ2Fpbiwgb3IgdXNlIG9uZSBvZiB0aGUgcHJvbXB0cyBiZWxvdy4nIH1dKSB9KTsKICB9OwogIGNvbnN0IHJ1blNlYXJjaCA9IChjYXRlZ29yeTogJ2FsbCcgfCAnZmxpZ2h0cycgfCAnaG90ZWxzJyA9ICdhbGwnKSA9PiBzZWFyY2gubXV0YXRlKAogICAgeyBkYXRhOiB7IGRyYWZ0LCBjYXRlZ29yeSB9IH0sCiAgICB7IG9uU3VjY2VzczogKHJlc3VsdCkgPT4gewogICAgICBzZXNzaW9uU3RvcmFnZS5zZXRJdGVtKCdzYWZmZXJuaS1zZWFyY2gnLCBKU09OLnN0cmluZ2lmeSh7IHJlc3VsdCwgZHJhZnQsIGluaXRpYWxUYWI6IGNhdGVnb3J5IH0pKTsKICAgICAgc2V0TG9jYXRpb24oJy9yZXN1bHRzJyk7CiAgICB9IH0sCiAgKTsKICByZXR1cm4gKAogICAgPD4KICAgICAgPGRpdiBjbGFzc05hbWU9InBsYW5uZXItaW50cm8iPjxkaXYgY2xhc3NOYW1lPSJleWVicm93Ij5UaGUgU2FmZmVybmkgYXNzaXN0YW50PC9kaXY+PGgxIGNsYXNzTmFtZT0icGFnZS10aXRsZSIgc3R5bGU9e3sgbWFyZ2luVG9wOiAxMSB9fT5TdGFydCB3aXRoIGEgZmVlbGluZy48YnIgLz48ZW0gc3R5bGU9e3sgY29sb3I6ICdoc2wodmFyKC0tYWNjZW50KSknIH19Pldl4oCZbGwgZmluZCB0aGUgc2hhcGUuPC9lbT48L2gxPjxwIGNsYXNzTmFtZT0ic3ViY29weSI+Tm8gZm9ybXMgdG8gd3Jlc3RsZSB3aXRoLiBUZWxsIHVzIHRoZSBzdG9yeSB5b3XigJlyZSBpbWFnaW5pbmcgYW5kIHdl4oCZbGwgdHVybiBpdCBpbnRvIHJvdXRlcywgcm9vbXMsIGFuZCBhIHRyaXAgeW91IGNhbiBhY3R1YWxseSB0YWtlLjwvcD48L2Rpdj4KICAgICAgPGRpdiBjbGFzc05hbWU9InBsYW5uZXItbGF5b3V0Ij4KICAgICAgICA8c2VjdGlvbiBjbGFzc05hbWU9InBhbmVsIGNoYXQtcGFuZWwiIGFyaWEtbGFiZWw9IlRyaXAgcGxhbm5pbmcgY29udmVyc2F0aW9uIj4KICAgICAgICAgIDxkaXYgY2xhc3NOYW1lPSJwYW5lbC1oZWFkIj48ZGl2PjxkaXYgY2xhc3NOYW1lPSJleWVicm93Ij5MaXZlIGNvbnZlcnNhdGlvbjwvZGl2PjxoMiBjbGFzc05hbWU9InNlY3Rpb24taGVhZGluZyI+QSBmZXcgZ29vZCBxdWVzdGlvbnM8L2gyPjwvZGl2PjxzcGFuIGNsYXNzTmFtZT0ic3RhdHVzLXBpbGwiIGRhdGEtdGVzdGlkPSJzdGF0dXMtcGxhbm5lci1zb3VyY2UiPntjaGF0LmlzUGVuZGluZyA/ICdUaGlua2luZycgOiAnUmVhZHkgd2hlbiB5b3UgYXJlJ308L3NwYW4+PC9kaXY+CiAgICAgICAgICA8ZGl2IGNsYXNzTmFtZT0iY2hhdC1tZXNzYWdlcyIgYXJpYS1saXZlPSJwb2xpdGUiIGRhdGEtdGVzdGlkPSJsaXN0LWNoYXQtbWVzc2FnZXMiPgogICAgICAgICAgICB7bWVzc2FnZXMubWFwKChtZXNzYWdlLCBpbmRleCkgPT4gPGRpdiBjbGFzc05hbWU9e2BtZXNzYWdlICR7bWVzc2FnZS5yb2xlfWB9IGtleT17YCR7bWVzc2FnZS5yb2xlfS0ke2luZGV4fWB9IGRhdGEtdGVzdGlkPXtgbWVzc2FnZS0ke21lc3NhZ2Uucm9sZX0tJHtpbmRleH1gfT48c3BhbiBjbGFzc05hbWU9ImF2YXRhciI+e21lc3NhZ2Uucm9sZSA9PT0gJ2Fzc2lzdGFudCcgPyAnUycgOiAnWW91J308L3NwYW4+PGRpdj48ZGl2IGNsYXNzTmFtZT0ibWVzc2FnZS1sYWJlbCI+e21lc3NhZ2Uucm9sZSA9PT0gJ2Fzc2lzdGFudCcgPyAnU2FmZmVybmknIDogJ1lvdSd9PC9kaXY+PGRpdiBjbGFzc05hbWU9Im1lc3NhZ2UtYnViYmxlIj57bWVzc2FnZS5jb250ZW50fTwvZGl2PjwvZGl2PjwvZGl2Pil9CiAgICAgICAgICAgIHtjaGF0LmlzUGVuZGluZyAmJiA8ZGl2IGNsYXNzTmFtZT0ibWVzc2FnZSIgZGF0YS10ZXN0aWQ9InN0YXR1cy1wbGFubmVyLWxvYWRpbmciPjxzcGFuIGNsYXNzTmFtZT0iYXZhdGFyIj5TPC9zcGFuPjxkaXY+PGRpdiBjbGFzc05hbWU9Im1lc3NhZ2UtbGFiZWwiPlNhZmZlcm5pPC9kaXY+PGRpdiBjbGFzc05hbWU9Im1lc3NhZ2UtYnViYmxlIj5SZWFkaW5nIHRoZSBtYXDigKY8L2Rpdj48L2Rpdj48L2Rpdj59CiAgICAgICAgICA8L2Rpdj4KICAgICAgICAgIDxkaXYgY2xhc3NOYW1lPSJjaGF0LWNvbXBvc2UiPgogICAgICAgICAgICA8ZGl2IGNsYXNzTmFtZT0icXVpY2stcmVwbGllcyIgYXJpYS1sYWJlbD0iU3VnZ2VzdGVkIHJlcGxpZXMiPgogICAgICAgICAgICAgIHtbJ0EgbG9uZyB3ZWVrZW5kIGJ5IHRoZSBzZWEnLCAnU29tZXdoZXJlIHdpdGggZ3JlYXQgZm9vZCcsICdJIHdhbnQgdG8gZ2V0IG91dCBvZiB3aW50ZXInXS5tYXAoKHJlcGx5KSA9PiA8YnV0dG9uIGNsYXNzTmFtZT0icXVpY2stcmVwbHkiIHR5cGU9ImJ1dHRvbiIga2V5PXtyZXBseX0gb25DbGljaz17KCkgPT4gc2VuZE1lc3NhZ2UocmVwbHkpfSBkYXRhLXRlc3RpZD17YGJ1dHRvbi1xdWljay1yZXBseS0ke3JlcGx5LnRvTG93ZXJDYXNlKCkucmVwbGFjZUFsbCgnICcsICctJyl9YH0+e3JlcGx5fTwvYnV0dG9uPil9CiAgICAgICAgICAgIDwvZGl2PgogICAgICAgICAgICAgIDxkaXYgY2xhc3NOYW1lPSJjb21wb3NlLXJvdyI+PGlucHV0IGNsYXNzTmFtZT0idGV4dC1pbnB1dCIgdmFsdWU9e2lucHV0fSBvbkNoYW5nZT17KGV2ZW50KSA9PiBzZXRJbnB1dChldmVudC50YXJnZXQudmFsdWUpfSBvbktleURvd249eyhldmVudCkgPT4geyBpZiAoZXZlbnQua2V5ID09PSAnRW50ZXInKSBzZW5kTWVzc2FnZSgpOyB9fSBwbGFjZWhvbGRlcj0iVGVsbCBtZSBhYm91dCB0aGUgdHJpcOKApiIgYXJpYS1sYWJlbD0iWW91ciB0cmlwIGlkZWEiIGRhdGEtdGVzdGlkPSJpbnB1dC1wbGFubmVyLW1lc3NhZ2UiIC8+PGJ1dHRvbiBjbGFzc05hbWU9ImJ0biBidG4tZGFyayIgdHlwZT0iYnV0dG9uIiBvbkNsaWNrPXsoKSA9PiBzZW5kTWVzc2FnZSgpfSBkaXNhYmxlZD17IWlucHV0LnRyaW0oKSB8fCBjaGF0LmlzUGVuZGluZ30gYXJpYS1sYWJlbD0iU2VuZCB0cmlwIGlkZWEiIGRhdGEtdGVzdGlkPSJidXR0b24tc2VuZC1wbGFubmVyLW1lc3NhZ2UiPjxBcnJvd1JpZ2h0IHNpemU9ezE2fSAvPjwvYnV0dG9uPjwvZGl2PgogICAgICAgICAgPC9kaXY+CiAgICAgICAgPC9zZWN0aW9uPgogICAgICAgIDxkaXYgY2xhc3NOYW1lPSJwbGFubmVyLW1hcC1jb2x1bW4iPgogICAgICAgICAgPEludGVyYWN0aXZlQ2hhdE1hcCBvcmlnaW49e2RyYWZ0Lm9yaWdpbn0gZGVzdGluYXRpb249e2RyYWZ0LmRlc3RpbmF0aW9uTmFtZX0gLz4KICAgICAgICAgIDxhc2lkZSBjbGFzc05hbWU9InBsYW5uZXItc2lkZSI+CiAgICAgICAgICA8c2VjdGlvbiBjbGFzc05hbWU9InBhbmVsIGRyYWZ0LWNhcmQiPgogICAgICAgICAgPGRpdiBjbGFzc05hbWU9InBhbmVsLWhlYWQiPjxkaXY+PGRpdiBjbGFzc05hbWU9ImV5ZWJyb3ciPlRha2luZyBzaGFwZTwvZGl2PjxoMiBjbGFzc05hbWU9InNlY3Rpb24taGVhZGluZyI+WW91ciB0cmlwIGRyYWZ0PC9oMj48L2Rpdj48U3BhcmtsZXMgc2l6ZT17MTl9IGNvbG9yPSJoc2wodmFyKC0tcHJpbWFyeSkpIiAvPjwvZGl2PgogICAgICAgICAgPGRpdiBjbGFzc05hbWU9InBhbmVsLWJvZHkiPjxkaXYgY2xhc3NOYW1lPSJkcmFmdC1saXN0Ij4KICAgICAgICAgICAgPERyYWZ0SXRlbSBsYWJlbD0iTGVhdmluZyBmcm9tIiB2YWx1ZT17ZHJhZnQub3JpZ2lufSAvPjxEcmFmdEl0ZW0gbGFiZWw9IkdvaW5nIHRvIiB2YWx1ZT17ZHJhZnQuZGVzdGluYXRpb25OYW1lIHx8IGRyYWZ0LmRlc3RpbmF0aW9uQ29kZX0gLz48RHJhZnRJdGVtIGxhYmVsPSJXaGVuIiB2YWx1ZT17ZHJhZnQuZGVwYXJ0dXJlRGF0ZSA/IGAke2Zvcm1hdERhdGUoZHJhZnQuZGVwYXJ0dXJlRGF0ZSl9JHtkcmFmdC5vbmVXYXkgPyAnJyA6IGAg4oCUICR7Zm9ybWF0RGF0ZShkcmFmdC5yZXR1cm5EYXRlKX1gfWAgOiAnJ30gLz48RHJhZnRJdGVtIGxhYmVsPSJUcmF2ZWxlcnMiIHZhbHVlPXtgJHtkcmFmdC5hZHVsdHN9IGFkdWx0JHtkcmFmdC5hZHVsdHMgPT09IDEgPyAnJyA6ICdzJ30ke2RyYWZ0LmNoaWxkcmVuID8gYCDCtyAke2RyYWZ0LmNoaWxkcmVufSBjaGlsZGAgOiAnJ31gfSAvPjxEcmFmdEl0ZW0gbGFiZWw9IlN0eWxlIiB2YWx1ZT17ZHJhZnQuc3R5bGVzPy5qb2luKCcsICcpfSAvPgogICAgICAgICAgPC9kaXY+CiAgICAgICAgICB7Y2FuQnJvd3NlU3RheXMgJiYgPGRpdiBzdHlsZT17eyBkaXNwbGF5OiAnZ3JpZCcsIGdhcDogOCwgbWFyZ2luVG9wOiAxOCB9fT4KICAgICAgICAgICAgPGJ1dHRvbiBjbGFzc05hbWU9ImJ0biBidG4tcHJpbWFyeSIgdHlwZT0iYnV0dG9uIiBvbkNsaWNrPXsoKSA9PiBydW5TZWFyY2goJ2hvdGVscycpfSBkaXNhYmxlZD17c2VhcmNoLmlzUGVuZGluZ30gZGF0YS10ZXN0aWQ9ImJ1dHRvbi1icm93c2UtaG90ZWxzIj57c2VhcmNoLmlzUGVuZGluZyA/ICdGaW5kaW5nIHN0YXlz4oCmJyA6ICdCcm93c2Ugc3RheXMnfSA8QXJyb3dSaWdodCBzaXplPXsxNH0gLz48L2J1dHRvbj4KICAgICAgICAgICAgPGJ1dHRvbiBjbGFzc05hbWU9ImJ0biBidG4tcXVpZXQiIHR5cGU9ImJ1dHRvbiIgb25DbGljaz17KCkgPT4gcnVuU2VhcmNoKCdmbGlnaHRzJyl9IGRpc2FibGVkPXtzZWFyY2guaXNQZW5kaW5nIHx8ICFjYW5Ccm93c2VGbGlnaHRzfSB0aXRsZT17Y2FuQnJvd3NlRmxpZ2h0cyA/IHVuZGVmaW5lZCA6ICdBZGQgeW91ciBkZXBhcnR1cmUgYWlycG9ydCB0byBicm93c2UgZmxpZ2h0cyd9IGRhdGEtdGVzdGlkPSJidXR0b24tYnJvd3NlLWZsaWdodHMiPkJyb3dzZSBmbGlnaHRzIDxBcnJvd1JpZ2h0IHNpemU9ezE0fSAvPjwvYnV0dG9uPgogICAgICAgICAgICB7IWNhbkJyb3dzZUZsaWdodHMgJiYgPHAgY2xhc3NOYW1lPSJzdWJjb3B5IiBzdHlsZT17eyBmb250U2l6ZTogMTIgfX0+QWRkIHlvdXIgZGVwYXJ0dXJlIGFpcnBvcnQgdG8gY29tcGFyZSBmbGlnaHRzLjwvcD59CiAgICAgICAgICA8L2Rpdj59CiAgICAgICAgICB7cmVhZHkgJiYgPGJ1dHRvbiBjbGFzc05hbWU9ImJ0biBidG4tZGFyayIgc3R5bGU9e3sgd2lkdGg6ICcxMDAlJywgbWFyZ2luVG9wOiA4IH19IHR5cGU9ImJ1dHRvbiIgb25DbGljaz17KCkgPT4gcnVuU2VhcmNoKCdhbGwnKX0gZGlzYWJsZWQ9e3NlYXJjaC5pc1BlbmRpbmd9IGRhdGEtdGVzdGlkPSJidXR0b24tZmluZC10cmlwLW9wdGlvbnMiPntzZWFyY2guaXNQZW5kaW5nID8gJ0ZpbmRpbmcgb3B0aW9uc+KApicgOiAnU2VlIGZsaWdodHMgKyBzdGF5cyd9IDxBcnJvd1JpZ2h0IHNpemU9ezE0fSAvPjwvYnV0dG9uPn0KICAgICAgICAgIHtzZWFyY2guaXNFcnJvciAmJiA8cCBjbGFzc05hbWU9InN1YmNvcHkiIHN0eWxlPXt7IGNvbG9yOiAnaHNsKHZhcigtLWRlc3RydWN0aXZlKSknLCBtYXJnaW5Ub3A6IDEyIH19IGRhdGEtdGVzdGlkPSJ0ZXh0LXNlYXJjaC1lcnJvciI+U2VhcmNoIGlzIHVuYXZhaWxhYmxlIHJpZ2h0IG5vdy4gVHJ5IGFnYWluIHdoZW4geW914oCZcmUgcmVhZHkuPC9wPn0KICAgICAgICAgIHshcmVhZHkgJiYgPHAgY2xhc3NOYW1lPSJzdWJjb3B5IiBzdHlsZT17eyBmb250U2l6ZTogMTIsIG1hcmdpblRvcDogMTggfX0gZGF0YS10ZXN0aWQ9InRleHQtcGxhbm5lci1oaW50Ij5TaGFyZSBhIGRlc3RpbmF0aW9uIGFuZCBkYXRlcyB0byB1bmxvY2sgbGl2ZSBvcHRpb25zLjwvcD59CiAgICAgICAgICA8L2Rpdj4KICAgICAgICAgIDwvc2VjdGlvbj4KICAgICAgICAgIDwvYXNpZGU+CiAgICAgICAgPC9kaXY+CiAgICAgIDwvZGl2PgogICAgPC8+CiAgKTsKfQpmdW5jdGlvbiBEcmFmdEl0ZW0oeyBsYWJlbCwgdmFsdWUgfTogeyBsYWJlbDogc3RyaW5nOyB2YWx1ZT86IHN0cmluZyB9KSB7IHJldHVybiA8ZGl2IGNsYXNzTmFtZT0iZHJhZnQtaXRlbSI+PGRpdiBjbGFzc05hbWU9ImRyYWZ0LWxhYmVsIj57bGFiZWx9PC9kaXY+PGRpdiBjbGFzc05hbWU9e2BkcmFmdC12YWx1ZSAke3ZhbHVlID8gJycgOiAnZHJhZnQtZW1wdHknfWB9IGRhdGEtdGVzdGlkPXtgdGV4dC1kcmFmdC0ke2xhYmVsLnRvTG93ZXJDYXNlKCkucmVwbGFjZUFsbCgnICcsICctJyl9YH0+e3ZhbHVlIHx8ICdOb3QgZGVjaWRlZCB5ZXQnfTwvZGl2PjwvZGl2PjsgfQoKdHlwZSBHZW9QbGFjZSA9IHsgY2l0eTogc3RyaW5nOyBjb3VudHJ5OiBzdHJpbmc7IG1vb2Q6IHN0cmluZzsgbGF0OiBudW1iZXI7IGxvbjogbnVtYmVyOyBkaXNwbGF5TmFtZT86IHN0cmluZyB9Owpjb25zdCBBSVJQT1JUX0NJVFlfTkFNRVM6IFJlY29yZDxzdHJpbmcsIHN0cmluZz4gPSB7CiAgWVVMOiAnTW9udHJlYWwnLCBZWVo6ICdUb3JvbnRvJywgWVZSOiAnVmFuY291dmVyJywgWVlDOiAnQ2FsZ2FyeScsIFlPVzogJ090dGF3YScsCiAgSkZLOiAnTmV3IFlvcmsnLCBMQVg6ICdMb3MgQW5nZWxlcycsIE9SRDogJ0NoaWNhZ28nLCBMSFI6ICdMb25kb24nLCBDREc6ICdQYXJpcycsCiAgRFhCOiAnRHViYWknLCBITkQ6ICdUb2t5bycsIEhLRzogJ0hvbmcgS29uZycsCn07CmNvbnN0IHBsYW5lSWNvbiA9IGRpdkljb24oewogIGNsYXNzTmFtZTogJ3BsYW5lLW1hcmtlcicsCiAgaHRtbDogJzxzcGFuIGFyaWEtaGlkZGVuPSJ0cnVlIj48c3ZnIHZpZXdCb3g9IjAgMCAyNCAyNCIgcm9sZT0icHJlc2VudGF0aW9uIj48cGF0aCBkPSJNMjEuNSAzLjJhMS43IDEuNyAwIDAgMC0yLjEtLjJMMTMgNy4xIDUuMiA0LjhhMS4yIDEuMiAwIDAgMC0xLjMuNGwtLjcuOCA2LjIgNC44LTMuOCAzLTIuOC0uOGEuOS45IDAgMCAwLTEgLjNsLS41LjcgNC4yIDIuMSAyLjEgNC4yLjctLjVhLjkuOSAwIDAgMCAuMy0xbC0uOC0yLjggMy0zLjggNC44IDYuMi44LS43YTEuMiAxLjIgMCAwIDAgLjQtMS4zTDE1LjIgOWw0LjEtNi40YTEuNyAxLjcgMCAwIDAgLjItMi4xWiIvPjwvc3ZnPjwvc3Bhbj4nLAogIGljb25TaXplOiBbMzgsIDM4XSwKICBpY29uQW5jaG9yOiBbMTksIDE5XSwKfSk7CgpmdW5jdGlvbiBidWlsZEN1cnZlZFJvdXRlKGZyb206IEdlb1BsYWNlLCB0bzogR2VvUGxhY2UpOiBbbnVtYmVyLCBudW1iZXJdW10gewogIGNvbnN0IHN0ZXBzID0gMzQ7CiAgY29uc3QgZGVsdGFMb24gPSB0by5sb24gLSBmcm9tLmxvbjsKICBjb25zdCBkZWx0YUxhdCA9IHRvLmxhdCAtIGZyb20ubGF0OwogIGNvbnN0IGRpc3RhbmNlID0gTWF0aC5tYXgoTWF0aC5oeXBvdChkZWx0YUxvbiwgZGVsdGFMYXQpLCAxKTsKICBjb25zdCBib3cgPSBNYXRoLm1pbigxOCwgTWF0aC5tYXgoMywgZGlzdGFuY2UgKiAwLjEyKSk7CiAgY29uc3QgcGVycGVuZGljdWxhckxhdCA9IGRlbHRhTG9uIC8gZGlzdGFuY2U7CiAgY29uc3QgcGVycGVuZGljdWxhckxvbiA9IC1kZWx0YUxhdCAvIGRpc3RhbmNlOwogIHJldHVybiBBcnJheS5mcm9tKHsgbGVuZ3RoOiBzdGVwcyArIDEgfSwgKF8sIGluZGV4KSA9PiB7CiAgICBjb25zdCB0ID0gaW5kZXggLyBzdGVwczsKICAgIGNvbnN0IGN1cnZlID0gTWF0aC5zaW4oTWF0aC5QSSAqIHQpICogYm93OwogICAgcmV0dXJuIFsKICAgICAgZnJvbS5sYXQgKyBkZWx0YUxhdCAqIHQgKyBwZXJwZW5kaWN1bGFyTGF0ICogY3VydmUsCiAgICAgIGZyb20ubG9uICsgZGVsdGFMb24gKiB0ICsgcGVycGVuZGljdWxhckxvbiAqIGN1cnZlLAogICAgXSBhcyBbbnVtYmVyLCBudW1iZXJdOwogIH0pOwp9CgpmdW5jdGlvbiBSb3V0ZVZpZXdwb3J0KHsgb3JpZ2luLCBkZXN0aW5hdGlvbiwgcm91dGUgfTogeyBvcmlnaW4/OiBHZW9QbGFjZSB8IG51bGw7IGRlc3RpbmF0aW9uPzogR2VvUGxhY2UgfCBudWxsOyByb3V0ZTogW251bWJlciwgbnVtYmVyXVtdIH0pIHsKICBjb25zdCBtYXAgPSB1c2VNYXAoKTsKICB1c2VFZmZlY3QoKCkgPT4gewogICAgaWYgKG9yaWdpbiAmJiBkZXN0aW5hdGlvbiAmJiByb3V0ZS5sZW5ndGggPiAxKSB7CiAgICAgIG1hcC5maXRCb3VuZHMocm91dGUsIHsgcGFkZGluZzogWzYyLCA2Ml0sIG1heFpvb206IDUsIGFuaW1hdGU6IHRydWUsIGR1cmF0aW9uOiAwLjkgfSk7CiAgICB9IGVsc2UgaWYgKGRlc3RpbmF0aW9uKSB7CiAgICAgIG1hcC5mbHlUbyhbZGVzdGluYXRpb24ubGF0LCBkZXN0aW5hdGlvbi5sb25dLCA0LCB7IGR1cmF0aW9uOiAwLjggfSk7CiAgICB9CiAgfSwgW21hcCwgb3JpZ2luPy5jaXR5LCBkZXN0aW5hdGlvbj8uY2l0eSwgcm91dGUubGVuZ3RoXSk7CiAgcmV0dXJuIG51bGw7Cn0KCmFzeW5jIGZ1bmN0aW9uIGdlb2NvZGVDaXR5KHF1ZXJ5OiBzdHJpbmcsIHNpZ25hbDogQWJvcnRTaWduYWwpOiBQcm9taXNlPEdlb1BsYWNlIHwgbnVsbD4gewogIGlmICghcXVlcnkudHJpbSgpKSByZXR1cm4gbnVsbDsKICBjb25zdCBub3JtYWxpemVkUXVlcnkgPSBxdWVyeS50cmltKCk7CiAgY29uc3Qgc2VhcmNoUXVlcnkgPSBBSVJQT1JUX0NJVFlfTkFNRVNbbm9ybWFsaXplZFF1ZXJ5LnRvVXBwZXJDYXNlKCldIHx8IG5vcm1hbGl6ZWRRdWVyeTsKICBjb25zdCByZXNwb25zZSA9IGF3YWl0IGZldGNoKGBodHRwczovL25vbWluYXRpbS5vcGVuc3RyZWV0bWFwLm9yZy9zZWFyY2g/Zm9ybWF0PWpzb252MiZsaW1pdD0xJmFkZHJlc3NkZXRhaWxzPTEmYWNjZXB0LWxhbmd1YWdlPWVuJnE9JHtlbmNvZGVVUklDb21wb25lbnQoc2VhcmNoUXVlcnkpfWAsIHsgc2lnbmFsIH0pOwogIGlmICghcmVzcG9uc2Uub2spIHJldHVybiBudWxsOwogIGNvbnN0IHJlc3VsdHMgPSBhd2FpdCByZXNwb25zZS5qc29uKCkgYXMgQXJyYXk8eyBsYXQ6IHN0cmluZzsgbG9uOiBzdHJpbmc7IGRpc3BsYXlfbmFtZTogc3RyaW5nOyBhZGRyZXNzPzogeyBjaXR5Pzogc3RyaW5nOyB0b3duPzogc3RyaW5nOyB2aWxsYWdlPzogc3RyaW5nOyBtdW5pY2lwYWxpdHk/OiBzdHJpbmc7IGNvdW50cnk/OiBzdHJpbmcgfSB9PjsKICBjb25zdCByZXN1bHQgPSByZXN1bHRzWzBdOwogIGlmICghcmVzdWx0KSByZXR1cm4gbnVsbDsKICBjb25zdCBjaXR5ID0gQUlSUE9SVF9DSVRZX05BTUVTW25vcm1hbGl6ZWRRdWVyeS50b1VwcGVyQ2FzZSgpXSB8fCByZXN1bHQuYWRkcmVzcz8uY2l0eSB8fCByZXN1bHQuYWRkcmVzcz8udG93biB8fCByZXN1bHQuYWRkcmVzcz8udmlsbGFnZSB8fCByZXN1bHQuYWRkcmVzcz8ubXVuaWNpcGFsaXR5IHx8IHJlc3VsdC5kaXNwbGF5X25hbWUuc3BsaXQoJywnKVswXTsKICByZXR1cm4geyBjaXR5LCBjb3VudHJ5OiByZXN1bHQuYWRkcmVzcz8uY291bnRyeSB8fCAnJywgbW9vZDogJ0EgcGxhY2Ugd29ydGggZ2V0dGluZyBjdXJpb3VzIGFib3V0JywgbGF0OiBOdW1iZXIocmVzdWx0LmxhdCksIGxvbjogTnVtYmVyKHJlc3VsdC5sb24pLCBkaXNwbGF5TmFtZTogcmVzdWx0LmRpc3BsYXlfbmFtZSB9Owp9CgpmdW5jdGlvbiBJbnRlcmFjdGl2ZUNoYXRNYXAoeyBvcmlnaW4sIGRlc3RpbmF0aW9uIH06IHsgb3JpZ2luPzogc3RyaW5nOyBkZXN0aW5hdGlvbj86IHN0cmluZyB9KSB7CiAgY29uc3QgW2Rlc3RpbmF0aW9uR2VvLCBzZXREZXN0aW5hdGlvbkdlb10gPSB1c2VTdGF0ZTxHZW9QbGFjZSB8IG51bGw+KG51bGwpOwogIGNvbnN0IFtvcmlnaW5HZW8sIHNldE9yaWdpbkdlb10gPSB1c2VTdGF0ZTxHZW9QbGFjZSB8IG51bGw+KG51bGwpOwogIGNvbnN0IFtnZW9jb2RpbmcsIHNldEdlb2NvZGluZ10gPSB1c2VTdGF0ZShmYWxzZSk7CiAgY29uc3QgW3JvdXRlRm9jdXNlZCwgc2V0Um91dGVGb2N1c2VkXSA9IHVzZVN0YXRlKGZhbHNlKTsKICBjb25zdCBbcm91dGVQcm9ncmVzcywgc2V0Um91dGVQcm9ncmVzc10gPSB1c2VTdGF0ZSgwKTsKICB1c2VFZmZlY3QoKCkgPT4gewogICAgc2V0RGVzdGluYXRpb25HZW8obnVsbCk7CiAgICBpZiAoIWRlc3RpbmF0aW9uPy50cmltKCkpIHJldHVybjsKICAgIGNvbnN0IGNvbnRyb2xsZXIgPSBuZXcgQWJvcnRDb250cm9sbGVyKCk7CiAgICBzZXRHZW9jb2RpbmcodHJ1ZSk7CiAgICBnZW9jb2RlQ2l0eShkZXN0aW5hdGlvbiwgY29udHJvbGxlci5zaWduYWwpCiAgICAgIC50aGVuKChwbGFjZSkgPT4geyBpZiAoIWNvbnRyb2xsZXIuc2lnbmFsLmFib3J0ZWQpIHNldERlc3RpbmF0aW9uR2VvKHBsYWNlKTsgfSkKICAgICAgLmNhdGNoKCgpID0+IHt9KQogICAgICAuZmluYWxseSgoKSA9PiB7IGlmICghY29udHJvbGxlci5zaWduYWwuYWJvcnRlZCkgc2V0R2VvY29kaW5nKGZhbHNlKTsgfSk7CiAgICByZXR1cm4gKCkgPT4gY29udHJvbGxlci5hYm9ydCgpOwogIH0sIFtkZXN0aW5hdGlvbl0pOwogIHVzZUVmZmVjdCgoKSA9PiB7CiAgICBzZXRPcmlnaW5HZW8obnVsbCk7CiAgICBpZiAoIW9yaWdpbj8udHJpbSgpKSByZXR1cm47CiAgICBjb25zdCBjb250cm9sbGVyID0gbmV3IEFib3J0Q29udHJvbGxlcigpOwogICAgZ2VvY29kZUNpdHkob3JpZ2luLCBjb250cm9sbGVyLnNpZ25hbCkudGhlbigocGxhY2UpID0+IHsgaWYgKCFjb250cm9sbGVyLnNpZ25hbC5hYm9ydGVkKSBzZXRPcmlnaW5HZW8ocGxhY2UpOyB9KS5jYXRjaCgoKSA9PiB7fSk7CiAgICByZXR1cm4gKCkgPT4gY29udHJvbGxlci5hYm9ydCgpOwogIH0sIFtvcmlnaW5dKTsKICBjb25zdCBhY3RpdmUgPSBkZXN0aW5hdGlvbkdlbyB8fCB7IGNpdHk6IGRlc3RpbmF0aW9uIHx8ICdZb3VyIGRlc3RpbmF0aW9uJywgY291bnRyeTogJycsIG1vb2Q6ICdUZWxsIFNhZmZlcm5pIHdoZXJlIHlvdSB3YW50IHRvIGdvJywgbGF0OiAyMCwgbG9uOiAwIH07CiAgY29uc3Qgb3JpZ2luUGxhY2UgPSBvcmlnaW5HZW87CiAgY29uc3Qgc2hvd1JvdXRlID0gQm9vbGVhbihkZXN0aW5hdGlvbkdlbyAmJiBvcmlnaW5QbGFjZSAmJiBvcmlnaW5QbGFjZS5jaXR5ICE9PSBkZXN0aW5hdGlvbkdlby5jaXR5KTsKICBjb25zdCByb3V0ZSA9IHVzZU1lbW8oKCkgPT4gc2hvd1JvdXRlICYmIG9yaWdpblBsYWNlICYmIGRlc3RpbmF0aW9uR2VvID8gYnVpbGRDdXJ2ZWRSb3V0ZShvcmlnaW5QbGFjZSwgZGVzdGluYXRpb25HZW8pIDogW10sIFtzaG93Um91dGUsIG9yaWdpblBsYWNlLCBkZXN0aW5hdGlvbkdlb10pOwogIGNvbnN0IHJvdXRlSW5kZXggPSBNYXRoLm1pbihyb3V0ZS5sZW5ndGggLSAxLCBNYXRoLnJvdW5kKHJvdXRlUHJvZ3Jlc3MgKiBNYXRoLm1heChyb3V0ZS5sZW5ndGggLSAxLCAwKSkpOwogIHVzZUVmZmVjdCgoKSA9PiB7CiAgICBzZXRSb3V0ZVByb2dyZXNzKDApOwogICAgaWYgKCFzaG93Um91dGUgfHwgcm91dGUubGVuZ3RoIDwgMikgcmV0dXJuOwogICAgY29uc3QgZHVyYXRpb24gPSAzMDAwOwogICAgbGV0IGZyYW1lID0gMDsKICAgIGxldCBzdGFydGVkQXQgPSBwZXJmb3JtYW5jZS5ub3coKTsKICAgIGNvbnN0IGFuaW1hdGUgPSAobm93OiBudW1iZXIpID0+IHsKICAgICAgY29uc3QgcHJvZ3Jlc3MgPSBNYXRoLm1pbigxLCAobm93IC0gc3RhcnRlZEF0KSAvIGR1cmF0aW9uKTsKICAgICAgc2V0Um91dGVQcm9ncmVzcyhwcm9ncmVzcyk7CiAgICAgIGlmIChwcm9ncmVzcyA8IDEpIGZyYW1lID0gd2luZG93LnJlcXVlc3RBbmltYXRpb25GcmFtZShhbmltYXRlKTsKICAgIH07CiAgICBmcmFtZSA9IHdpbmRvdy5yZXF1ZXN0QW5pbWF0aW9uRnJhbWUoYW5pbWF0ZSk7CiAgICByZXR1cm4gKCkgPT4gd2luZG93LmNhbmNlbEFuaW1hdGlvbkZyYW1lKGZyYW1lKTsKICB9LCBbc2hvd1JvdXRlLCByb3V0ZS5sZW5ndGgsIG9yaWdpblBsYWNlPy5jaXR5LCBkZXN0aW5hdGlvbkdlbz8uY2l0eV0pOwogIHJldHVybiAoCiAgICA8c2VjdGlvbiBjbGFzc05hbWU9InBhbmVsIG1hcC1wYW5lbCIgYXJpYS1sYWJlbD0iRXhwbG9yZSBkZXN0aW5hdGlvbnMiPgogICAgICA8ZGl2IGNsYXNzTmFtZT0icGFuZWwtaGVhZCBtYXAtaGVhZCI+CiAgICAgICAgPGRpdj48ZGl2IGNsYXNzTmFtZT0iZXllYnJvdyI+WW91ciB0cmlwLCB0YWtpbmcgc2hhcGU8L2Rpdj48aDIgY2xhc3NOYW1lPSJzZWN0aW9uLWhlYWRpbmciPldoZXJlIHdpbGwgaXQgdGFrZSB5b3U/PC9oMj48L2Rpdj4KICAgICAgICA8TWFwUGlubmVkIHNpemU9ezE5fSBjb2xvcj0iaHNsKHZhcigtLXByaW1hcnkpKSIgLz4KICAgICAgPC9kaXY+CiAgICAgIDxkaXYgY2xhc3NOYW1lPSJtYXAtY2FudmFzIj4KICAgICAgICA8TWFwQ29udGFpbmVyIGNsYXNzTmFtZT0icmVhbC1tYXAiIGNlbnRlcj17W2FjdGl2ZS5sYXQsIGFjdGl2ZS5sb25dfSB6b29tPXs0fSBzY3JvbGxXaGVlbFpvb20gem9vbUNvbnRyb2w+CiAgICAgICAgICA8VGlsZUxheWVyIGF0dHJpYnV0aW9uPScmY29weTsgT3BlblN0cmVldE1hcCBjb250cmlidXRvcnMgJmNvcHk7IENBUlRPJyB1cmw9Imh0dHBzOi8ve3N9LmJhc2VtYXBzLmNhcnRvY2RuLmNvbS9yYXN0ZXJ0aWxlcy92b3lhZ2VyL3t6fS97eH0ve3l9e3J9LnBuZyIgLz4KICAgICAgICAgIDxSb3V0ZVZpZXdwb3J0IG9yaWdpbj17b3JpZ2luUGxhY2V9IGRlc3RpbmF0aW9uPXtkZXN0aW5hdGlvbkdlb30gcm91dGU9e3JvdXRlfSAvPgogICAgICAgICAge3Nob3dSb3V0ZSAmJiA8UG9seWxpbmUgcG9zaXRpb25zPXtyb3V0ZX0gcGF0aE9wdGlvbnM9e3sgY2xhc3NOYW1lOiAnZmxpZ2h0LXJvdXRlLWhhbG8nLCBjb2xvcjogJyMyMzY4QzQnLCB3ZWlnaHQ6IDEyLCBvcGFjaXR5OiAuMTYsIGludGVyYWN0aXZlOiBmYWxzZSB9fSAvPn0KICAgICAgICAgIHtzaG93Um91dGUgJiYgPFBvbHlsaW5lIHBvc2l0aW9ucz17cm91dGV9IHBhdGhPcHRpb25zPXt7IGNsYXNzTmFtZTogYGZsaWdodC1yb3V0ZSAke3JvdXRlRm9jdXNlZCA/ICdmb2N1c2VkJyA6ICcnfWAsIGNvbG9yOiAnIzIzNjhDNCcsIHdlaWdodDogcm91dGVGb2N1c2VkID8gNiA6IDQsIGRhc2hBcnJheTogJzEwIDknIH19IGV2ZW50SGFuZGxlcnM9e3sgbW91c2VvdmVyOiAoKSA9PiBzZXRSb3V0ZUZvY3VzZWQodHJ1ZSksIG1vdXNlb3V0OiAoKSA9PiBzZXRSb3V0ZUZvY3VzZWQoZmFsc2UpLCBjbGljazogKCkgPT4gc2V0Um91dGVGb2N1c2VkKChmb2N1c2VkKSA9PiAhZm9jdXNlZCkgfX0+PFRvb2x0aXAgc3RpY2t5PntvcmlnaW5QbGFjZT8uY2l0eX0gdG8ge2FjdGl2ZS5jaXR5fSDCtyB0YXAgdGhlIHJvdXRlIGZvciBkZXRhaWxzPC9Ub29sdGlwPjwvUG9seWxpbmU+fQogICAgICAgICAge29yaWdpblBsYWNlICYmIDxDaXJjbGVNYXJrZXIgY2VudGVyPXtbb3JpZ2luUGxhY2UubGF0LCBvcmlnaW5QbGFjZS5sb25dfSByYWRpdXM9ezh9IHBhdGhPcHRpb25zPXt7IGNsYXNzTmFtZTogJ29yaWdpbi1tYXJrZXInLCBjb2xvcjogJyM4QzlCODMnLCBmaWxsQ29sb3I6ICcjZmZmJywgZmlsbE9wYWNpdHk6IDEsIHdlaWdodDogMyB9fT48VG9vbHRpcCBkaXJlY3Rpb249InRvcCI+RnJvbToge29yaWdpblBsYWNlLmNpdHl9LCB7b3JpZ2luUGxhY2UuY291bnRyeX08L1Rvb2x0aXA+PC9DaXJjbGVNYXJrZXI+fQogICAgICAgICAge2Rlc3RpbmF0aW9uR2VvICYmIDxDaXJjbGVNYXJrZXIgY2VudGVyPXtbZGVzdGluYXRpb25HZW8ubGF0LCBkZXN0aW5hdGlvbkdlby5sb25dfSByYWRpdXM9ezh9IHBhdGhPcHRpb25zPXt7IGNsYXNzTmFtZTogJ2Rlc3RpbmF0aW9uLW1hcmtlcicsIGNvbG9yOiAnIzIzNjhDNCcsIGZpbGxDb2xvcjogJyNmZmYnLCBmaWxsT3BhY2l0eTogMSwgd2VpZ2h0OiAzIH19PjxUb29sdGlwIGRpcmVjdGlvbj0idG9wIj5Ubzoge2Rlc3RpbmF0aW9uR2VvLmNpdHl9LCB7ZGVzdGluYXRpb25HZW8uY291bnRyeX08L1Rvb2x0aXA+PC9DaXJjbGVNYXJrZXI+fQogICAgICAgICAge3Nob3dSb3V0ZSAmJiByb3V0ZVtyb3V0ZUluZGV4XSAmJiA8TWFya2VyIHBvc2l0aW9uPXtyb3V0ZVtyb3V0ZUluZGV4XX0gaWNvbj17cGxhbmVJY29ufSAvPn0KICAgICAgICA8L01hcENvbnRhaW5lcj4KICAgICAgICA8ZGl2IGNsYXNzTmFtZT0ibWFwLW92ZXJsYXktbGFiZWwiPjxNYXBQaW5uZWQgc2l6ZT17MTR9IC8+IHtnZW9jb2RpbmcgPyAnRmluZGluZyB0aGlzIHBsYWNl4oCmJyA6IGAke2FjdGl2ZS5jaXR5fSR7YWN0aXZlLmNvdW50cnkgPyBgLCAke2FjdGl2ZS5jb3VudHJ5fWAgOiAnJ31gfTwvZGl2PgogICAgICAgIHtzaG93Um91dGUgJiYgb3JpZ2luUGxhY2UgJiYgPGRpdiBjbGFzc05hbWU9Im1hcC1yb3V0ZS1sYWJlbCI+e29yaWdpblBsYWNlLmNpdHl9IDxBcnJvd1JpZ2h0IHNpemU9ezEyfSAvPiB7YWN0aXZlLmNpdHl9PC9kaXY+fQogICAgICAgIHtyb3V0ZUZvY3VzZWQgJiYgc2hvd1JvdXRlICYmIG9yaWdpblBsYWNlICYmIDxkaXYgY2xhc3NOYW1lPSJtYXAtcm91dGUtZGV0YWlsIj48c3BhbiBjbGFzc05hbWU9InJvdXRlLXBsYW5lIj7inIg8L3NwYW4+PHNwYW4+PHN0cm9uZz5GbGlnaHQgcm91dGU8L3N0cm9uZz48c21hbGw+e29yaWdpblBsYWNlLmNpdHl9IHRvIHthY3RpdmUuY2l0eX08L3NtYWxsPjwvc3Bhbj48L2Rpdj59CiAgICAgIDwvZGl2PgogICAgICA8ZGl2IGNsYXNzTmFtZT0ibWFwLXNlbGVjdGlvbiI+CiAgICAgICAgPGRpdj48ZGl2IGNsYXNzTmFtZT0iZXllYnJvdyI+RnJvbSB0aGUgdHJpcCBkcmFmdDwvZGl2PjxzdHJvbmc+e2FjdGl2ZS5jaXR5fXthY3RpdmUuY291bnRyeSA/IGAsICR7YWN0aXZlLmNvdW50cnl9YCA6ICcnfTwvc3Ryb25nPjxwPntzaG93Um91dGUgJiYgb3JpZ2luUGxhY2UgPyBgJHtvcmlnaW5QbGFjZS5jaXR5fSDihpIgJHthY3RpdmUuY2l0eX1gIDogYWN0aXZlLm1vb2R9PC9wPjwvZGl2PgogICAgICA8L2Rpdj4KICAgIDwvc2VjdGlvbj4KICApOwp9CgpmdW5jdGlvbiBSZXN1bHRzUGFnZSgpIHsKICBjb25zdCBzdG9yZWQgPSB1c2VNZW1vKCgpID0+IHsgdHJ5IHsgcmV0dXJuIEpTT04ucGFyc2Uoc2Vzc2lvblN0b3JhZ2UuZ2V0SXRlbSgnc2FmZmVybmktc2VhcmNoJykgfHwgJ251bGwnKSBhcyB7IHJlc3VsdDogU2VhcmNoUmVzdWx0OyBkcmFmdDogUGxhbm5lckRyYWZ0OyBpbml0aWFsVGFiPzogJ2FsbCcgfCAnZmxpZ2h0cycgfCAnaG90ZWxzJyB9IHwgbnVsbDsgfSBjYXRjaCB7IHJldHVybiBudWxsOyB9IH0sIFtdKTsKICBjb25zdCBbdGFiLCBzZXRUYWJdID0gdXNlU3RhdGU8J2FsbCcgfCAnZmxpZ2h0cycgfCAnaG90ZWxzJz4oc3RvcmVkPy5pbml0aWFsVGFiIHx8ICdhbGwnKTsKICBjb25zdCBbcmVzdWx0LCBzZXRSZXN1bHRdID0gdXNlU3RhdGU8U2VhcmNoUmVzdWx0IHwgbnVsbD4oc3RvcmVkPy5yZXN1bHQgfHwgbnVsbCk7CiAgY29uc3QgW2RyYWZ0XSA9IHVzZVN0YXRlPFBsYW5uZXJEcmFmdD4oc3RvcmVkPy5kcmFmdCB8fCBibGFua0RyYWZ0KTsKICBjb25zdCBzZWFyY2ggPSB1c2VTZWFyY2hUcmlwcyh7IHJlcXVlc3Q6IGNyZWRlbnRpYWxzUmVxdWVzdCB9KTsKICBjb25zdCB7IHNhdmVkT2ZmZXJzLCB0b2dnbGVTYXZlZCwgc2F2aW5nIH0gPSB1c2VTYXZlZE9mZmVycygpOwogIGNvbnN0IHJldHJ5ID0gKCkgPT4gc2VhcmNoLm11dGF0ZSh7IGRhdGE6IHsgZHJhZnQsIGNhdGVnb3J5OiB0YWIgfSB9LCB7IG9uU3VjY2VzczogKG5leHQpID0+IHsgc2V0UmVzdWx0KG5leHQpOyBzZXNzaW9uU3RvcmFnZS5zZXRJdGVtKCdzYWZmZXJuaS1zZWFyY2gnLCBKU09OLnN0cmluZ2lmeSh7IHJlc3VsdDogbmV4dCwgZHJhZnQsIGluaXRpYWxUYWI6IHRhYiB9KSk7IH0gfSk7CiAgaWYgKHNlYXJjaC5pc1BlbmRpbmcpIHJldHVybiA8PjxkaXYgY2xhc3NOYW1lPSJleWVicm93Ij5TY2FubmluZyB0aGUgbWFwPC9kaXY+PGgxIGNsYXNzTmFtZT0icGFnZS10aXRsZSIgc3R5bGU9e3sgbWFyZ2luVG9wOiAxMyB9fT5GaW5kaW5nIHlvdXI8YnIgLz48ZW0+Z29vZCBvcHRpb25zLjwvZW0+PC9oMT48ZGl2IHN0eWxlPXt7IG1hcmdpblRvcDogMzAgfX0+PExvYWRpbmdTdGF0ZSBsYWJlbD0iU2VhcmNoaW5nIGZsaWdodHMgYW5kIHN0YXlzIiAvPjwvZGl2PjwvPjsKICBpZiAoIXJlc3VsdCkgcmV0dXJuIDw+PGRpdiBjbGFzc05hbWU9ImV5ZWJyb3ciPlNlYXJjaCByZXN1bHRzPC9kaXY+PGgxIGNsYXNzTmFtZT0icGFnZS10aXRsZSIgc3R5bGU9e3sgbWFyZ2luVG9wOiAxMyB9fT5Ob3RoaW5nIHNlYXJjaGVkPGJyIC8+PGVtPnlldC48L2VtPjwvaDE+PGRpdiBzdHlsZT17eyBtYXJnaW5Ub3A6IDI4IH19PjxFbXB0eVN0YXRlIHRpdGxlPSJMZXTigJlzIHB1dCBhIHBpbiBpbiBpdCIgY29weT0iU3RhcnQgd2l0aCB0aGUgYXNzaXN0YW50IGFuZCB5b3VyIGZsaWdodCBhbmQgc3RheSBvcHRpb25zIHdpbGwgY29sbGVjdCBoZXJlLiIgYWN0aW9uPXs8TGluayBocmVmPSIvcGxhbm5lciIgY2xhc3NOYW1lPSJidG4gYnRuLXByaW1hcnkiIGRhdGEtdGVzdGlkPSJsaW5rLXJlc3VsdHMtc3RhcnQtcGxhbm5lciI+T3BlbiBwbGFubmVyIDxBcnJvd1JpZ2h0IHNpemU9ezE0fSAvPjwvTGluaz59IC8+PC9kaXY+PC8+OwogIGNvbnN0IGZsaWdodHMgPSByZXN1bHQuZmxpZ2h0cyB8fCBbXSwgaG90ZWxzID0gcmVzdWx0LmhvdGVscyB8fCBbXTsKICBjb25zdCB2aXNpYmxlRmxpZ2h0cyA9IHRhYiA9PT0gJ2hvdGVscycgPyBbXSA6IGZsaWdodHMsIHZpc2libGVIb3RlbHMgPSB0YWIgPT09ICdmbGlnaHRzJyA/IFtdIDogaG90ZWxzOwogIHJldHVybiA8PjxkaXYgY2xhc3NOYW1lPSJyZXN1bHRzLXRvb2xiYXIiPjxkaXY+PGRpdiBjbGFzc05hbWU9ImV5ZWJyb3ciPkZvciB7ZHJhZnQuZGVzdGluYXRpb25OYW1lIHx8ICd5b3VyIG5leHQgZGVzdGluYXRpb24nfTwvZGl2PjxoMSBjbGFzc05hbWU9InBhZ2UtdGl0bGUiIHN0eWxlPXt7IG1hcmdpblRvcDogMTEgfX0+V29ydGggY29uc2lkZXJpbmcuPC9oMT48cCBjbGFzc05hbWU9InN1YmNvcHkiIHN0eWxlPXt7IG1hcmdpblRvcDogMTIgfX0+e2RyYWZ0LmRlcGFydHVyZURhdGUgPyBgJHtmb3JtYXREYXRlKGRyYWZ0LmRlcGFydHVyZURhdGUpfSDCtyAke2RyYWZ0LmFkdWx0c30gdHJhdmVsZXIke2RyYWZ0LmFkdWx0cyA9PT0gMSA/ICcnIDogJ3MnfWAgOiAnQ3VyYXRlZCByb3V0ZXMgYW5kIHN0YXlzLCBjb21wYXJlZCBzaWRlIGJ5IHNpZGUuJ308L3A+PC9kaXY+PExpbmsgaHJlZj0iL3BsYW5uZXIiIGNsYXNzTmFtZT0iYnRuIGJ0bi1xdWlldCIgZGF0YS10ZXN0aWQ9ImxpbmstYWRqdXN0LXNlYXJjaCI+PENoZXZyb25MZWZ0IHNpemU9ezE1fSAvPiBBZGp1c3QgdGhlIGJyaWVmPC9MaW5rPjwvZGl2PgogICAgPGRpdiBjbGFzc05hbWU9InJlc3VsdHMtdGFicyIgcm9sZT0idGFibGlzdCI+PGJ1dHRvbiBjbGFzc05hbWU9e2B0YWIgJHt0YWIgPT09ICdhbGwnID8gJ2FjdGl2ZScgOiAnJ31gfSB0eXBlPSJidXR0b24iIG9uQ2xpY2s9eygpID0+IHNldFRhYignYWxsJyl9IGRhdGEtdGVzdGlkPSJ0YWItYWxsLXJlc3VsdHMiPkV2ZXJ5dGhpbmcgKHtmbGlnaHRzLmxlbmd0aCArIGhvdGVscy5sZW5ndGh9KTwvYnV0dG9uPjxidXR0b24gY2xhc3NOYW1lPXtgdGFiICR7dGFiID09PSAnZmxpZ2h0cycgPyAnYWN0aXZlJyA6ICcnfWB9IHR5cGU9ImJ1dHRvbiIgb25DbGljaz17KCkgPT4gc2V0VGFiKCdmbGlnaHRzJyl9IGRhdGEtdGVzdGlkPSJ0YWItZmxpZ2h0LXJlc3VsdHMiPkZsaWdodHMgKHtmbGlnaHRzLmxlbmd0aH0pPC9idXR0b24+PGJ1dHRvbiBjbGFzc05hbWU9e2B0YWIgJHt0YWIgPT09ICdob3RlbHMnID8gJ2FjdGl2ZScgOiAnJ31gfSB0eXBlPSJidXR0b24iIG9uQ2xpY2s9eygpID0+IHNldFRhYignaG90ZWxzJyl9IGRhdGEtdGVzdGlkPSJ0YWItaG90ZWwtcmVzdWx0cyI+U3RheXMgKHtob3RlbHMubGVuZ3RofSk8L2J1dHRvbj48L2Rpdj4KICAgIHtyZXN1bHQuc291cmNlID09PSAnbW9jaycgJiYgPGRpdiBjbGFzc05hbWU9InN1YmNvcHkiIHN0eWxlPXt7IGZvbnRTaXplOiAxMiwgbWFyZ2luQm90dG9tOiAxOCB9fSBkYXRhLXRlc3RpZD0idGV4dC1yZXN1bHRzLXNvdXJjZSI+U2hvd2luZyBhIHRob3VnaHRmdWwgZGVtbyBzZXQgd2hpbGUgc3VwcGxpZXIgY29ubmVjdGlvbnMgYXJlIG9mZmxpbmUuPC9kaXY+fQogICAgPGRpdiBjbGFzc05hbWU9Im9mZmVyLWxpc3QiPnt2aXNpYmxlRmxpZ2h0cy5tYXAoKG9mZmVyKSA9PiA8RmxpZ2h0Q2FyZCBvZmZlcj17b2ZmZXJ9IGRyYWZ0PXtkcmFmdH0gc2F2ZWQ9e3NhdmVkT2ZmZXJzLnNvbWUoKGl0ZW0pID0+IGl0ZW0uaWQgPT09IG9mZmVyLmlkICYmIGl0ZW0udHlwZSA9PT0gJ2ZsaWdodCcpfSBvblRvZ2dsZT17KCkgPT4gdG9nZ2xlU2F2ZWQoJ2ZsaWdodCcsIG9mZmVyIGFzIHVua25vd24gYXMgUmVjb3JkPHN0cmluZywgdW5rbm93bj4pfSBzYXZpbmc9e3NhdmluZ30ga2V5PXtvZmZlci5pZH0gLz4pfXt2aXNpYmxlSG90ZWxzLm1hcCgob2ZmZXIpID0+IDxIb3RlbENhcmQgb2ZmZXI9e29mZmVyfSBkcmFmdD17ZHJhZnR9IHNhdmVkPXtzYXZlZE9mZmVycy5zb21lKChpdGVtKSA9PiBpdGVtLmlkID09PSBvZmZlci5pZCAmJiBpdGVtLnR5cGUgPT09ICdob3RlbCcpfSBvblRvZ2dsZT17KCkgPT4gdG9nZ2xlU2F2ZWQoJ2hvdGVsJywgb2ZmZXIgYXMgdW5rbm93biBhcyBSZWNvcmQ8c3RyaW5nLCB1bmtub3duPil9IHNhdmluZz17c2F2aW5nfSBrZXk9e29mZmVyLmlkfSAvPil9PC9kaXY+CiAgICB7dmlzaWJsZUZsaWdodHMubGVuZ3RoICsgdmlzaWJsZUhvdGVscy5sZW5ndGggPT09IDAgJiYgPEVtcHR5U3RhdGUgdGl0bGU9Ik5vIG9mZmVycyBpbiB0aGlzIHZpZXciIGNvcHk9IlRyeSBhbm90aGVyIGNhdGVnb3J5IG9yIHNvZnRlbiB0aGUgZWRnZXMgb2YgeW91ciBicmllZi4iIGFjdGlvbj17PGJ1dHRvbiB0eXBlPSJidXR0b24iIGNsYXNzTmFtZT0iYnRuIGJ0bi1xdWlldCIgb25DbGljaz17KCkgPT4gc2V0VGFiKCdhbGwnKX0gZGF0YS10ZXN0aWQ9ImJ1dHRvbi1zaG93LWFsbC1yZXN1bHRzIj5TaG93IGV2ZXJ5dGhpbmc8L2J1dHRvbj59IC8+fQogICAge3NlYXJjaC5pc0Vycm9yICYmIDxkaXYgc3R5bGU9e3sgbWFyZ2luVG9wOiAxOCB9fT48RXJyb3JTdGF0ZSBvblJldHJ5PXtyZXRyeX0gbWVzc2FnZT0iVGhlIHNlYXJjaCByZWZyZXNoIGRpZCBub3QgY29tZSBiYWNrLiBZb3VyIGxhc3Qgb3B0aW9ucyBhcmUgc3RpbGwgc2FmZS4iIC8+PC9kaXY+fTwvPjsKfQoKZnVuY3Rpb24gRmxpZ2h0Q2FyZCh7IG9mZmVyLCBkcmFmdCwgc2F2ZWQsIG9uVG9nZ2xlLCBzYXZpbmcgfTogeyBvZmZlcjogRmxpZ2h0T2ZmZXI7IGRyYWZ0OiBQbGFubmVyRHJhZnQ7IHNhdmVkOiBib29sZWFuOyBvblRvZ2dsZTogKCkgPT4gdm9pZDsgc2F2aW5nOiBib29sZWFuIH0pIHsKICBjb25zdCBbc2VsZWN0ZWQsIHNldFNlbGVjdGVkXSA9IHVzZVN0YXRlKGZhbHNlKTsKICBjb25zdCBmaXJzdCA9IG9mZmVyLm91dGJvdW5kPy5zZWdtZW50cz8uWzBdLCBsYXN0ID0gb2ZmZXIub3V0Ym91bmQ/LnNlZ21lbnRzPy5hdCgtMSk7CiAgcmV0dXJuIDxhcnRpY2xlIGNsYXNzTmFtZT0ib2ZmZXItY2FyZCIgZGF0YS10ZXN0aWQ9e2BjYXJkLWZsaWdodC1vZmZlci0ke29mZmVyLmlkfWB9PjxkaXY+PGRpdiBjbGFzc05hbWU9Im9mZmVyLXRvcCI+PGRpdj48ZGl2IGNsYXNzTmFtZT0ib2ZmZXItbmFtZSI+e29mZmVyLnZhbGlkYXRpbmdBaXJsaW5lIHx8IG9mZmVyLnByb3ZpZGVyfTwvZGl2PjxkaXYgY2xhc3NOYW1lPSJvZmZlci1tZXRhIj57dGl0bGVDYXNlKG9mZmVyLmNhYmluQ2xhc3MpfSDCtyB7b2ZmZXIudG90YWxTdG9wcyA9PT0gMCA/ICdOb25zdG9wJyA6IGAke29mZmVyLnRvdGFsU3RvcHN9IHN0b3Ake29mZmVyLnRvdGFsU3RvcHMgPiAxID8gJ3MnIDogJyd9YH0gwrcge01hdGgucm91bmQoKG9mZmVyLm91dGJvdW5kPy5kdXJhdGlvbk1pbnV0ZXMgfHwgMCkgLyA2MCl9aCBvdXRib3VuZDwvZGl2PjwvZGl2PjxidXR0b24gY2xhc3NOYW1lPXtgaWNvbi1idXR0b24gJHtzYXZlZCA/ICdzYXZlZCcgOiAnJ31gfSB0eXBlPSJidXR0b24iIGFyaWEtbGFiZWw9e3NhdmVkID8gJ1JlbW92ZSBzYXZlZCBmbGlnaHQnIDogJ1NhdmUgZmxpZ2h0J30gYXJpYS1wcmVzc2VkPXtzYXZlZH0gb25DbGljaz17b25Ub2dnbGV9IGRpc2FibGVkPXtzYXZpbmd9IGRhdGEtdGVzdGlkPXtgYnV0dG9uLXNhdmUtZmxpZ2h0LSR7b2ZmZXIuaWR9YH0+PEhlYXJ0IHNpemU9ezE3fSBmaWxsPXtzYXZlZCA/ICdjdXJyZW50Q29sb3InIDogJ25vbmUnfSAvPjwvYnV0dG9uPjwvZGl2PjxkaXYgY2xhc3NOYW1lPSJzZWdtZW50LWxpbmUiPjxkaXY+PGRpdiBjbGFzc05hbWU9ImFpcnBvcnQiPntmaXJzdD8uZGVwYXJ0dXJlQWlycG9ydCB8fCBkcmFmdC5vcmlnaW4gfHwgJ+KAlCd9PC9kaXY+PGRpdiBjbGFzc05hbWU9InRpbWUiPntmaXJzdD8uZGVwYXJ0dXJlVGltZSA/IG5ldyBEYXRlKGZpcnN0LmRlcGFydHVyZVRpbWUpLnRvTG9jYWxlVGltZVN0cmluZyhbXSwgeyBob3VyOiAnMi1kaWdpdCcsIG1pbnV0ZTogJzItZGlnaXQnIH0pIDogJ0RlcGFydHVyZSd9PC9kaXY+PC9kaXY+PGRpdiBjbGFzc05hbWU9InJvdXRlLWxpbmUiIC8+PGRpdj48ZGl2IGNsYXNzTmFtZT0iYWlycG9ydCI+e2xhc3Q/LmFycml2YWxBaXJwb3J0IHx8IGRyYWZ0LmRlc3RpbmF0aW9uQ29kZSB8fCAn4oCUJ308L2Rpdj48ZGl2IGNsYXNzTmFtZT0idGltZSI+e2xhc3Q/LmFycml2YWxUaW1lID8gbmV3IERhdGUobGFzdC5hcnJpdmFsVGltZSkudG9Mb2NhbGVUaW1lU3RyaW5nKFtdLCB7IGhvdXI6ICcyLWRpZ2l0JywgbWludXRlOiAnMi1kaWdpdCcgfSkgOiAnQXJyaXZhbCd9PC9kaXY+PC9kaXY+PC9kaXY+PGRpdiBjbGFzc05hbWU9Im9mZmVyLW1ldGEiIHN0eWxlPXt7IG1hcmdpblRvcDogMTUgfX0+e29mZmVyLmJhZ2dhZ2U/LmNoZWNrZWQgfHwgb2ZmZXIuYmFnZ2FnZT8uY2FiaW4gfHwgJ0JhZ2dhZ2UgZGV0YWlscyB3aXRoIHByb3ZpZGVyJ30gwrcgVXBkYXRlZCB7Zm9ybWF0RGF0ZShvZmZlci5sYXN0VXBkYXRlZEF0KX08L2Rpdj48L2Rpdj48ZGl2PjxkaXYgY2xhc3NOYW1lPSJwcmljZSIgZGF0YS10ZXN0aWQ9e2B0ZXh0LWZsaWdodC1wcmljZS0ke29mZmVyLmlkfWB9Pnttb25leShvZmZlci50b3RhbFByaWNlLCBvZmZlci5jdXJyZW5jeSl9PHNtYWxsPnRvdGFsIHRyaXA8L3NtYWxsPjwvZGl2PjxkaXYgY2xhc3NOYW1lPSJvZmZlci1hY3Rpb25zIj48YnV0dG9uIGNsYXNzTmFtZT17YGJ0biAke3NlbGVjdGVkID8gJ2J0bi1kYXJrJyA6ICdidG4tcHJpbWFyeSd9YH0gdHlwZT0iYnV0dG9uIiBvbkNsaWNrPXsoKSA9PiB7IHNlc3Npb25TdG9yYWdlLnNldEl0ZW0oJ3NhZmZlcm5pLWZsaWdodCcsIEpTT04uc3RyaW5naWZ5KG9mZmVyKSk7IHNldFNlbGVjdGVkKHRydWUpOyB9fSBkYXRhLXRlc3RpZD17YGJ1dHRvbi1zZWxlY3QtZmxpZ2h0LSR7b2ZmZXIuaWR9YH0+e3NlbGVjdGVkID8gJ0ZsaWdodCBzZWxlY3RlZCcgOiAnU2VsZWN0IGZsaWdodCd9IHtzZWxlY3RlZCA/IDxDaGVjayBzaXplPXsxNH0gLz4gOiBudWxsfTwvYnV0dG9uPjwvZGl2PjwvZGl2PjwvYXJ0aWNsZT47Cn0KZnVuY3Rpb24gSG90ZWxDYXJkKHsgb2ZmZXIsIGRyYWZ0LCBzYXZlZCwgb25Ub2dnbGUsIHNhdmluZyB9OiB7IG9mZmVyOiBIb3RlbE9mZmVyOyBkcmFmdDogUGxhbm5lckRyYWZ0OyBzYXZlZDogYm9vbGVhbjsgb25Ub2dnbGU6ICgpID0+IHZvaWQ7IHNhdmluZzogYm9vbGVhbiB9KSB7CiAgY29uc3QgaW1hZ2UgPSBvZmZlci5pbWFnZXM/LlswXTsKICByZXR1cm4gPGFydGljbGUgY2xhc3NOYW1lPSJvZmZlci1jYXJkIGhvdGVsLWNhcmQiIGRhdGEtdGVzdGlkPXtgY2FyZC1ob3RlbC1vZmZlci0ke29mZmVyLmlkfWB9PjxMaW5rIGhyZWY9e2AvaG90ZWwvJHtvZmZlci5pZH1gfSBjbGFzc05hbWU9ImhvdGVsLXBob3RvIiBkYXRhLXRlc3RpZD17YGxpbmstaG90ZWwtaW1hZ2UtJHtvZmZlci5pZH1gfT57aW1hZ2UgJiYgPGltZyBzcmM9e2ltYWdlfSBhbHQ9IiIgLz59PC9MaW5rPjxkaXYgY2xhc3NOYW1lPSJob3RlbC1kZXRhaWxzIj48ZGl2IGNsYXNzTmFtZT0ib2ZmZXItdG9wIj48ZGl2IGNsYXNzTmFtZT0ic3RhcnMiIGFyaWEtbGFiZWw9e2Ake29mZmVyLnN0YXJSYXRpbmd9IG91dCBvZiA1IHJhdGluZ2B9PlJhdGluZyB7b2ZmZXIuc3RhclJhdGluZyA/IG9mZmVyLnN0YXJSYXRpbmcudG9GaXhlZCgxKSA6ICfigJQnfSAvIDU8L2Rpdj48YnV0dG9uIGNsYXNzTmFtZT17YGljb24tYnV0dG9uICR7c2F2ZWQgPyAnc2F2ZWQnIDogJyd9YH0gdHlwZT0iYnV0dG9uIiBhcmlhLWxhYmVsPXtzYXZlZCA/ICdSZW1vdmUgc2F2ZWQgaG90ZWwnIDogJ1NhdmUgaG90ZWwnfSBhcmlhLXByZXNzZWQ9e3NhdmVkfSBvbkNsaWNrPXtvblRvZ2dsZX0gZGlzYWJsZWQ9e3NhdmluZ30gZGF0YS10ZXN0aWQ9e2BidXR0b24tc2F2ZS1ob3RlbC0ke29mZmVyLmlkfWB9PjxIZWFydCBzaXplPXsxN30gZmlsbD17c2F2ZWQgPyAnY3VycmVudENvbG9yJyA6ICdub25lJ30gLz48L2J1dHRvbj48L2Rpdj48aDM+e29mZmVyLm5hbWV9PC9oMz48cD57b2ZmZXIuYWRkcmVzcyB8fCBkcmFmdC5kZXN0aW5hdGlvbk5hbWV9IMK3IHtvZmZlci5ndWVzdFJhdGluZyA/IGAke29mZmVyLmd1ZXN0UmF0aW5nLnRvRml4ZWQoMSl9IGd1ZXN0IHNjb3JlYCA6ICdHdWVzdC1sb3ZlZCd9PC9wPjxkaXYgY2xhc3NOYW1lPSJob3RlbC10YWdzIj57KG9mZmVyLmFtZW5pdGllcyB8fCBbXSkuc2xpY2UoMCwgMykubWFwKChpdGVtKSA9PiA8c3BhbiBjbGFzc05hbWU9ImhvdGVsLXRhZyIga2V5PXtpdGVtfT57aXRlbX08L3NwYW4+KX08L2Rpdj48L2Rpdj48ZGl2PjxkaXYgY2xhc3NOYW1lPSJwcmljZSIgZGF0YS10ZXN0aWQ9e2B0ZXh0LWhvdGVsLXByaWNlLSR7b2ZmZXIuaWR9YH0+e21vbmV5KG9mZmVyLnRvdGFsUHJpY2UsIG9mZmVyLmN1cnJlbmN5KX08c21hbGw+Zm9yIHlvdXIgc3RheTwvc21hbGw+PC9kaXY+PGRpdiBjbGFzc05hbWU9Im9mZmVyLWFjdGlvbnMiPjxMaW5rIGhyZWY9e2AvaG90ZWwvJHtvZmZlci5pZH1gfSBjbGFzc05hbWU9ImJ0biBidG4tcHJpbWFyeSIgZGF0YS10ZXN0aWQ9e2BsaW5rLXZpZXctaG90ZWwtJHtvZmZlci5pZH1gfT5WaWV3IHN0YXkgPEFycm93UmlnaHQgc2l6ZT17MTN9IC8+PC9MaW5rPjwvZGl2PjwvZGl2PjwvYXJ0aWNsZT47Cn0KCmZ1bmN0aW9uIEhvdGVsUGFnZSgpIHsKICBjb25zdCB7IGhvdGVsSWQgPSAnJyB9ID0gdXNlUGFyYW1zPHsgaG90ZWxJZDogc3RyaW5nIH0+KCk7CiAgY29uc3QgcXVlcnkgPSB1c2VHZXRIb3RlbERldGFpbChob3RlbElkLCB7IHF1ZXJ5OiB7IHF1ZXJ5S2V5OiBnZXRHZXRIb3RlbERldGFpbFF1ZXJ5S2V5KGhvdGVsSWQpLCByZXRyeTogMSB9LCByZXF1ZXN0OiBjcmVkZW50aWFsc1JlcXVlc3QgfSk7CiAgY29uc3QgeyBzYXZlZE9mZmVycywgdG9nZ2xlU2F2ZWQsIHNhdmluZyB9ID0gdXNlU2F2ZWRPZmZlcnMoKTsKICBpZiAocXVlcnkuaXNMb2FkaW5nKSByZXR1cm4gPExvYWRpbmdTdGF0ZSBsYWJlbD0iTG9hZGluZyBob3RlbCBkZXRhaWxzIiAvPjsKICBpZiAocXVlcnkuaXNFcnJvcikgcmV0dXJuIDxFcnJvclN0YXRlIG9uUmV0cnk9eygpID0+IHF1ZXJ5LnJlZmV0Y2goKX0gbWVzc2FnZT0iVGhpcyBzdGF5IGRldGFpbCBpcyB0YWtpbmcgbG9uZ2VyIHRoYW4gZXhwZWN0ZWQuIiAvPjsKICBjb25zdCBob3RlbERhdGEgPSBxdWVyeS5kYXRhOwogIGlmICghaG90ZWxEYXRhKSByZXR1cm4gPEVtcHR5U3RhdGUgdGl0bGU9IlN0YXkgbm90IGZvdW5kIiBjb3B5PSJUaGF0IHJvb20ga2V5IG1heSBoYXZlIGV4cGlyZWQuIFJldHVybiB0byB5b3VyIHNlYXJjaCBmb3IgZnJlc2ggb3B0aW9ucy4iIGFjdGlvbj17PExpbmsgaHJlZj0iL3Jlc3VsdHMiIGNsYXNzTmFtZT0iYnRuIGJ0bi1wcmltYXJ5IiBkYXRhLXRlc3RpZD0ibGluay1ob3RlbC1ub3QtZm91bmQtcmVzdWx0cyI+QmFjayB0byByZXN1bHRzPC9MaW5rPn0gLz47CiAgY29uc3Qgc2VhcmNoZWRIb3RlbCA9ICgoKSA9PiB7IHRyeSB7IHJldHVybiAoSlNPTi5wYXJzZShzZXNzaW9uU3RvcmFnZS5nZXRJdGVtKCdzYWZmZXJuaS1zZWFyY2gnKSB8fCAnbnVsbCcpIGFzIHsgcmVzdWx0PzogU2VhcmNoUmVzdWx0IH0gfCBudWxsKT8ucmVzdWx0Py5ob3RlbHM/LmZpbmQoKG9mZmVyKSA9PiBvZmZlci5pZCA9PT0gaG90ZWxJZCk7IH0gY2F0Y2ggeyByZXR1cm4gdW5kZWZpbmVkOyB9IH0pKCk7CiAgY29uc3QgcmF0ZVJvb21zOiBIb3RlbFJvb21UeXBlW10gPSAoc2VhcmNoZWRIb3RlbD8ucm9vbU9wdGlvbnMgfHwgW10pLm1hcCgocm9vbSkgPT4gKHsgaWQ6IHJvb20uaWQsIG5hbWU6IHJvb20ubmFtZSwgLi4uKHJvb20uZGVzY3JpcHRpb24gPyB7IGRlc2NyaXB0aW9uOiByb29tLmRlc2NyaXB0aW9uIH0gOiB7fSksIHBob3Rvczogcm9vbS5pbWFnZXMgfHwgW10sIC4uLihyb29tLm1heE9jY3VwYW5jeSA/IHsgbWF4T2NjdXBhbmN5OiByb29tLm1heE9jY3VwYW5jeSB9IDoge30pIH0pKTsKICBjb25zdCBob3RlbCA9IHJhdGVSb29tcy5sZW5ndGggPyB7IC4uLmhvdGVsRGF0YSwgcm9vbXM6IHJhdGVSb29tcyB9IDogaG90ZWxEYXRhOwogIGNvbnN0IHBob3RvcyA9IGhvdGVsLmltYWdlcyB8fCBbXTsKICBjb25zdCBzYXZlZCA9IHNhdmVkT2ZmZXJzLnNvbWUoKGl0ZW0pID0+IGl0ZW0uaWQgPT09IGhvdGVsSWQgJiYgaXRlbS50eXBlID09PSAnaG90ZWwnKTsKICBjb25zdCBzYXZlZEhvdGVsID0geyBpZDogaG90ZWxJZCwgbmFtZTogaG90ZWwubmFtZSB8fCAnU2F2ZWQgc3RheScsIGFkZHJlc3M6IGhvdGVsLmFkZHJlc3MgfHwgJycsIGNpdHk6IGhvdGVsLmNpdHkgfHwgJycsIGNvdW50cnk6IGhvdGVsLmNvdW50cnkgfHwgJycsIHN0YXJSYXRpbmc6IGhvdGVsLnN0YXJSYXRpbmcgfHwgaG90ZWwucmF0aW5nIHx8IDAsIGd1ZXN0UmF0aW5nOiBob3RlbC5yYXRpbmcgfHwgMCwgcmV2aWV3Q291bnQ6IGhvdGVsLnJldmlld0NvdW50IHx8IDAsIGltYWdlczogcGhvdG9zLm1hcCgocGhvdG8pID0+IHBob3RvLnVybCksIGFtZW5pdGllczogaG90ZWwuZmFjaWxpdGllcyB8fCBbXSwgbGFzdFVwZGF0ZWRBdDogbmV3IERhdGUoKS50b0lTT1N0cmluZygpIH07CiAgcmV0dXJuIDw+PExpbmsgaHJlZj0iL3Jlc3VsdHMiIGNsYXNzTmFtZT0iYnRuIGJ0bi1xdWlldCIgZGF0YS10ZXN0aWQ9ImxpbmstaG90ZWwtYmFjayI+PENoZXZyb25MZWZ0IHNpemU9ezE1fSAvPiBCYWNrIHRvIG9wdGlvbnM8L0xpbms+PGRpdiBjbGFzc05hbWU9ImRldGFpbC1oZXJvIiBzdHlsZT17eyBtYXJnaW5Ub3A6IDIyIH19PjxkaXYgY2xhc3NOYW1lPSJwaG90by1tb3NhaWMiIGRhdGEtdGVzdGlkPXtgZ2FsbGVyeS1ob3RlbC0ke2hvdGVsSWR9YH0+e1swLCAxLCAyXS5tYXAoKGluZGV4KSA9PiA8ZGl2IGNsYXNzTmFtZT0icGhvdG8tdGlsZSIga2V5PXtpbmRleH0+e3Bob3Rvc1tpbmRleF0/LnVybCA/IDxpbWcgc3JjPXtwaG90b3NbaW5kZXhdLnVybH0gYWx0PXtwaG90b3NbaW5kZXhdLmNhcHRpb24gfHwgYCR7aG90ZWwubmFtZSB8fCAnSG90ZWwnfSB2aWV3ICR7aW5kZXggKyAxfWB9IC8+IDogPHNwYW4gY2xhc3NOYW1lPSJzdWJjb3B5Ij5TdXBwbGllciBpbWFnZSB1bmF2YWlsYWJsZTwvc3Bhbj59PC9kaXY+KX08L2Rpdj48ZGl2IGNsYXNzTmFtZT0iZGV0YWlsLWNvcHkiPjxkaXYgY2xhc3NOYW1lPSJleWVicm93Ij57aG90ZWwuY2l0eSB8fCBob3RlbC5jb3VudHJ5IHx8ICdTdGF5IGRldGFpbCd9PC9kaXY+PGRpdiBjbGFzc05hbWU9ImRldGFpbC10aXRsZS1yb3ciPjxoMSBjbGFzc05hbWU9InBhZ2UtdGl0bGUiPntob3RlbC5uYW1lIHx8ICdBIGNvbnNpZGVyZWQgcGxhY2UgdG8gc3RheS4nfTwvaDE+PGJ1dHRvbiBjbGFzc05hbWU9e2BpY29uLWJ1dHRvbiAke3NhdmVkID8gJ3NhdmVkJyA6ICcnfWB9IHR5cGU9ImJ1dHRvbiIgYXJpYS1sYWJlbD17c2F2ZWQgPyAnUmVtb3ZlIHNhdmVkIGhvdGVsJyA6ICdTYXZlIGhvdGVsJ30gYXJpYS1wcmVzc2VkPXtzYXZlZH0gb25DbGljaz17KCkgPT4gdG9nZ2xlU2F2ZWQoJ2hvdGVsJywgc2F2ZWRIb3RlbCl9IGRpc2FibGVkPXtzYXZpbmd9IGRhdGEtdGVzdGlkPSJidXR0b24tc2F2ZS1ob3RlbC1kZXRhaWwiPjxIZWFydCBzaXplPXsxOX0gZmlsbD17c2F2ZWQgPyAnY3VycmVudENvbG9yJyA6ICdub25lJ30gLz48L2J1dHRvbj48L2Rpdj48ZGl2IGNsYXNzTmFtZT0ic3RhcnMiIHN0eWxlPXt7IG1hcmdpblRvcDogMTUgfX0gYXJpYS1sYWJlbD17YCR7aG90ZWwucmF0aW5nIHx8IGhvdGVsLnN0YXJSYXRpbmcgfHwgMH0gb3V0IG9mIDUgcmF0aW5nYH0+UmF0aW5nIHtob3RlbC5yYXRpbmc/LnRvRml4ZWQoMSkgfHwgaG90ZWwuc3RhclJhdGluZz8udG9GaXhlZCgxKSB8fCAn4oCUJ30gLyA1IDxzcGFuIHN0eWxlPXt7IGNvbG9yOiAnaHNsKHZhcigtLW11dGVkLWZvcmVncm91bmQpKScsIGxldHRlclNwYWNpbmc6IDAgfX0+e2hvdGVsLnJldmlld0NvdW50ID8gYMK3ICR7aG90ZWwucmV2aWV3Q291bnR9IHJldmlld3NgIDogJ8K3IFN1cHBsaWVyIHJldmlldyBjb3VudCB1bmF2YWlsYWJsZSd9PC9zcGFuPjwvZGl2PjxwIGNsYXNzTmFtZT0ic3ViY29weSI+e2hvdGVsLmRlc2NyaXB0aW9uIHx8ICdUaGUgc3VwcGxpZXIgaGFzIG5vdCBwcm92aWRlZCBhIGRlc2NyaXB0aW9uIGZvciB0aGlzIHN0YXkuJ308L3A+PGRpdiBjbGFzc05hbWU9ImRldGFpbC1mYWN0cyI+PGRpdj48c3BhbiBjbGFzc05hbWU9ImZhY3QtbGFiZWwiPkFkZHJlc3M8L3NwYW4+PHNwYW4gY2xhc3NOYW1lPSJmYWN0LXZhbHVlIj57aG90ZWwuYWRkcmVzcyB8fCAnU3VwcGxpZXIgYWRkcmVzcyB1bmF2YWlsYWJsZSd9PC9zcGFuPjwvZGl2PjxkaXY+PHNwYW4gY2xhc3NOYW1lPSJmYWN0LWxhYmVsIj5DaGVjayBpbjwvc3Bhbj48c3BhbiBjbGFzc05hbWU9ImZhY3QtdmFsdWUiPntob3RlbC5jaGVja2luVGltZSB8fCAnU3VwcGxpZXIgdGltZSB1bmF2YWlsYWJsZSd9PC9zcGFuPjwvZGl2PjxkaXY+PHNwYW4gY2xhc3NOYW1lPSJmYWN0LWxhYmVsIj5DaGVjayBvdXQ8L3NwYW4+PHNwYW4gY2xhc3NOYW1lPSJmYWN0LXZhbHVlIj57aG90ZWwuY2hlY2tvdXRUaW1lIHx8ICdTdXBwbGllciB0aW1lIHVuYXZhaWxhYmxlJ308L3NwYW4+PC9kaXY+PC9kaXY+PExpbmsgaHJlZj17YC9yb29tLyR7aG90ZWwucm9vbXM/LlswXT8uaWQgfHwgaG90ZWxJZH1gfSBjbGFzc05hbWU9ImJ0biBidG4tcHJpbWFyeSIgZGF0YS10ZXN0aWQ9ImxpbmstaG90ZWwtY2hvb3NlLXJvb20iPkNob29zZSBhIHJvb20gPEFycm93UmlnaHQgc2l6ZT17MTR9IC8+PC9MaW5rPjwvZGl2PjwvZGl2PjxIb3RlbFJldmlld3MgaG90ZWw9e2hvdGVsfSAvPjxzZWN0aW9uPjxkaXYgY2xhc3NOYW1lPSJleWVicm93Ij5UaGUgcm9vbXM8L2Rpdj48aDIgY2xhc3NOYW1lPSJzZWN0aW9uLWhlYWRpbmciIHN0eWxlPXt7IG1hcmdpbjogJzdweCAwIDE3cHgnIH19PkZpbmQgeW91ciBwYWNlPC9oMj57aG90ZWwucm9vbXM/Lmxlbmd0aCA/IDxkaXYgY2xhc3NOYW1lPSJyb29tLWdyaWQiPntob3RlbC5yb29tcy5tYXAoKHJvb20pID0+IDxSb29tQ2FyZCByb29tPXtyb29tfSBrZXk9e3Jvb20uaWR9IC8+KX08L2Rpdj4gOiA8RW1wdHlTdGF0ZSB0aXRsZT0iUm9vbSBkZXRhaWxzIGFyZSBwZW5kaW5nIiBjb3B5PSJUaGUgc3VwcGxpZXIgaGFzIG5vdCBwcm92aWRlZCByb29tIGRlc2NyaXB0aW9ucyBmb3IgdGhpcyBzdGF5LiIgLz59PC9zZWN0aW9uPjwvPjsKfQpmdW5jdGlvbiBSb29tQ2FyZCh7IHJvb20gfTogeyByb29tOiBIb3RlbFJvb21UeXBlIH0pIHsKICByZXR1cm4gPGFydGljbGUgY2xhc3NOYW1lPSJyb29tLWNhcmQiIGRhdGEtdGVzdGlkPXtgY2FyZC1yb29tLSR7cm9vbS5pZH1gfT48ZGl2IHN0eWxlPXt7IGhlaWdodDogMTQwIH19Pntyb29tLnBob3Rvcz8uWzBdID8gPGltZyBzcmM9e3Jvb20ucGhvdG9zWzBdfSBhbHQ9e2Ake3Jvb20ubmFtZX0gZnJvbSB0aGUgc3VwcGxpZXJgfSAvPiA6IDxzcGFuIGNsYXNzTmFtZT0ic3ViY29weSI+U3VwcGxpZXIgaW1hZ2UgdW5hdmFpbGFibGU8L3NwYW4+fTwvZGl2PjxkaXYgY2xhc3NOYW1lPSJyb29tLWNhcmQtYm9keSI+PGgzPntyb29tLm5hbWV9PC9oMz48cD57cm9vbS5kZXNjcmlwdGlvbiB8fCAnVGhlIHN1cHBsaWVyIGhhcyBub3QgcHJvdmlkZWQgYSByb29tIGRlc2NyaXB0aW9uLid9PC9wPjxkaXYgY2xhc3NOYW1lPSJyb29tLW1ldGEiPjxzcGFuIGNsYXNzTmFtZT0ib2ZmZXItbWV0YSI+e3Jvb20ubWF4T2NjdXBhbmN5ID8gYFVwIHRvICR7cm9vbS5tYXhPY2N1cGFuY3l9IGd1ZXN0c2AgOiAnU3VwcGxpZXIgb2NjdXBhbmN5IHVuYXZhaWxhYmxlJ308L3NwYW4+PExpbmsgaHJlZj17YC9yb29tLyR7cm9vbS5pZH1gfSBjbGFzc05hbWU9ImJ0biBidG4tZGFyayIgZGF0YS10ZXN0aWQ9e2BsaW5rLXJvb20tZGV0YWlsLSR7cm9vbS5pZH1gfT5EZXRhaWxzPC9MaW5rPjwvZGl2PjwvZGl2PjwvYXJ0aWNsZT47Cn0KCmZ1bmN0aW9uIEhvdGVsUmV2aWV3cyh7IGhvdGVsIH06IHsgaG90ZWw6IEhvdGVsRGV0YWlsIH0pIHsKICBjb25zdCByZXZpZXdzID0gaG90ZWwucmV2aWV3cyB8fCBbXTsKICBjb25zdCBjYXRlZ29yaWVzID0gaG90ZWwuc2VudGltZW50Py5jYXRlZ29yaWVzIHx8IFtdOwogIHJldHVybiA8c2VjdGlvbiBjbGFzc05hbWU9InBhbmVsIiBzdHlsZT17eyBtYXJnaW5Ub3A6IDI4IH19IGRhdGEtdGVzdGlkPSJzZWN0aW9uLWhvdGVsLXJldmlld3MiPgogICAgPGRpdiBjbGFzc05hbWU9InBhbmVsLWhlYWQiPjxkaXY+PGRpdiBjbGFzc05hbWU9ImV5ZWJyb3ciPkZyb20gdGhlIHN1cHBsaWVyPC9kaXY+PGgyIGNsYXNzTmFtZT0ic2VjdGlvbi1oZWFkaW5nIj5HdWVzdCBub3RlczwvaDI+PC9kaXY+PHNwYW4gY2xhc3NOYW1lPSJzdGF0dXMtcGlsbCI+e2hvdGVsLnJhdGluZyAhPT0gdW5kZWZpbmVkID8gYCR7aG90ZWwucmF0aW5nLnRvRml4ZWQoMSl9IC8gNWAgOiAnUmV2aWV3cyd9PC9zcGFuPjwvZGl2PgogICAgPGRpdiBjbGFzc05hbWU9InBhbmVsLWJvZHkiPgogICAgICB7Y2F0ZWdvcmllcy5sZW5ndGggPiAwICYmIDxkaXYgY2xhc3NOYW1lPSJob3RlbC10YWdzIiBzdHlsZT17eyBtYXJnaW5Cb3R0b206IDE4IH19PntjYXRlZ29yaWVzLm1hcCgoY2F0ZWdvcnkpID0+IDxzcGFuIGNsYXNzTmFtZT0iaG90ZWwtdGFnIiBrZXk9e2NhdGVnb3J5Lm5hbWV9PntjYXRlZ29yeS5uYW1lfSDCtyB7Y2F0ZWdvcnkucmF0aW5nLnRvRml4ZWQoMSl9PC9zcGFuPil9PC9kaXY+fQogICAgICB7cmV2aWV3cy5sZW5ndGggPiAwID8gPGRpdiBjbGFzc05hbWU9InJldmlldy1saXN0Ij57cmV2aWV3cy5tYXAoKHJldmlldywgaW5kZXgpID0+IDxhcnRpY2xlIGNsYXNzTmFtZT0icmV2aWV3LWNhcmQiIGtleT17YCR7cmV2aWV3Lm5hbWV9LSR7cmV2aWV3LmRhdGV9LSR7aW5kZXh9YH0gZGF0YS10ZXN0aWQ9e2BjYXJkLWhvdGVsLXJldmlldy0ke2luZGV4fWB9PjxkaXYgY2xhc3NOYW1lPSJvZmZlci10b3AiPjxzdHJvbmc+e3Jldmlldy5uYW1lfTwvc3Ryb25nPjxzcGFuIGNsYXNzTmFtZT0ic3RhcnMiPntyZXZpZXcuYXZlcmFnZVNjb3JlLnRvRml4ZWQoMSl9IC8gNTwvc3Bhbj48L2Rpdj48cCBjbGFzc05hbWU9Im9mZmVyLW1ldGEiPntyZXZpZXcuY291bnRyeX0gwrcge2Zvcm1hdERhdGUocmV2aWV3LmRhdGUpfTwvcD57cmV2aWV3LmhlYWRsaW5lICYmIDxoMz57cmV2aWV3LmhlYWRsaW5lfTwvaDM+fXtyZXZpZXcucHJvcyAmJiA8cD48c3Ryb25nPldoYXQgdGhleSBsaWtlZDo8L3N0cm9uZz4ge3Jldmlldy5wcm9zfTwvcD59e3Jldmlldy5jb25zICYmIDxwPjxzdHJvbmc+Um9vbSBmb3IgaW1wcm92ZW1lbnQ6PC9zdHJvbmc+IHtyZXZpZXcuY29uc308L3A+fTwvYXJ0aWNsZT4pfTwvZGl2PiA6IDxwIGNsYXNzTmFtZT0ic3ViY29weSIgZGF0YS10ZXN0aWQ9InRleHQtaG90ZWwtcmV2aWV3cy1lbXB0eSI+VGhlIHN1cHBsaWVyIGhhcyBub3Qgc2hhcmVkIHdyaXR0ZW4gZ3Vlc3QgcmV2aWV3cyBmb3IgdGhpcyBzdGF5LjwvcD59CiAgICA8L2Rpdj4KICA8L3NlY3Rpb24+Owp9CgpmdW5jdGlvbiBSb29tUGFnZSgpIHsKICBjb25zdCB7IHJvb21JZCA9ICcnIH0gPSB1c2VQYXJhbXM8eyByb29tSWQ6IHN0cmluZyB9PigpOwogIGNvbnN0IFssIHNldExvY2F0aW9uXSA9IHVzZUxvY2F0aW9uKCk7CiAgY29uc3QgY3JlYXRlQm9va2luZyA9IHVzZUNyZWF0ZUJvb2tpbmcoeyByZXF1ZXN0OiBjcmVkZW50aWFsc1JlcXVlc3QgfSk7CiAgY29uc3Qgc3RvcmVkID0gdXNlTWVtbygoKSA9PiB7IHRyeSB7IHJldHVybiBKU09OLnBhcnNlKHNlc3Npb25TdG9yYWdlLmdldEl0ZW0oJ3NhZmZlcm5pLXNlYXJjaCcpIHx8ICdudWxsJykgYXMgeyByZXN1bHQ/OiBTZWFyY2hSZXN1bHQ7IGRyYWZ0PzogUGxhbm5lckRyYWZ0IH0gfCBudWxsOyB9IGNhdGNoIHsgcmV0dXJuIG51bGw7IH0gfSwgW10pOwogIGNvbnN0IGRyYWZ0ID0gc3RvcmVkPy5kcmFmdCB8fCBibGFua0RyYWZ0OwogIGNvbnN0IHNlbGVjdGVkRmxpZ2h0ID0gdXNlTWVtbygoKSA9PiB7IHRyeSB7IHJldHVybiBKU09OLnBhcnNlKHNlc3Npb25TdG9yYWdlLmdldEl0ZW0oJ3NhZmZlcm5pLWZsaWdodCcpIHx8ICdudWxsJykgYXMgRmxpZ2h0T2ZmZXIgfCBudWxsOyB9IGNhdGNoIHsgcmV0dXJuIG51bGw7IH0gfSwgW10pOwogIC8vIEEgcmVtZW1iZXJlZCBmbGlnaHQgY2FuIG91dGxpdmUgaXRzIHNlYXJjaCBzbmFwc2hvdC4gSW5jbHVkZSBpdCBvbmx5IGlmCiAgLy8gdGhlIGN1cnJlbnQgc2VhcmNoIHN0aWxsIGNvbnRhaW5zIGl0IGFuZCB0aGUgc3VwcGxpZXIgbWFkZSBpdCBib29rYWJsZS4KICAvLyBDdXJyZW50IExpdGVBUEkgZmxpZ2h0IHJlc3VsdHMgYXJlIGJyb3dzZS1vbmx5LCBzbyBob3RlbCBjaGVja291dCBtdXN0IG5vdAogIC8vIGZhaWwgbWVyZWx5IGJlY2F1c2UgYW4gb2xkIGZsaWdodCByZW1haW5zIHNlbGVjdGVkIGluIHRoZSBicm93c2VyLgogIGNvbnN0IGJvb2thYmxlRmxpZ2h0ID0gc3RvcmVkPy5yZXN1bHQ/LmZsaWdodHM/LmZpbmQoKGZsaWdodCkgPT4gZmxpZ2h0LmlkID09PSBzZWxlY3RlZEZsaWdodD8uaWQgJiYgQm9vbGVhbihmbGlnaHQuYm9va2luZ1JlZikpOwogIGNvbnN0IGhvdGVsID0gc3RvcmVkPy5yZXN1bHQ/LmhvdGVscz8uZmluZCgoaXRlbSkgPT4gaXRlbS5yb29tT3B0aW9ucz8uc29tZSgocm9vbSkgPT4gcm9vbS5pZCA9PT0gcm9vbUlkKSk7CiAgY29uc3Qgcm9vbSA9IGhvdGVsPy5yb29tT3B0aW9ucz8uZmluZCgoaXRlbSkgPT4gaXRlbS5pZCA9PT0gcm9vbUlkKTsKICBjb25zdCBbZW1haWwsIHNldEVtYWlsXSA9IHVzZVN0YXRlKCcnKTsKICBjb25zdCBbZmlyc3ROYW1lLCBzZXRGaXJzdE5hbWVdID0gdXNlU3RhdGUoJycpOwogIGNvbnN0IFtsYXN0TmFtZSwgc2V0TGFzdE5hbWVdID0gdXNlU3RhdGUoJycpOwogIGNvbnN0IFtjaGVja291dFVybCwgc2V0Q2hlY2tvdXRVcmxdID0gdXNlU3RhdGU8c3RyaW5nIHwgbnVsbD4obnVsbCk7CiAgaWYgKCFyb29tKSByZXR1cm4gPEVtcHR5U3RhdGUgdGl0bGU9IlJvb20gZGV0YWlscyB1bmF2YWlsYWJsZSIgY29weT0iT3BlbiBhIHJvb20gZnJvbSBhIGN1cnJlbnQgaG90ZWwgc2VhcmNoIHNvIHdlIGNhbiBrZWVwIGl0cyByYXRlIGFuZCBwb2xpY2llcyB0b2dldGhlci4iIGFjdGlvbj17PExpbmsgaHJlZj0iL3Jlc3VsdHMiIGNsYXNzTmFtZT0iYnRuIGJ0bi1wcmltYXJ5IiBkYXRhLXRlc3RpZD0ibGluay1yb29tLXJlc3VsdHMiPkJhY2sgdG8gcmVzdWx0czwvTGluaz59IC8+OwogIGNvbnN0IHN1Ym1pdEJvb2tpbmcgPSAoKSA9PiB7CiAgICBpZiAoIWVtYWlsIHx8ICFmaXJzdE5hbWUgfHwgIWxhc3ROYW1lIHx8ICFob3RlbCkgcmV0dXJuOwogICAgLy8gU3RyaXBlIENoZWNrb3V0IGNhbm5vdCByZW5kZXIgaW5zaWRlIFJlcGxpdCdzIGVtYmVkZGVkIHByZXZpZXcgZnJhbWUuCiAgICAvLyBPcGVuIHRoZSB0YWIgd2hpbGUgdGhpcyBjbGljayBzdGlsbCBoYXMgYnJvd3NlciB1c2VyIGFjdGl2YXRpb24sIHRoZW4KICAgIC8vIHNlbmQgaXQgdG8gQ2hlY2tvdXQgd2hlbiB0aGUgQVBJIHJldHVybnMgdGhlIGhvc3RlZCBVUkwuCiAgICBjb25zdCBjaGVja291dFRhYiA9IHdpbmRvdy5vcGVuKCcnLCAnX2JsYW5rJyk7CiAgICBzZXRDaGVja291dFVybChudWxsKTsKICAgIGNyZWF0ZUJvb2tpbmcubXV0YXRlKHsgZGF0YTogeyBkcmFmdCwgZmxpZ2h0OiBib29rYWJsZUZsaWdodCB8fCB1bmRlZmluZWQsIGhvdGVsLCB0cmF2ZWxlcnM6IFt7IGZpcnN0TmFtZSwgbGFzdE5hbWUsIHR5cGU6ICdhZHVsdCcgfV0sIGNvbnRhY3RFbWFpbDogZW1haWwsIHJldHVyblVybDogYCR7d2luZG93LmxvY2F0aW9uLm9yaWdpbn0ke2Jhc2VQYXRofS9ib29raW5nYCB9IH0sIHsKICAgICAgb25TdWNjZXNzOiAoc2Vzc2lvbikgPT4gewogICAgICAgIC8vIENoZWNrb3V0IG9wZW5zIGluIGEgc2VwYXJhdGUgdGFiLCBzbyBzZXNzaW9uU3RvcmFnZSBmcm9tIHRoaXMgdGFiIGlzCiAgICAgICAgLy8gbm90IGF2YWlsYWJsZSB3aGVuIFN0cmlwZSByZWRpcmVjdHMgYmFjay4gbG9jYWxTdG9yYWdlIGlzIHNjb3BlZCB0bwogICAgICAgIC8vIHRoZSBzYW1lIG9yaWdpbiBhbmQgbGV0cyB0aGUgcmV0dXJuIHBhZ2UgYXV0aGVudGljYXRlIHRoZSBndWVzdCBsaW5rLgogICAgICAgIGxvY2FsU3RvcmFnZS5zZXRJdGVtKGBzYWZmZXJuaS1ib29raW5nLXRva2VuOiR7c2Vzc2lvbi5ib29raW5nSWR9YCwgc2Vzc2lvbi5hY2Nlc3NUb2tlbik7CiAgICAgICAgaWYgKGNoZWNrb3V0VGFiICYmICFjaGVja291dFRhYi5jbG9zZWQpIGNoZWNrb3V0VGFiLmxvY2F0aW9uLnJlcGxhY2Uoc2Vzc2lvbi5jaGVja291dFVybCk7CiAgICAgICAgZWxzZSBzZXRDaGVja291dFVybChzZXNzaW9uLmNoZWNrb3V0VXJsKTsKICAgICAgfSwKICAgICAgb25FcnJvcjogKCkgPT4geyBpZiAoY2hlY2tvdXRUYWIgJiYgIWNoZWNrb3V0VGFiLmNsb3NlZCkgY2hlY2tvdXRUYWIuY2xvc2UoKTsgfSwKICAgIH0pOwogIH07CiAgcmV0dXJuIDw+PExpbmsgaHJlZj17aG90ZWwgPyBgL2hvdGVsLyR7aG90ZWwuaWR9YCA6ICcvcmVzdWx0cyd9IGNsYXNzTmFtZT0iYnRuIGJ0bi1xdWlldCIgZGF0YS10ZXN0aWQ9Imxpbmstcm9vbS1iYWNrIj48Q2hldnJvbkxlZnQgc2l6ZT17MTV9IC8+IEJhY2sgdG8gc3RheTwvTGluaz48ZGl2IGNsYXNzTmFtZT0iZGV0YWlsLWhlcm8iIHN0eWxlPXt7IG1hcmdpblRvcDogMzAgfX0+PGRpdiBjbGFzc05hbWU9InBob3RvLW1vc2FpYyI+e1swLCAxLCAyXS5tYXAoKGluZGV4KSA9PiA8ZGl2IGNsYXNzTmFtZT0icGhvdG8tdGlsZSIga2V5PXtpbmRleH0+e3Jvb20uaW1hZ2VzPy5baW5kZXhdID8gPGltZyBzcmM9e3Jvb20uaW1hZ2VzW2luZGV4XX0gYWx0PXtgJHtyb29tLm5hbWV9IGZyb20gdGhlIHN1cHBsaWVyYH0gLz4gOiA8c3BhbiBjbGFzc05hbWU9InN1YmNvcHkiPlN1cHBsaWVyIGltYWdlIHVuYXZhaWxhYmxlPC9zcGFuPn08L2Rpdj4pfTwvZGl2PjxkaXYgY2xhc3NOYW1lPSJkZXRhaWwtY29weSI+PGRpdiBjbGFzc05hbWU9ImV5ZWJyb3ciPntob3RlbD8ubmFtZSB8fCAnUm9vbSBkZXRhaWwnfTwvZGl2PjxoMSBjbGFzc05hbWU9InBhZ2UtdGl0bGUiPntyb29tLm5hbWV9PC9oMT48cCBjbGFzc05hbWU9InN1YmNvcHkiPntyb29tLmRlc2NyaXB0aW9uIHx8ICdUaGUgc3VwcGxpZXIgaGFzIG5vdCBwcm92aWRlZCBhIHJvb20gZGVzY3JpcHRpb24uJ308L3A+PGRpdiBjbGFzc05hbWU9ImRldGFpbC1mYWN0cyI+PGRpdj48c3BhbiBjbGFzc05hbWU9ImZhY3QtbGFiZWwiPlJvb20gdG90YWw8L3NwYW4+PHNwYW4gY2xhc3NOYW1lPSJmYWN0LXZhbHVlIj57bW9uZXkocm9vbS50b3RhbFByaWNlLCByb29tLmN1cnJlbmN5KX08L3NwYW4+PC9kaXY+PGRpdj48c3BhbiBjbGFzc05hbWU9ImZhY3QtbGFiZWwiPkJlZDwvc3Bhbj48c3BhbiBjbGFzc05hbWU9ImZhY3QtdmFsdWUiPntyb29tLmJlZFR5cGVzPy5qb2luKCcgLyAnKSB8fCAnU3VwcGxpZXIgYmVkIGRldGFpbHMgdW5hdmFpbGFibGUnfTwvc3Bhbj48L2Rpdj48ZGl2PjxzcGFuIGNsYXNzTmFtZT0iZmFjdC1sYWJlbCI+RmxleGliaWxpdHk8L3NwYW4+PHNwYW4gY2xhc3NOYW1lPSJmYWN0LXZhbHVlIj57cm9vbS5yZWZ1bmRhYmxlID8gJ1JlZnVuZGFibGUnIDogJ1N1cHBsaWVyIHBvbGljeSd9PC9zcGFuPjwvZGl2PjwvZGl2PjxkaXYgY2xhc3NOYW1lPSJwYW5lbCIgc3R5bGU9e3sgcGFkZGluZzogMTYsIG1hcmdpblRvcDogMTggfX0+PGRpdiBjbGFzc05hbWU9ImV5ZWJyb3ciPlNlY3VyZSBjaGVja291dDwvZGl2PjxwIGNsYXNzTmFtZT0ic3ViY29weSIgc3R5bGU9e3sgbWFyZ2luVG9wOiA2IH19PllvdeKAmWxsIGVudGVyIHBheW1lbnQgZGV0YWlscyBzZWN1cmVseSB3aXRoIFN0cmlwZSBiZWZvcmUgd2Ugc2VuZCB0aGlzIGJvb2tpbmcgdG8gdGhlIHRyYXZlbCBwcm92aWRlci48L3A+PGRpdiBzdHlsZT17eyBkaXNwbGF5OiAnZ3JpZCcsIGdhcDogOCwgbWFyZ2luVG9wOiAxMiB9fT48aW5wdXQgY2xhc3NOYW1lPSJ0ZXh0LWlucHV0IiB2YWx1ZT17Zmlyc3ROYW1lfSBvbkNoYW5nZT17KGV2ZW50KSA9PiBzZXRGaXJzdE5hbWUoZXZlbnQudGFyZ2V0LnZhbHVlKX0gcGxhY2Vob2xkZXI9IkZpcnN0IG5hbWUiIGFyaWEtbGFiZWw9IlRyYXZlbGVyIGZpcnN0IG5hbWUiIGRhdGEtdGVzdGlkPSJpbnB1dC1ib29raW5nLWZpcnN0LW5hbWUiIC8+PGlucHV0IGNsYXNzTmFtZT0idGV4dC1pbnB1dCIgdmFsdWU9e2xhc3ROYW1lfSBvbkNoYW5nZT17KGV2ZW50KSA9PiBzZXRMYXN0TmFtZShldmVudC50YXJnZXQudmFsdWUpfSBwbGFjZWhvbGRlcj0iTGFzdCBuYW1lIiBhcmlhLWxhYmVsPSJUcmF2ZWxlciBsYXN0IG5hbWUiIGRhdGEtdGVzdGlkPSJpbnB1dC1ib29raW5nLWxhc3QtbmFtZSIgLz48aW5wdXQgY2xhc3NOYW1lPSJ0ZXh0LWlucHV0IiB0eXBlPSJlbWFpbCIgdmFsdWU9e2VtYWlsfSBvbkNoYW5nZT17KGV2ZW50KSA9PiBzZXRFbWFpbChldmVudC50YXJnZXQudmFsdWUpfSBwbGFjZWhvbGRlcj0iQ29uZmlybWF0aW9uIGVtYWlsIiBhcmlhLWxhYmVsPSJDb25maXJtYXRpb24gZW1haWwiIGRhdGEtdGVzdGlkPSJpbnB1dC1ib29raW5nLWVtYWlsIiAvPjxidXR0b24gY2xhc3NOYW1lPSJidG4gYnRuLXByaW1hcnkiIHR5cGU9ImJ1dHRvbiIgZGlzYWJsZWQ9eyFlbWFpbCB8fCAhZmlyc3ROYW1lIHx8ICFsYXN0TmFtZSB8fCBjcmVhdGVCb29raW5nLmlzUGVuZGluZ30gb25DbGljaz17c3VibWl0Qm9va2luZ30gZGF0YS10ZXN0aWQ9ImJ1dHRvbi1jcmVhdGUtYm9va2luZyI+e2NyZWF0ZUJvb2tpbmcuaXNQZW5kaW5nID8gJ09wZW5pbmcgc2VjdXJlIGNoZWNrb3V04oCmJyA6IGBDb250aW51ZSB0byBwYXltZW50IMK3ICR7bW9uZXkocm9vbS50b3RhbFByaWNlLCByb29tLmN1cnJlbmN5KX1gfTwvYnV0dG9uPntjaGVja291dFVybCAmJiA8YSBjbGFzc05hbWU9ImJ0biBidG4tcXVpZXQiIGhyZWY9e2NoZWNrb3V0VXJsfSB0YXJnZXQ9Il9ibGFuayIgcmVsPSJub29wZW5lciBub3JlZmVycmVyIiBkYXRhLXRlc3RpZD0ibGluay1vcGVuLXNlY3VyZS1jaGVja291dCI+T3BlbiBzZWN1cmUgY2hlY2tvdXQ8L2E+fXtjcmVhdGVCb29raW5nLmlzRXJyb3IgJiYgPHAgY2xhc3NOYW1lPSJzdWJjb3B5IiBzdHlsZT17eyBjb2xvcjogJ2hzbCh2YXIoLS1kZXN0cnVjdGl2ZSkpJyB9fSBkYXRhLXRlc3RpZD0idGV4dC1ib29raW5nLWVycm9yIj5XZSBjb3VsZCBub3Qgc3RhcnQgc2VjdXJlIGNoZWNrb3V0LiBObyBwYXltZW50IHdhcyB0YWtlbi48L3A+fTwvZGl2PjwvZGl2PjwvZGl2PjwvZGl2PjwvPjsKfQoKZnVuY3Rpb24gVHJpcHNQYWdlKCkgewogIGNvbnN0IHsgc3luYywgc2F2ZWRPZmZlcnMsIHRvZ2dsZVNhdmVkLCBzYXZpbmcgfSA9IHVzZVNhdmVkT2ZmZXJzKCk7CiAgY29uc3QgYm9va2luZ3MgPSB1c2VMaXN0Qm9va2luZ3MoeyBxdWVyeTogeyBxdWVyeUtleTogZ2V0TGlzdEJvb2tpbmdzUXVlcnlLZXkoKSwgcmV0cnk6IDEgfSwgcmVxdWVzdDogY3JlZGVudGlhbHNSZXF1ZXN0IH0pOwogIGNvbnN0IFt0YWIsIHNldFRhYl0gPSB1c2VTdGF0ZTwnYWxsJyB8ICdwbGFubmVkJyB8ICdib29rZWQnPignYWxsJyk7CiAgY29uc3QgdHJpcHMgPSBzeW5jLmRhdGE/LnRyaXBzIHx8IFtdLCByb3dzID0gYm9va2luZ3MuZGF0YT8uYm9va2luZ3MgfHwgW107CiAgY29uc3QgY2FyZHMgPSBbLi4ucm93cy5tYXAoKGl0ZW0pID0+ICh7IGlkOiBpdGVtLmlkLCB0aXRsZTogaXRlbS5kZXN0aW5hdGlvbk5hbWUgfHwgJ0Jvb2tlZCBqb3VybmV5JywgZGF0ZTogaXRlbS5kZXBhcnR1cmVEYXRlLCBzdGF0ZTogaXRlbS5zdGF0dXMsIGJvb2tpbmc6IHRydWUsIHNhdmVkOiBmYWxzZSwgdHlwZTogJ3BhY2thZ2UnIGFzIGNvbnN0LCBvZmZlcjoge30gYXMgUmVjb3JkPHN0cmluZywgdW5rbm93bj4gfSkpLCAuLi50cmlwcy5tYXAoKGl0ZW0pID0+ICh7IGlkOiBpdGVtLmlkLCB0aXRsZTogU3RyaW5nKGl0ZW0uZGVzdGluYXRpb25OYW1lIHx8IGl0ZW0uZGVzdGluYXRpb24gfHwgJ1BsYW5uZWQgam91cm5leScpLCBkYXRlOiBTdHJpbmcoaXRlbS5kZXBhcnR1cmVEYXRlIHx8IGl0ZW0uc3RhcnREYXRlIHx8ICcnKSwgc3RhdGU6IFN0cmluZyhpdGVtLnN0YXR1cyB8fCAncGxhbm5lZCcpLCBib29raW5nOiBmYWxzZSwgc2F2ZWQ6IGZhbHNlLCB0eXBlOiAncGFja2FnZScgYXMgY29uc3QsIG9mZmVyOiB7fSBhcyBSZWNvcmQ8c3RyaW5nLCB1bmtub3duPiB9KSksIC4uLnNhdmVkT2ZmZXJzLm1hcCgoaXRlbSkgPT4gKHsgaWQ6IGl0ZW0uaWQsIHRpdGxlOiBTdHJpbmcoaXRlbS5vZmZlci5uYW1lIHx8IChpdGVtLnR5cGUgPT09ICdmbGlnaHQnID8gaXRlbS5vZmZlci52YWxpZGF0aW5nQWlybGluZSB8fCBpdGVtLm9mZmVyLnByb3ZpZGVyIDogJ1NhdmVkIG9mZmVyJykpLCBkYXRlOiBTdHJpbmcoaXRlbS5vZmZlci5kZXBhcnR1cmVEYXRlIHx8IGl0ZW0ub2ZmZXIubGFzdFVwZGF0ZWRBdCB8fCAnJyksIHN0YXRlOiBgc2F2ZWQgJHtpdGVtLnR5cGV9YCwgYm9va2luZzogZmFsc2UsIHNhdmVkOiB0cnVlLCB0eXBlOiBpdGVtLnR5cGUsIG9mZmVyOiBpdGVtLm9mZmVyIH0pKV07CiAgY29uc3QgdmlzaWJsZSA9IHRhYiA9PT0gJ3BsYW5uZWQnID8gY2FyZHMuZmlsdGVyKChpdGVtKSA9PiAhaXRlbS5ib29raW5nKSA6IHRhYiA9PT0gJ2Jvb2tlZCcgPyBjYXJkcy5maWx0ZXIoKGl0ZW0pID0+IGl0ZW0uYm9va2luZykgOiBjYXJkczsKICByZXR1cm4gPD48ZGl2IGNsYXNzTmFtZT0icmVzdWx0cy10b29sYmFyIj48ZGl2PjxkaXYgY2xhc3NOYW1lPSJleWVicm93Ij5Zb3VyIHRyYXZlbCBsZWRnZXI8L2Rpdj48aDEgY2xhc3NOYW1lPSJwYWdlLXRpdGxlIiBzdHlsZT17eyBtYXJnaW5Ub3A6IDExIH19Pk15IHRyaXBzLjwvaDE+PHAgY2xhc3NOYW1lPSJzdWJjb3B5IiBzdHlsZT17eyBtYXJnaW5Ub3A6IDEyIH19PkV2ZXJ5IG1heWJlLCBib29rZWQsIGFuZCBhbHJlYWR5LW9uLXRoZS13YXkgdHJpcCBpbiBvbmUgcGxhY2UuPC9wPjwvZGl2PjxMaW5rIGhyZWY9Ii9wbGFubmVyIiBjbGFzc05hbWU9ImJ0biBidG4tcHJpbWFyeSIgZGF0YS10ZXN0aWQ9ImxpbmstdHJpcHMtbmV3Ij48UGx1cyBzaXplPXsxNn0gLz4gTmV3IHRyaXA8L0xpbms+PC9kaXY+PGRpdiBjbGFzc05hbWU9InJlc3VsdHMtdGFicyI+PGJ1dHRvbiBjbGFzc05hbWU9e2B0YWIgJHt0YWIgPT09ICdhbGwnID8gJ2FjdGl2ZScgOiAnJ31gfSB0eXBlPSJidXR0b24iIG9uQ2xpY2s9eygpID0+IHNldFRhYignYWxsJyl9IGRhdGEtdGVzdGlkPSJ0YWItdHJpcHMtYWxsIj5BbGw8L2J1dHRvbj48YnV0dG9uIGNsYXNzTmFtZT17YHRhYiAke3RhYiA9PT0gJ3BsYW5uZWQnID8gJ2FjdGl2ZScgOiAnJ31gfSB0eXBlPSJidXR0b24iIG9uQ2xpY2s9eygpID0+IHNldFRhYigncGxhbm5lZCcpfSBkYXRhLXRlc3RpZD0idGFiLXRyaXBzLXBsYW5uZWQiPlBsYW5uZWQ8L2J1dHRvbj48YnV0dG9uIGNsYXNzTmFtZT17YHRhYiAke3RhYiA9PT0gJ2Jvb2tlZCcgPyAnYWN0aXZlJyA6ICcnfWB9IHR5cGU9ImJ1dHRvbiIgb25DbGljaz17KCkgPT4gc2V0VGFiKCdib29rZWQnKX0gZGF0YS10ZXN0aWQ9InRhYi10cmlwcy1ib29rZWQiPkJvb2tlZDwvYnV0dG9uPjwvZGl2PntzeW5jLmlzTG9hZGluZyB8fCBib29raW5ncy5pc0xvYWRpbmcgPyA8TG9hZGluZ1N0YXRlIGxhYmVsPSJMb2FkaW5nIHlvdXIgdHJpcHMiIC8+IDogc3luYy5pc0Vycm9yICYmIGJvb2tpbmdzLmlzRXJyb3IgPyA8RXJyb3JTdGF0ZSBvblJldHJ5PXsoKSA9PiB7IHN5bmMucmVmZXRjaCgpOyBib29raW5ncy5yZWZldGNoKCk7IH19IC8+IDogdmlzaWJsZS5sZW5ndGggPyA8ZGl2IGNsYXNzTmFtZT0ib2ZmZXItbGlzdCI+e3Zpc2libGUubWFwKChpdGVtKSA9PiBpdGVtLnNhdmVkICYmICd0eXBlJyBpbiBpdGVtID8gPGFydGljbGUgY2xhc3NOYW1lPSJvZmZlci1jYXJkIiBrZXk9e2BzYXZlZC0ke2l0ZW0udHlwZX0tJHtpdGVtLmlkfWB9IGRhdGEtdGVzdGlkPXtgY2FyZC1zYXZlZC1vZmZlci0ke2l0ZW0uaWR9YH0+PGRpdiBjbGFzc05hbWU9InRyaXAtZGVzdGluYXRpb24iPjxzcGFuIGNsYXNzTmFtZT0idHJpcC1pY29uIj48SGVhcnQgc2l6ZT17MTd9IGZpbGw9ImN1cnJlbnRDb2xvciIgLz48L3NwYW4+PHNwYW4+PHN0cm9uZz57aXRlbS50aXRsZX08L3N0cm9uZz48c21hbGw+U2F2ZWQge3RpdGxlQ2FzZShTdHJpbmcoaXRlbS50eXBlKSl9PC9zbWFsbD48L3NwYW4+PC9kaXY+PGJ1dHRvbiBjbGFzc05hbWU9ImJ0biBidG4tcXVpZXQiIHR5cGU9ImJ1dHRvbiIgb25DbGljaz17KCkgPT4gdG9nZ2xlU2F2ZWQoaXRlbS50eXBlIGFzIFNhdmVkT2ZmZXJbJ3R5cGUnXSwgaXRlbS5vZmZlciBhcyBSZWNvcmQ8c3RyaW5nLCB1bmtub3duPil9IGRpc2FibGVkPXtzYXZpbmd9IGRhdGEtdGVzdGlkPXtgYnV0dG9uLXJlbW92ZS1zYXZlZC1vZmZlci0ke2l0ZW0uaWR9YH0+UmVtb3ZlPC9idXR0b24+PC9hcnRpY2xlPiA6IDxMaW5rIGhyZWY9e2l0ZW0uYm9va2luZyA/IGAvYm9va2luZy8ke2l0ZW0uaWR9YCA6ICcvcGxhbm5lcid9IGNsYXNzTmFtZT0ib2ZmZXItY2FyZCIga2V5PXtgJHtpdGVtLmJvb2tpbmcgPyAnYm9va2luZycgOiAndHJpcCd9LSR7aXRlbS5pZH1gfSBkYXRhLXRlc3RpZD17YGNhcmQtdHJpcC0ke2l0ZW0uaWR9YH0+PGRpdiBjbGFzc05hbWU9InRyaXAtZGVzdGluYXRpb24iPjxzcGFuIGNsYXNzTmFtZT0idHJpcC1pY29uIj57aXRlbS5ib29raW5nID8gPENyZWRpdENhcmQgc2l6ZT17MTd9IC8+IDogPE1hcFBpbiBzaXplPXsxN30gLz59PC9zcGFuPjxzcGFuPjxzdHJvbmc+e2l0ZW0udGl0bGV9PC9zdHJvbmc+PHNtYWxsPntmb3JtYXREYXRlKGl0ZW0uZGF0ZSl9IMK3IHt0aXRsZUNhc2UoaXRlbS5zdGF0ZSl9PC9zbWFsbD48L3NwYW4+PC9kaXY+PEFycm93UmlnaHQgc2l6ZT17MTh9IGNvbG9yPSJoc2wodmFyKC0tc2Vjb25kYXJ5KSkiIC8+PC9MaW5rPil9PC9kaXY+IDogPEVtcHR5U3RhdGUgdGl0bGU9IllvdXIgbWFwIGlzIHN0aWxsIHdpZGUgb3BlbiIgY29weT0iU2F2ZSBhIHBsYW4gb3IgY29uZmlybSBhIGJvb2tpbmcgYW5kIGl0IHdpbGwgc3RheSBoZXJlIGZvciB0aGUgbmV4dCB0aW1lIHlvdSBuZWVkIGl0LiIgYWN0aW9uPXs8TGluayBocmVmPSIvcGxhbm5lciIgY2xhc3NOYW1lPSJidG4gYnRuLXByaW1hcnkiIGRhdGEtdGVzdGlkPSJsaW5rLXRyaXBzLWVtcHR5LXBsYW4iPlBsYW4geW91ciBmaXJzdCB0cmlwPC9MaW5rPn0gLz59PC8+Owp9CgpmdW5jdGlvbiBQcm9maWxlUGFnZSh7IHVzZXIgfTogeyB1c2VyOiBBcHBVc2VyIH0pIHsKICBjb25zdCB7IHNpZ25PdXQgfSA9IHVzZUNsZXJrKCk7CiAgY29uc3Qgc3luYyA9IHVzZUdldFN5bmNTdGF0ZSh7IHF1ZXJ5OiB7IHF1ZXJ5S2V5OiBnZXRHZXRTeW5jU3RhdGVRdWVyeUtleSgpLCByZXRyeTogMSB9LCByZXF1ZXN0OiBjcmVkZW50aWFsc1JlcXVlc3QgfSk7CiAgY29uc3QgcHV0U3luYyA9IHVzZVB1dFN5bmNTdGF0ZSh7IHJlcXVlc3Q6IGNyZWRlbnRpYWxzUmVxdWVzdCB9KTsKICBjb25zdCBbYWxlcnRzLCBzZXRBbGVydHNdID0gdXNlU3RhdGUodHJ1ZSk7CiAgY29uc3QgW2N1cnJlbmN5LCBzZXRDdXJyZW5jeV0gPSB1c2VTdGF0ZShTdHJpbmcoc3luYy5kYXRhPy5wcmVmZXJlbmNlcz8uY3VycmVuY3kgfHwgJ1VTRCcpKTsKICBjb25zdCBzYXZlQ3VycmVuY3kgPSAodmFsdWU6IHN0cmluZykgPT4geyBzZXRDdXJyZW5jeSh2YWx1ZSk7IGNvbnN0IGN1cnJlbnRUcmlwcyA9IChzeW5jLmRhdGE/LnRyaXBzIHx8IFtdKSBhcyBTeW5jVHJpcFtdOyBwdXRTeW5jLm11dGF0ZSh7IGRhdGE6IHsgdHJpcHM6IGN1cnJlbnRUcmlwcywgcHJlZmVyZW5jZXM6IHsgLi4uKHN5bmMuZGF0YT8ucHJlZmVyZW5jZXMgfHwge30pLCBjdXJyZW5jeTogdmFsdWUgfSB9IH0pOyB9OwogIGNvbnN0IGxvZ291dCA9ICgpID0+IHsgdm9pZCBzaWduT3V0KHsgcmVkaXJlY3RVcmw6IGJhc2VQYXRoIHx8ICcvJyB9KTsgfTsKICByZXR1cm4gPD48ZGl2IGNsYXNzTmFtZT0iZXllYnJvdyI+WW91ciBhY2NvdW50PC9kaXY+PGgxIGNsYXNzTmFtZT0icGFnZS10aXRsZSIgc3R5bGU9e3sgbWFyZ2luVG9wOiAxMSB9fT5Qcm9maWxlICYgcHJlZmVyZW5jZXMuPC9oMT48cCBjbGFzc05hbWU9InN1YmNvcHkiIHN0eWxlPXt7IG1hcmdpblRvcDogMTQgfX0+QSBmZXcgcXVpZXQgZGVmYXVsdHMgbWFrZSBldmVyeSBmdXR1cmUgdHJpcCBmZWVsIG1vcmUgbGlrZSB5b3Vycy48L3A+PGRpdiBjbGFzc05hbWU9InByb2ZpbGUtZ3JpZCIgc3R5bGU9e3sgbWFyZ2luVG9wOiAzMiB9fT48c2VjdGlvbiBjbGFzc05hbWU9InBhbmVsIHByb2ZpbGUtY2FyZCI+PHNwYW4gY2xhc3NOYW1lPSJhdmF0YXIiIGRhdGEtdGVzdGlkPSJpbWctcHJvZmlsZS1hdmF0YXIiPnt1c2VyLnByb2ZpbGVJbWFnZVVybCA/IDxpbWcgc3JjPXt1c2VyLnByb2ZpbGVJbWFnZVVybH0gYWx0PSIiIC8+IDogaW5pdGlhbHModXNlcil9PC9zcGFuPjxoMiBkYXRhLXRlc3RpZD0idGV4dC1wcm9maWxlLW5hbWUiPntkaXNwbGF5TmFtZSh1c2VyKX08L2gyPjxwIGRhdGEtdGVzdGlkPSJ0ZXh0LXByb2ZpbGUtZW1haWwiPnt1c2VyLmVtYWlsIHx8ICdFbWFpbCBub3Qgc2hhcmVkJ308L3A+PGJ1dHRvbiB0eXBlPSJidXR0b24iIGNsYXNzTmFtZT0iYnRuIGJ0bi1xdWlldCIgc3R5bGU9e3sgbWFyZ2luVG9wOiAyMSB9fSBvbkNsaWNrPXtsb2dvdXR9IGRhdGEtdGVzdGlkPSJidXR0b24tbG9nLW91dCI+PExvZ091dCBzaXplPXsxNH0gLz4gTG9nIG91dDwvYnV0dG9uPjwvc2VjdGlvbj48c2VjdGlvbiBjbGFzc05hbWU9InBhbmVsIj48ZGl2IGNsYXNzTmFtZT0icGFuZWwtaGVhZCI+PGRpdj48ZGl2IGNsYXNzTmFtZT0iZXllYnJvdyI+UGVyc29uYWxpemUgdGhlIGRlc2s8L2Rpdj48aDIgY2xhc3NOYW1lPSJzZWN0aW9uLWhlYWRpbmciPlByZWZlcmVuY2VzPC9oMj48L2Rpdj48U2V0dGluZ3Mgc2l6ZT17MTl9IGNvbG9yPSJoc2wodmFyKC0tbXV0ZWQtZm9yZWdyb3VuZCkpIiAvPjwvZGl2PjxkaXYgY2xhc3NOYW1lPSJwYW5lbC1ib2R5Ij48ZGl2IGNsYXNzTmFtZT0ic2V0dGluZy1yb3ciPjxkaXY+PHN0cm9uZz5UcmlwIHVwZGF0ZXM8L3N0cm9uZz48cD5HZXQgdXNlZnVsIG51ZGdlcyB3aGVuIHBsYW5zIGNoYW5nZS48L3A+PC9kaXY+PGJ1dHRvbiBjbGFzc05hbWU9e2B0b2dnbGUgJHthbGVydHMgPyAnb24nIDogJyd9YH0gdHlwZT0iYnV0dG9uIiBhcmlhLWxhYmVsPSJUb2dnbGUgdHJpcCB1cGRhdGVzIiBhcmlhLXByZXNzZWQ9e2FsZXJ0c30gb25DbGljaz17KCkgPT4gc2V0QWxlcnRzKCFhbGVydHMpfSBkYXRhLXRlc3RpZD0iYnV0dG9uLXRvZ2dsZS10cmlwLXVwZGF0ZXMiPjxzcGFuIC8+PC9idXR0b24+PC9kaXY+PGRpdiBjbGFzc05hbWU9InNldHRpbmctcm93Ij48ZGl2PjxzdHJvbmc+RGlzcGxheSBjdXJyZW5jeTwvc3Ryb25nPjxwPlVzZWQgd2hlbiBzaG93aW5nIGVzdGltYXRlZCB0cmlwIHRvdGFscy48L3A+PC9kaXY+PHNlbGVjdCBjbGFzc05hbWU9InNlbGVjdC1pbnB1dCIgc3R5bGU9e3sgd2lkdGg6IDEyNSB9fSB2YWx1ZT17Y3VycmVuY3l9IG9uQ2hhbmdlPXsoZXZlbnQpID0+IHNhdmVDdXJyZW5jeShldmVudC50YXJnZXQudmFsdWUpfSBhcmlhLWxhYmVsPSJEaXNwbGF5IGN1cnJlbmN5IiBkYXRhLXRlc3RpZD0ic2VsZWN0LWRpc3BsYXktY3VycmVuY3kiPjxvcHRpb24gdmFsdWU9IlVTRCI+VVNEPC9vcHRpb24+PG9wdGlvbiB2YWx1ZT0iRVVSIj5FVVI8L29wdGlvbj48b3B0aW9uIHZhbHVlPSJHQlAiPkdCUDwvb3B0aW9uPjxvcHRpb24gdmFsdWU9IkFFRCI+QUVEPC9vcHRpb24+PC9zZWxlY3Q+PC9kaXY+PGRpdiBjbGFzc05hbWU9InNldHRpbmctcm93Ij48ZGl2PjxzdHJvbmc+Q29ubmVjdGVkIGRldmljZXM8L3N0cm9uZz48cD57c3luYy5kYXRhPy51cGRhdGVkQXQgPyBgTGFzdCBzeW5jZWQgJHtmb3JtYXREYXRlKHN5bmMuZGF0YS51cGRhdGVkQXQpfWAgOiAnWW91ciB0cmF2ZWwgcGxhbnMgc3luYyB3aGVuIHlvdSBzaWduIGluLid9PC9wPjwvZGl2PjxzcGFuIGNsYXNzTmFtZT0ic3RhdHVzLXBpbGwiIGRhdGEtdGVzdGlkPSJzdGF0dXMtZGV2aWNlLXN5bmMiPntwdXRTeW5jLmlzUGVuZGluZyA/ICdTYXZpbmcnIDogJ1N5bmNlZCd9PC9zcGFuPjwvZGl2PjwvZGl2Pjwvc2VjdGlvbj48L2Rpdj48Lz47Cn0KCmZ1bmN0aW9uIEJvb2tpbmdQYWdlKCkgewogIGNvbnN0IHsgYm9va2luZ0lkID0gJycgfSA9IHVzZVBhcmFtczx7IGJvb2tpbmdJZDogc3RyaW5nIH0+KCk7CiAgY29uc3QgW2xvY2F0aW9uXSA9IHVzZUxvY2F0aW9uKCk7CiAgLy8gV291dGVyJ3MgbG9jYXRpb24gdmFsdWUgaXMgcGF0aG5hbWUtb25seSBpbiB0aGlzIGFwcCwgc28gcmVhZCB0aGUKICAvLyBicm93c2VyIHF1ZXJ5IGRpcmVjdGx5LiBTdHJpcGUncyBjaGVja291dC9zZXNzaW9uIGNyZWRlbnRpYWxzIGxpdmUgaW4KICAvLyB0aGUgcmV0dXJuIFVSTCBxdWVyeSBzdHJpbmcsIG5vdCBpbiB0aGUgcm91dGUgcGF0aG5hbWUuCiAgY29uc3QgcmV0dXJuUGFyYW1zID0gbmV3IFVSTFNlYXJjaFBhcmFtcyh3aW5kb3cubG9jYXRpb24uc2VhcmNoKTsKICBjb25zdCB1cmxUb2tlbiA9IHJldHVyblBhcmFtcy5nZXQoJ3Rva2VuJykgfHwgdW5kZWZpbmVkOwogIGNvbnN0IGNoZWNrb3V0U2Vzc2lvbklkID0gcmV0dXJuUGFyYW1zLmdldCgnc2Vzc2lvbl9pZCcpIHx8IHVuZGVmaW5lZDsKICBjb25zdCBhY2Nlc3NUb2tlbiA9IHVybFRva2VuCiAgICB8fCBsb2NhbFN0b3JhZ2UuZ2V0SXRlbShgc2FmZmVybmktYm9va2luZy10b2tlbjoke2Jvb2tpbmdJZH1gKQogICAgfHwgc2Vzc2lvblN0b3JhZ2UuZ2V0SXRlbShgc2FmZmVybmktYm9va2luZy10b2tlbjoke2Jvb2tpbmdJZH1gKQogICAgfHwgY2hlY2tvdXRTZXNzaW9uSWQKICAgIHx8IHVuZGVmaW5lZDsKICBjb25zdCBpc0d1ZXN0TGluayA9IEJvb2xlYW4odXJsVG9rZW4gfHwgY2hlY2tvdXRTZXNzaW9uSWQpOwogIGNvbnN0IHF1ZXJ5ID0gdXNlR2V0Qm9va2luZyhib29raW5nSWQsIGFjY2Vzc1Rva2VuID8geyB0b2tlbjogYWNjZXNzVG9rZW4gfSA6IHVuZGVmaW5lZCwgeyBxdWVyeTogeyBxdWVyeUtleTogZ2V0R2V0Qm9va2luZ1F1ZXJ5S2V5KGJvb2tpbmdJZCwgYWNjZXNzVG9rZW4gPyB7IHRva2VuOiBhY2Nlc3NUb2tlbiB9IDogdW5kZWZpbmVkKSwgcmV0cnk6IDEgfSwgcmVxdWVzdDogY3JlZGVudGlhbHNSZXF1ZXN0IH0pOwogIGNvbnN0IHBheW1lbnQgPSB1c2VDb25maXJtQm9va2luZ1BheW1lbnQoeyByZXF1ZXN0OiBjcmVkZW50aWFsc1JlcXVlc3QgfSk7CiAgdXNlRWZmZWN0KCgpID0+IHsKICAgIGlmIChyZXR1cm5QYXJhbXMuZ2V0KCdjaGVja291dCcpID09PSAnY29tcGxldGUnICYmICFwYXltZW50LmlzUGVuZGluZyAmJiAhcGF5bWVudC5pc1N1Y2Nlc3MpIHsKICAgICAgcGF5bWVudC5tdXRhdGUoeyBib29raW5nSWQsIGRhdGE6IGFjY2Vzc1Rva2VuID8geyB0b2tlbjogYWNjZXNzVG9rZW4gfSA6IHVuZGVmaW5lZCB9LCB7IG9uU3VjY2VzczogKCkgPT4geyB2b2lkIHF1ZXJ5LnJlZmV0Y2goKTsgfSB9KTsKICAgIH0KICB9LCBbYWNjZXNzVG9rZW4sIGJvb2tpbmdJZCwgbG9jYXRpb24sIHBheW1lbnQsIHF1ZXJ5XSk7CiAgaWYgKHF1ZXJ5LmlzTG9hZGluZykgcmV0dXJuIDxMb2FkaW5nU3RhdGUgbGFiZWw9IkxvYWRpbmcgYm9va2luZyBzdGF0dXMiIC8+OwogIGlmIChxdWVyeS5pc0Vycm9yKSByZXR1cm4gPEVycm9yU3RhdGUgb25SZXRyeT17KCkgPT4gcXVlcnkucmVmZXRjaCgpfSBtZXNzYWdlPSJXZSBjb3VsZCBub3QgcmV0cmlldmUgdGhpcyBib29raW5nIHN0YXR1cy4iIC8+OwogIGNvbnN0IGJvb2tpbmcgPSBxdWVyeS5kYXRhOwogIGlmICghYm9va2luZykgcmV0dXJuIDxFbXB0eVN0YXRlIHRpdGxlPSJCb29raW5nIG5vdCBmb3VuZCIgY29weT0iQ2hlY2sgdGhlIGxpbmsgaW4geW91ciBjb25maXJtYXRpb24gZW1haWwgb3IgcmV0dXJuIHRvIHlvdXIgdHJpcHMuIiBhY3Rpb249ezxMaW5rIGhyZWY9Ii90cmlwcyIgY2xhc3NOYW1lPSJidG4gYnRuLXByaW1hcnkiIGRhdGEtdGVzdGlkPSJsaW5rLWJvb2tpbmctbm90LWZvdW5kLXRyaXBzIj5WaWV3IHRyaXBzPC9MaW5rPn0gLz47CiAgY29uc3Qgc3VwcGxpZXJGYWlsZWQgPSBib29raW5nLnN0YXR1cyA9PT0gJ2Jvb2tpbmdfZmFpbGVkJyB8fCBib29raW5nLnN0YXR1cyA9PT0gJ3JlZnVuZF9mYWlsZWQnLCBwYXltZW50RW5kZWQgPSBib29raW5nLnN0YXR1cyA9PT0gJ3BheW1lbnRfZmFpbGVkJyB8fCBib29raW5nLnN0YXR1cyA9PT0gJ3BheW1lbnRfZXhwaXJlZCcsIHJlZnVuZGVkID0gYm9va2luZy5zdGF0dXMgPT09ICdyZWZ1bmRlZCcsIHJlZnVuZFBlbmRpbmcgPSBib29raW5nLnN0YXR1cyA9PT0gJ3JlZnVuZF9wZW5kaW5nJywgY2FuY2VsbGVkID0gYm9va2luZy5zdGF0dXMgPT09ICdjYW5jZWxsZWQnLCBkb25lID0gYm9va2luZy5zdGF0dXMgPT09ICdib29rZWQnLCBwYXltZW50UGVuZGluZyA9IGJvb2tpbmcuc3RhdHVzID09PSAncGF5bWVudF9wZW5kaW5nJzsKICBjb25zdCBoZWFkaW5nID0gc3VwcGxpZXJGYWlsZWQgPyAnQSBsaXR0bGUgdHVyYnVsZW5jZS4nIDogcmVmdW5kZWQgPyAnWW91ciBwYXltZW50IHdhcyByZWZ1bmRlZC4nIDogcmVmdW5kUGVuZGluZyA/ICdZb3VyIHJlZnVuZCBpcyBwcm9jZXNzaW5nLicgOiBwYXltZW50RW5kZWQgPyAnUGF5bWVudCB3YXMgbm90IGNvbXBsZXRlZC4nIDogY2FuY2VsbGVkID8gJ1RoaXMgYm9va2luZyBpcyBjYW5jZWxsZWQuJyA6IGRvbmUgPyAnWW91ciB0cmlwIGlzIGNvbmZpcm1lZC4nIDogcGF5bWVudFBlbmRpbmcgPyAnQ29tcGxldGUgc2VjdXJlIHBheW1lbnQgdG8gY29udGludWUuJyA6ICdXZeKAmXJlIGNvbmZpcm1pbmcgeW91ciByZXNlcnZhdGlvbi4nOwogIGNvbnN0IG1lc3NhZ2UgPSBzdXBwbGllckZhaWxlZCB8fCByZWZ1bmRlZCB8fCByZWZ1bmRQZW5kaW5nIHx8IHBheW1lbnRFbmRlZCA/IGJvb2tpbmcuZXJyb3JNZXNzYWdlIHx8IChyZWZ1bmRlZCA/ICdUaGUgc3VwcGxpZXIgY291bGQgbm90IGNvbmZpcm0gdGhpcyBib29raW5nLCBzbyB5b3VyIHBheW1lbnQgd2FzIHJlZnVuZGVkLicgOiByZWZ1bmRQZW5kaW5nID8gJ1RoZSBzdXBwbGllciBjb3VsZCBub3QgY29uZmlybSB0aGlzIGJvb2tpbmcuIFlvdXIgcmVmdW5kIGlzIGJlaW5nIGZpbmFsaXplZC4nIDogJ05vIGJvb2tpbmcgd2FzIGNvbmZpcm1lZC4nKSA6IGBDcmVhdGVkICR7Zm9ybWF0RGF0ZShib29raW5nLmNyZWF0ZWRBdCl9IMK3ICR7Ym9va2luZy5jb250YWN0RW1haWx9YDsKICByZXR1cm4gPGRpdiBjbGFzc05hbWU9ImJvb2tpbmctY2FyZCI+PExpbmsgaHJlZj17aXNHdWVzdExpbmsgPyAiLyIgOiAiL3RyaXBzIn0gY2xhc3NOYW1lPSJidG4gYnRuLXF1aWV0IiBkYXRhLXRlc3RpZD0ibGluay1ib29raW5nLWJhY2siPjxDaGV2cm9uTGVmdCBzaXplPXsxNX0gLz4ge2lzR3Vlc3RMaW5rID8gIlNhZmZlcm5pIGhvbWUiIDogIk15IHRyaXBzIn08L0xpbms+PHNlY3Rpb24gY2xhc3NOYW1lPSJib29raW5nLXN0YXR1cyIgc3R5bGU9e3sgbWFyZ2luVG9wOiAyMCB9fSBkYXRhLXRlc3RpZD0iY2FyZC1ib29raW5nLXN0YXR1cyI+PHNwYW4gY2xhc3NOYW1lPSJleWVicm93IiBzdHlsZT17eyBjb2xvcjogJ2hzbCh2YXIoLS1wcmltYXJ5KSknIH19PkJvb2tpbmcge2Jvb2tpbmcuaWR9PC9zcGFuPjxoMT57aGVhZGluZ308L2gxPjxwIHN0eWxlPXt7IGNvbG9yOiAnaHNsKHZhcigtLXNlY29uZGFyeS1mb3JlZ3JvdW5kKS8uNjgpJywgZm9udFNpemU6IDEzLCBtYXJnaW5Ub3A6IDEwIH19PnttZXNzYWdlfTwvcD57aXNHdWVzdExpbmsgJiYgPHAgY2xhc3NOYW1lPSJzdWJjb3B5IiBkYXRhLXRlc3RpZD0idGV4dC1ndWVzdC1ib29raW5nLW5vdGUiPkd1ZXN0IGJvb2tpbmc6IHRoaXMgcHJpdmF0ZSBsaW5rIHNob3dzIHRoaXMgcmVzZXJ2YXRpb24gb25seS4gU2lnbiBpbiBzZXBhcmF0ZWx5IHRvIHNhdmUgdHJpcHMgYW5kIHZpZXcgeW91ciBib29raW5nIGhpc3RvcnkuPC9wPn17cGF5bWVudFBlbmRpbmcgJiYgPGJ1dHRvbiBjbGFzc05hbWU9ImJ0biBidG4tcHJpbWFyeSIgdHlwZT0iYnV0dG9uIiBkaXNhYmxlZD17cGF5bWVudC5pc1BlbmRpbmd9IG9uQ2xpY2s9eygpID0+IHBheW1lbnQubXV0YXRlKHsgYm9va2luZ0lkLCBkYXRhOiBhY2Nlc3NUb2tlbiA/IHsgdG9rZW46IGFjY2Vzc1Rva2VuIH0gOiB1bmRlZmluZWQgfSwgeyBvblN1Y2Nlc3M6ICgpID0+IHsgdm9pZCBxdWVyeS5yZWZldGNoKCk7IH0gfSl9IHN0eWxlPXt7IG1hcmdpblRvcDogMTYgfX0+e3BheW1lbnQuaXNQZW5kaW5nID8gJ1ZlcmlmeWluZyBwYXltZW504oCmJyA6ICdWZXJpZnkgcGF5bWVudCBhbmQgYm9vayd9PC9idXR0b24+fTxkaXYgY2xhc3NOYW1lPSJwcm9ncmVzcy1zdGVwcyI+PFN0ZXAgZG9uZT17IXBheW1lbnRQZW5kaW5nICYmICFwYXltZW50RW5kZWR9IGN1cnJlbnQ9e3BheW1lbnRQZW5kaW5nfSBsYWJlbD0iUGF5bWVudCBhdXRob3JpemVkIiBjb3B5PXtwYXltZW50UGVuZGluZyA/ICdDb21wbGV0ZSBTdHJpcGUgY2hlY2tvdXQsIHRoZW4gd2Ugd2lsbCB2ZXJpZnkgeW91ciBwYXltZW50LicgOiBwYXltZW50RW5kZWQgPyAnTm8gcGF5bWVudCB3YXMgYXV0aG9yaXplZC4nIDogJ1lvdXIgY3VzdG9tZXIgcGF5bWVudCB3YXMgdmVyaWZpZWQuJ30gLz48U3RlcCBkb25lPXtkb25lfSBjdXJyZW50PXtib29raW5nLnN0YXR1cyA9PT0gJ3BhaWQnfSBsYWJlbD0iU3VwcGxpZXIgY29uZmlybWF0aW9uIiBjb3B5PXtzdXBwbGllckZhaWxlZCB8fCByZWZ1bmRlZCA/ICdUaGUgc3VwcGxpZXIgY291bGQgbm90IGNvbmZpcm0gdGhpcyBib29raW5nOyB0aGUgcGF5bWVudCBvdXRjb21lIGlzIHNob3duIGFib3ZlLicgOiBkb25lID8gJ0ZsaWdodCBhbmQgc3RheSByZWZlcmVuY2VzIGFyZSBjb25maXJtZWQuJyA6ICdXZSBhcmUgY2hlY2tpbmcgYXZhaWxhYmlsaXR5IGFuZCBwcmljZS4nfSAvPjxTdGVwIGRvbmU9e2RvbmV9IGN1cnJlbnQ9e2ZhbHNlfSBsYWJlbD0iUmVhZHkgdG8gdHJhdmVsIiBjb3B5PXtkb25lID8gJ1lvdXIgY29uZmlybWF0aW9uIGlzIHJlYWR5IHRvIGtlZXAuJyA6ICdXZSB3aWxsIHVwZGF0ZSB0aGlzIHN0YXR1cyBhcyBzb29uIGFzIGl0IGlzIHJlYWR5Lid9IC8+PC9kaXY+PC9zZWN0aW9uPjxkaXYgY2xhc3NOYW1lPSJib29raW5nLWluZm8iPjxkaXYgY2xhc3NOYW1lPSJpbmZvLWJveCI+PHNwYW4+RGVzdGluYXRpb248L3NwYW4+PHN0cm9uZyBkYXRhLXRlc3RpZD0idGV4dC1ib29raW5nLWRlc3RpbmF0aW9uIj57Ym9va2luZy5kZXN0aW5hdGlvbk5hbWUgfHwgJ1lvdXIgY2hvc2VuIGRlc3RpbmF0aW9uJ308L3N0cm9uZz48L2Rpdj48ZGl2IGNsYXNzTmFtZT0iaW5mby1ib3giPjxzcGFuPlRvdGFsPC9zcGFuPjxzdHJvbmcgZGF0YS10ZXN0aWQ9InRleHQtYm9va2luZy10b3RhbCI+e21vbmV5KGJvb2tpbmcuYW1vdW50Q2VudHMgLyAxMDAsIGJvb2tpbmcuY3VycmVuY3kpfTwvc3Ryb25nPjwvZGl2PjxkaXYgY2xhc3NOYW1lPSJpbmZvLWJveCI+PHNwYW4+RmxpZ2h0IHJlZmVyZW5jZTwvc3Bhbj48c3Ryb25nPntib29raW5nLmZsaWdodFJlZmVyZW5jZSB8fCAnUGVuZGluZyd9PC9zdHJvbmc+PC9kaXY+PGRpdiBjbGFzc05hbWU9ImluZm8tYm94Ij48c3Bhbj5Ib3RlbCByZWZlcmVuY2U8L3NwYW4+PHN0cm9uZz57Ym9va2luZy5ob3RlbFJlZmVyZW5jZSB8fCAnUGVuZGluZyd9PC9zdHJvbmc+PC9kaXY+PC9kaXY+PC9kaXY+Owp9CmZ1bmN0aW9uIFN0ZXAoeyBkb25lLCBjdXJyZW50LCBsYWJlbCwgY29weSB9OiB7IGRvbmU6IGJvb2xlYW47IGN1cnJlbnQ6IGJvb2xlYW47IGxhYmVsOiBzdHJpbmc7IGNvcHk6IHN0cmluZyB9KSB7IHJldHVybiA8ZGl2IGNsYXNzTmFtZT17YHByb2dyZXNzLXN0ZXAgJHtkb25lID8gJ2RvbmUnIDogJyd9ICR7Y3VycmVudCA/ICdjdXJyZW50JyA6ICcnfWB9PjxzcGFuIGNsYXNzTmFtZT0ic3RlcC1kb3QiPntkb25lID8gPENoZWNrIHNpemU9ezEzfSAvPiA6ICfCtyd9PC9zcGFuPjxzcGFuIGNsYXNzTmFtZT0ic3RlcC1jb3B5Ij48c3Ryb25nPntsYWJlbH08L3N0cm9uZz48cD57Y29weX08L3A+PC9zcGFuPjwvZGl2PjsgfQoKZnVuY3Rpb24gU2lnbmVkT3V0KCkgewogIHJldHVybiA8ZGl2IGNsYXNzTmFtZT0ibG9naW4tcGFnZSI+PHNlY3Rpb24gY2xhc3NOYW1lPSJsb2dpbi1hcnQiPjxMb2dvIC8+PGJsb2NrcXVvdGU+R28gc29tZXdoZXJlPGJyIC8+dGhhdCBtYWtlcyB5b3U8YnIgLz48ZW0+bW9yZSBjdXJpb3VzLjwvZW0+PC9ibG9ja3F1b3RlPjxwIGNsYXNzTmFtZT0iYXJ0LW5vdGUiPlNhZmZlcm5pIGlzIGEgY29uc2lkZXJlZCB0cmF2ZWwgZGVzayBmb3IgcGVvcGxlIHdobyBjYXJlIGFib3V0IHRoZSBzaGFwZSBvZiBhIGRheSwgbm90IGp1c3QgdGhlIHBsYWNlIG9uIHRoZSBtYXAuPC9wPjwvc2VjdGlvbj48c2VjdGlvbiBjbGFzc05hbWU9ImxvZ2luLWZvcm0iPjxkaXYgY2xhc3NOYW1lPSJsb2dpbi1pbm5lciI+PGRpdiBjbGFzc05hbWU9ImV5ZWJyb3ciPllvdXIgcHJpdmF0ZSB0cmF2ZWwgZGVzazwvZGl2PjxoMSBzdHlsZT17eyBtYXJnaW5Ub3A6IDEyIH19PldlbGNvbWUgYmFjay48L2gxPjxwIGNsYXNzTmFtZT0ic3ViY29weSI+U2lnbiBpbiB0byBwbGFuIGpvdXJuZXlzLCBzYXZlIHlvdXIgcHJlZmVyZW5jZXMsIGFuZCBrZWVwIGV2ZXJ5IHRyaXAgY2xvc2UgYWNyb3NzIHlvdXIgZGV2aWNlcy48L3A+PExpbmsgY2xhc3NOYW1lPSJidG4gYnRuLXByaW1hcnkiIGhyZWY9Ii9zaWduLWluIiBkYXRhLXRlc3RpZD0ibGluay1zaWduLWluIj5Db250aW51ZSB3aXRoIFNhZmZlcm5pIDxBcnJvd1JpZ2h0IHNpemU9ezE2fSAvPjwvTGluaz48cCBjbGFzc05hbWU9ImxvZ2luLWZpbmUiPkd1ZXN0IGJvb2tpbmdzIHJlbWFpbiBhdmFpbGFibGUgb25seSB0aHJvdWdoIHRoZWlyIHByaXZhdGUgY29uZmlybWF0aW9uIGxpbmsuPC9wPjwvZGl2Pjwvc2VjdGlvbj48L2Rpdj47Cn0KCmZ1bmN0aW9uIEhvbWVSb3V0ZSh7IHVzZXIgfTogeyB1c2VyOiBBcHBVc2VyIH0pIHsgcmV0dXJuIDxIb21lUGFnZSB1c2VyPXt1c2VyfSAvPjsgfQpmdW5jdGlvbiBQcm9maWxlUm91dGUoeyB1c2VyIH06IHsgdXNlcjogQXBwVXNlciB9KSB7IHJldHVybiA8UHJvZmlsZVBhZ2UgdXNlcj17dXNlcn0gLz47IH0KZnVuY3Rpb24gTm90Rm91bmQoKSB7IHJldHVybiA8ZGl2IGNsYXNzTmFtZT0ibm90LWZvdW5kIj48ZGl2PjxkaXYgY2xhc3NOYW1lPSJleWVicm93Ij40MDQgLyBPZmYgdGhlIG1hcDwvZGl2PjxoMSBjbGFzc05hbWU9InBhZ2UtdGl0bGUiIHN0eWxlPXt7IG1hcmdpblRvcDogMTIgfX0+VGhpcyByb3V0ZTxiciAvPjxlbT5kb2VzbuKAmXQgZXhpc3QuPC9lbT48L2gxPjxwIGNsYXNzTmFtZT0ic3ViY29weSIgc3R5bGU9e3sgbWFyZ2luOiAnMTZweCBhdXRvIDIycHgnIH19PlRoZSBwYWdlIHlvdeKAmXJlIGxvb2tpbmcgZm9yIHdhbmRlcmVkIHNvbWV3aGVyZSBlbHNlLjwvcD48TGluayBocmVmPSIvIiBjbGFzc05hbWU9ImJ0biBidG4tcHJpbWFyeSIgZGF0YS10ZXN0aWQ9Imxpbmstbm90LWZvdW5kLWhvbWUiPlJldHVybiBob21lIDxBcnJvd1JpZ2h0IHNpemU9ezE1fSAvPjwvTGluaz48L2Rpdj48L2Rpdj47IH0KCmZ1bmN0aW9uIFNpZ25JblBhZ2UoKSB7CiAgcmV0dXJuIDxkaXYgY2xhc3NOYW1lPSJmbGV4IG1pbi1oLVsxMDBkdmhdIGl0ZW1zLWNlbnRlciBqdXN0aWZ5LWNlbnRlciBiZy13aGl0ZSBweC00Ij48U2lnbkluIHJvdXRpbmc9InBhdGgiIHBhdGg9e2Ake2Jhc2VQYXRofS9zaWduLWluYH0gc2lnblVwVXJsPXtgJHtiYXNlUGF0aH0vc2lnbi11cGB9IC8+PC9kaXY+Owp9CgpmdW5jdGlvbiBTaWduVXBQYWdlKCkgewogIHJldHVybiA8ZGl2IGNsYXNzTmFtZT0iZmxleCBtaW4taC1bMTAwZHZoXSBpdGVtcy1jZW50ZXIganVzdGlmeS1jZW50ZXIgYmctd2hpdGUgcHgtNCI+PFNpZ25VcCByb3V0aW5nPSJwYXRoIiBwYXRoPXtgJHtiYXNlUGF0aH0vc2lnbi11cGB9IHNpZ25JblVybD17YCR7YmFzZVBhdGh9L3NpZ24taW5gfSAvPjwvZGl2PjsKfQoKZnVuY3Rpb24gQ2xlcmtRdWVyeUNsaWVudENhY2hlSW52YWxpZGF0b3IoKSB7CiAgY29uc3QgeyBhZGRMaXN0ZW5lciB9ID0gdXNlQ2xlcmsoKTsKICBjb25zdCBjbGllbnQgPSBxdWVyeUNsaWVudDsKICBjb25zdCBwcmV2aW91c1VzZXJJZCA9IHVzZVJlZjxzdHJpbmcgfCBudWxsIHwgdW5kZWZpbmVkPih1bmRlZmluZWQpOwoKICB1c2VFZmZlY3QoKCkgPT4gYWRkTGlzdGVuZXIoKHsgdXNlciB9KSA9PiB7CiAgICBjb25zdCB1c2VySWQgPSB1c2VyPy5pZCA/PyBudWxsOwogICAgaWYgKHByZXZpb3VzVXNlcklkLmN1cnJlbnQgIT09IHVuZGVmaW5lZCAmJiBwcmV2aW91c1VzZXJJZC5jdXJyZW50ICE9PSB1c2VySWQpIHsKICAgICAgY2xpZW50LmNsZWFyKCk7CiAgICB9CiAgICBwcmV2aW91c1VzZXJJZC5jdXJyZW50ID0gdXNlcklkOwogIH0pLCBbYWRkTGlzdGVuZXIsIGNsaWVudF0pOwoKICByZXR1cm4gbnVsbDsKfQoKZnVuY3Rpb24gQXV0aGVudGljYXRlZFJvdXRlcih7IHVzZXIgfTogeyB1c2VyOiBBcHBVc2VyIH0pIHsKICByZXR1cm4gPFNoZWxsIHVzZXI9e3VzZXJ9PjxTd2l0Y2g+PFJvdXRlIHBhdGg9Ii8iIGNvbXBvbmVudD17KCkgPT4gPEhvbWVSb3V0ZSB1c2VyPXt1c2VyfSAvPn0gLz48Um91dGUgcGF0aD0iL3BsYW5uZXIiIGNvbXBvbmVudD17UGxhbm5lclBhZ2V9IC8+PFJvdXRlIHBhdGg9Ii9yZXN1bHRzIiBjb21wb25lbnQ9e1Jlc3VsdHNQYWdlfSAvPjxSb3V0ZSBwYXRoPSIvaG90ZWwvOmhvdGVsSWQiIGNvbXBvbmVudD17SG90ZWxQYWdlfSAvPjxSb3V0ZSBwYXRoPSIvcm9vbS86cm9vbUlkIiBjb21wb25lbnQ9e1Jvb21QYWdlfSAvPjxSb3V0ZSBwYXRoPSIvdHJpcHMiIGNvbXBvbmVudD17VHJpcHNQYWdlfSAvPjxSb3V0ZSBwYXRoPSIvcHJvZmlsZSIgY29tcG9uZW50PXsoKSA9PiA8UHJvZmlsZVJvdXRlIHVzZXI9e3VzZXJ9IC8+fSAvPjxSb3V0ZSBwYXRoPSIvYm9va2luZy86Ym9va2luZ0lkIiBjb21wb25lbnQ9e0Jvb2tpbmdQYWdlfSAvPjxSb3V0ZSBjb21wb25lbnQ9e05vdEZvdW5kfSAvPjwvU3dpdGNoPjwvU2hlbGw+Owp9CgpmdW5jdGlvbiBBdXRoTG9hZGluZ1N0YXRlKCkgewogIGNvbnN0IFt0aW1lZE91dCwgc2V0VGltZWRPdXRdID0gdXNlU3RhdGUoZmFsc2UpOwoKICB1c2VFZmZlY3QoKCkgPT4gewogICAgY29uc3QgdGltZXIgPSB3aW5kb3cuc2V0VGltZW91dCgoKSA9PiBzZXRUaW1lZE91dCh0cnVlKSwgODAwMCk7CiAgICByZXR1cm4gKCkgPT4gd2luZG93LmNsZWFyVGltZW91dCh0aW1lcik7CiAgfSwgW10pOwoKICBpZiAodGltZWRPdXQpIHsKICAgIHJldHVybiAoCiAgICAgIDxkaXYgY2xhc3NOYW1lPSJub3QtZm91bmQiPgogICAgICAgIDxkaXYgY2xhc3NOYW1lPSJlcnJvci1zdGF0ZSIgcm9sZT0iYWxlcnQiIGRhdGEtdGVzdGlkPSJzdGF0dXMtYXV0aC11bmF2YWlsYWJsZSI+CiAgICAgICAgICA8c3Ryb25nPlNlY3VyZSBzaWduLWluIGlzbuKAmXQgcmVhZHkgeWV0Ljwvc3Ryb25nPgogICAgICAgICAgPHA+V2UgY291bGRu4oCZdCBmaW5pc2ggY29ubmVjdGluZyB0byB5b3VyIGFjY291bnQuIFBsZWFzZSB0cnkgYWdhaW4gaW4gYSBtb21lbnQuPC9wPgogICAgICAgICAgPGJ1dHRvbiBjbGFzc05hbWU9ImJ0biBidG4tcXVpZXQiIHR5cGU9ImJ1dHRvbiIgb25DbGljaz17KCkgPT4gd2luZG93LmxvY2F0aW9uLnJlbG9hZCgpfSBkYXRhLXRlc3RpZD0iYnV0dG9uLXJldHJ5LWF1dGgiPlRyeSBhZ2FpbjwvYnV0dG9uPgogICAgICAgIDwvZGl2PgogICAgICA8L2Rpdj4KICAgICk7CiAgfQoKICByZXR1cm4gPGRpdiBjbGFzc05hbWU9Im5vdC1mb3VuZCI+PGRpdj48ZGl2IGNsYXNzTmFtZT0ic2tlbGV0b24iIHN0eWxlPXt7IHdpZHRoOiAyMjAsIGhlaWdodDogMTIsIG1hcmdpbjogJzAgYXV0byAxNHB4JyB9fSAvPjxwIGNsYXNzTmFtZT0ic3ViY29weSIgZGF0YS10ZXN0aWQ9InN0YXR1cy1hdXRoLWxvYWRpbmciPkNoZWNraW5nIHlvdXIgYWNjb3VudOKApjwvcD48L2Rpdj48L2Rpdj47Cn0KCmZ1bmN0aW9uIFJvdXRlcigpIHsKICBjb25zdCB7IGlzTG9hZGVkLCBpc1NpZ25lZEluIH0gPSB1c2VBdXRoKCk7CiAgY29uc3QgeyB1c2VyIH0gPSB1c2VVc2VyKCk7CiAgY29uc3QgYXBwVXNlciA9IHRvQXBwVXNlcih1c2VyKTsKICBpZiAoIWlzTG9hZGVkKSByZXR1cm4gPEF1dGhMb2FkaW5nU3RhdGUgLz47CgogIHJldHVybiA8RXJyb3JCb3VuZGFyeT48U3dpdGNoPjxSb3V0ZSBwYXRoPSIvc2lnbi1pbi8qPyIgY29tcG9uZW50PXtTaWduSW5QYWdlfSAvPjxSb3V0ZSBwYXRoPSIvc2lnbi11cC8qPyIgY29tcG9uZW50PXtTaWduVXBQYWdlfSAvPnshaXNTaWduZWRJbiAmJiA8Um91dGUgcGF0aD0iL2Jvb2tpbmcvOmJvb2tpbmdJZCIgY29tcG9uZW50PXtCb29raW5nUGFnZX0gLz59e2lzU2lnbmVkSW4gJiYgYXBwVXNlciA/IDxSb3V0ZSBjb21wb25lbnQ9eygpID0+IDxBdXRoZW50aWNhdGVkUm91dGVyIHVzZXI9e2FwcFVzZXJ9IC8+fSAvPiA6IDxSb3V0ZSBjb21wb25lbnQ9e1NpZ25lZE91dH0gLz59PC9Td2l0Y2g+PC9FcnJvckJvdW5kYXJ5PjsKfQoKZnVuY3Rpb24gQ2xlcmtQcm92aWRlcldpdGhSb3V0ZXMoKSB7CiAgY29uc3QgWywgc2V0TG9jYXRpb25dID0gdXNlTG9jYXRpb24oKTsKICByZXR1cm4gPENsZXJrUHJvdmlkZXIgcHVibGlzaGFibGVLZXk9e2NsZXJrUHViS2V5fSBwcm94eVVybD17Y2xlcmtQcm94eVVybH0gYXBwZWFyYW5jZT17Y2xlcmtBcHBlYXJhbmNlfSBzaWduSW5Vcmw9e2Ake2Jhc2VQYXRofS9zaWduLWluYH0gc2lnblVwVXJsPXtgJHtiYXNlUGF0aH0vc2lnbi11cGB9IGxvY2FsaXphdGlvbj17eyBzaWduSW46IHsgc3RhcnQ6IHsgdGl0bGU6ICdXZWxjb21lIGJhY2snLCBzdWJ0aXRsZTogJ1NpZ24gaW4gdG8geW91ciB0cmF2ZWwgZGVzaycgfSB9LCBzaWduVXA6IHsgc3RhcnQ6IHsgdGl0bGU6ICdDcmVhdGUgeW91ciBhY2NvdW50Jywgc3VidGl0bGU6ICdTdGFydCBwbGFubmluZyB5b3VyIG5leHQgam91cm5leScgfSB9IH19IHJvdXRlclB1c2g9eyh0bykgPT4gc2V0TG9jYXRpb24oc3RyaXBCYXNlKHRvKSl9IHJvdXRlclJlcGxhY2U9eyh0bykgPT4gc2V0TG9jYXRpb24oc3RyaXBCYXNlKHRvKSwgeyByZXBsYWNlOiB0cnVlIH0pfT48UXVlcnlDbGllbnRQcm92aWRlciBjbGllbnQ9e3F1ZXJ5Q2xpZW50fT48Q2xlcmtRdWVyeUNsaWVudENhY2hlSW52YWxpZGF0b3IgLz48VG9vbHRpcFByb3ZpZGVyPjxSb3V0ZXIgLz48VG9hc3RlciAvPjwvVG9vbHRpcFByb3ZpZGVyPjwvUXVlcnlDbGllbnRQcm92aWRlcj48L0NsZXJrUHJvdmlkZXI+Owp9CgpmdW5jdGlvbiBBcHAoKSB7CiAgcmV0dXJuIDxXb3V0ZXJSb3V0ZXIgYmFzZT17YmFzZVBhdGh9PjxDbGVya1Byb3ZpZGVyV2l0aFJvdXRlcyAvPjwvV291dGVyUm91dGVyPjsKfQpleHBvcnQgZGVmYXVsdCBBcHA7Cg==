type GeoPlace = { city: string; country: string; mood: string; lat: number; lon: number; displayName?: string };
const AIRPORT_CITY_NAMES: Record<string, string> = {
  YUL: 'Montreal', YYZ: 'Toronto', YVR: 'Vancouver', YYC: 'Calgary', YOW: 'Ottawa',
  JFK: 'New York', LAX: 'Los Angeles', ORD: 'Chicago', LHR: 'London', CDG: 'Paris',
  DXB: 'Dubai', HND: 'Tokyo', HKG: 'Hong Kong',
};
const planeIcon = divIcon({
  className: 'plane-marker',
