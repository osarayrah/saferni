  iconSize: [38, 38],
  iconAnchor: [19, 19],
});

function buildCurvedRoute(from: GeoPlace, to: GeoPlace): [number, number][] {
  const steps = 34;
  const deltaLon = to.lon - from.lon;
  const deltaLat = to.lat - from.lat;
  const distance = Math.max(Math.hypot(deltaLon, deltaLat), 1);
  const bow = Math.min(18, Math.max(3, distance * 0.12));
  const perpendicularLat = deltaLon / distance;
  const perpendicularLon = -deltaLat / distance;
  return Array.from({ length: steps + 1 }, (_, index) => {
    const t = index / steps;
    const curve = Math.sin(Math.PI * t) * bow;
    return [
      from.lat + deltaLat * t + perpendicularLat * curve,
      from.lon + deltaLon * t + perpendicularLon * curve,
    ] as [number, number];
  });
}

function RouteViewport({ origin, destination, route }: { origin?: GeoPlace | null; destination?: GeoPlace | null; route: [number, number][] }) {
  const map = useMap();
  useEffect(() => {
    if (origin && destination && route.length > 1) {
      map.fitBounds(route, { padding: [62, 62], maxZoom: 5, animate: true, duration: 0.9 });
    } else if (destination) {
      map.flyTo([destination.lat, destination.lon], 4, { duration: 0.8 });
    }
  }, [map, origin?.city, destination?.city, route.length]);
  return null;
}

async function geocodeCity(query: string, signal: AbortSignal): Promise<GeoPlace | null> {
  if (!query.trim()) return null;
  const normalizedQuery = query.trim();
  const searchQuery = AIRPORT_CITY_NAMES[normalizedQuery.toUpperCase()] || normalizedQuery;
  const response = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&addressdetails=1&accept-language=en&q=${encodeURIComponent(searchQuery)}`, { signal });
  if (!response.ok) return null;
  const results = await response.json() as Array<{ lat: string; lon: string; display_name: string; address?: { city?: string; town?: string; village?: string; municipality?: string; country?: string } }>;
  const result = results[0];
  if (!result) return null;
  const city = AIRPORT_CITY_NAMES[normalizedQuery.toUpperCase()] || result.address?.city || result.address?.town || result.address?.village || result.address?.municipality || result.display_name.split(',')[0];
  return { city, country: result.address?.country || '', mood: 'A place worth getting curious about', lat: Number(result.lat), lon: Number(result.lon), displayName: result.display_name };
}

function InteractiveChatMap({ origin, destination }: { origin?: string; destination?: string }) {
  const [destinationGeo, setDestinationGeo] = useState<GeoPlace | null>(null);
  const [originGeo, setOriginGeo] = useState<GeoPlace | null>(null);
  const [geocoding, setGeocoding] = useState(false);
  const [routeFocused, setRouteFocused] = useState(false);
  const [routeProgress, setRouteProgress] = useState(0);
  useEffect(() => {
    setDestinationGeo(null);
    if (!destination?.trim()) return;
    const controller = new AbortController();
    setGeocoding(true);
    geocodeCity(destination, controller.signal)
      .then((place) => { if (!controller.signal.aborted) setDestinationGeo(place); })
      .catch(() => {})
      .finally(() => { if (!controller.signal.aborted) setGeocoding(false); });
    return () => controller.abort();
  }, [destination]);
  useEffect(() => {
    setOriginGeo(null);
    if (!origin?.trim()) return;
    const controller = new AbortController();
    geocodeCity(origin, controller.signal).then((place) => { if (!controller.signal.aborted) setOriginGeo(place); }).catch(() => {});
    return () => controller.abort();
  }, [origin]);
  const active = destinationGeo || { city: destination || 'Your destination', country: '', mood: 'Tell Safferni where you want to go', lat: 20, lon: 0 };
  const originPlace = originGeo;
  const showRoute = Boolean(destinationGeo && originPlace && originPlace.city !== destinationGeo.city);
  const route = useMemo(() => showRoute && originPlace && destinationGeo ? buildCurvedRoute(originPlace, destinationGeo) : [], [showRoute, originPlace, destinationGeo]);
  const routeIndex = Math.min(route.length - 1, Math.round(routeProgress * Math.max(route.length - 1, 0)));
  useEffect(() => {
    setRouteProgress(0);
    if (!showRoute || route.length < 2) return;
    const duration = 3000;
    let frame = 0;
    let startedAt = performance.now();
    const animate = (now: number) => {
      const progress = Math.min(1, (now - startedAt) / duration);
      setRouteProgress(progress);
      if (progress < 1) frame = window.requestAnimationFrame(animate);
    };
    frame = window.requestAnimationFrame(animate);
    return () => window.cancelAnimationFrame(frame);
  }, [showRoute, route.length, originPlace?.city, destinationGeo?.city]);
  return (
    <section className="panel map-panel" aria-label="Explore destinations">
      <div className="panel-head map-head">
        <div><div className="eyebrow">Your trip, taking shape</div><h2 className="section-heading">Where will it take you?</h2></div>
        <MapPinned size={19} color="hsl(var(--primary))" />
      </div>
      <div className="map-canvas">
        <MapContainer className="real-map" center={[active.lat, active.lon]} zoom={4} scrollWheelZoom zoomControl>
          <TileLayer attribution='&copy; OpenStreetMap contributors &copy; CARTO' url="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png" />
          <RouteViewport origin={originPlace} destination={destinationGeo} route={route} />
          {showRoute && <Polyline positions={route} pathOptions={{ className: 'flight-route-halo', color: '#2368C4', weight: 12, opacity: .16, interactive: false }} />}
          {showRoute && <Polyline positions={route} pathOptions={{ className: `flight-route ${routeFocused ? 'focused' : ''}`, color: '#2368C4', weight: routeFocused ? 6 : 4, dashArray: '10 9' }} eventHandlers={{ mouseover: () => setRouteFocused(true), mouseout: () => setRouteFocused(false), click: () => setRouteFocused((focused) => !focused) }}><Tooltip sticky>{originPlace?.city} to {active.city} · tap the route for details</Tooltip></Polyline>}
          {originPlace && <CircleMarker center={[originPlace.lat, originPlace.lon]} radius={8} pathOptions={{ className: 'origin-marker', color: '#8C9B83', fillColor: '#fff', fillOpacity: 1, weight: 3 }}><Tooltip direction="top">From: {originPlace.city}, {originPlace.country}</Tooltip></CircleMarker>}
          {destinationGeo && <CircleMarker center={[destinationGeo.lat, destinationGeo.lon]} radius={8} pathOptions={{ className: 'destination-marker', color: '#2368C4', fillColor: '#fff', fillOpacity: 1, weight: 3 }}><Tooltip direction="top">To: {destinationGeo.city}, {destinationGeo.country}</Tooltip></CircleMarker>}
          {showRoute && route[routeIndex] && <Marker position={route[routeIndex]} icon={planeIcon} />}
        </MapContainer>
        <div className="map-overlay-label"><MapPinned size={14} /> {geocoding ? 'Finding this place…' : `${active.city}${active.country ? `, ${active.country}` : ''}`}</div>
        {showRoute && originPlace && <div className="map-route-label">{originPlace.city} <ArrowRight size={12} /> {active.city}</div>}
        {routeFocused && showRoute && originPlace && <div className="map-route-detail"><span className="route-plane">✈</span><span><strong>Flight route</strong><small>{originPlace.city} to {active.city}</small></span></div>}
      </div>
      <div className="map-selection">
        <div><div className="eyebrow">From the trip draft</div><strong>{active.city}{active.country ? `, ${active.country}` : ''}</strong><p>{showRoute && originPlace ? `${originPlace.city} → ${active.city}` : active.mood}</p></div>
      </div>
    </section>
  );
}

